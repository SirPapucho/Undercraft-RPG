	file.0000000000000001.title: "&l&dUnderCraft&r"
	image.2DB4CE9022DCF182.title: "Nuevas armas"
	image.4AABED7FFADD03DF.title: "Nuevas armas"
	image.4E299B659075F5D4.title: "Planea tu altar"
	image.5D713C8FAE138736.title: "Nuevas armas"
	quest.004ED77525144309.quest_desc: [
		"Las &aarmas ligeras&r de &7netherite&r son &blas mejores de su tipo&r, rápidas, a una mano y con mucho más daño"
		""
		"&aCombinadas en ambas manos&r no dejan respirar a ningún enemigo"
	]
	quest.004ED77525144309.quest_subtitle: "Lo mejor de lo rápido"
	quest.004ED77525144309.title: "Armas ligeras de netherite"
	quest.0057CD4D8940B556.quest_desc: [
		"Entrega &a5 &bbloques de diamante&r&r de una vez y recibe &6125 monedas&r en tu cartera"
		""
		"Es la versión por lote de la venta de uno en uno, para vaciar el almacén más rápido"
	]
	quest.0057CD4D8940B556.quest_subtitle: "125 monedas"
	quest.0057CD4D8940B556.title: "Vender diamante x5"
	quest.0082C3152FFD3451.quest_desc: [
		"Para &binput&r: saca objetos, fluidos o energía de un bloque adyacente, y cada una de sus caras tiene su propio filtro"
		""
		"Las caras vienen apagadas hasta que las actives"
	]
	quest.0082C3152FFD3451.quest_subtitle: "Nodo de entrada"
	quest.00A8E33C64506F7C.quest_desc: ["El &bSigil of Withdrawal&r sirve para &aretirar una gema&r de su ranura sin perder el objeto"]
	quest.00A8E33C64506F7C.title: "Sigilo de retirada"
	quest.00E293F54B17F913.quest_desc: [
		"En la &bScribe's Table&r creas &dglifos&r, las piezas de tus hechizos. Cada uno cuesta objetos y experiencia: lanza los objetos sobre la mesa y la mesa lo escribe"
		""
		"Al usar un glifo, lo aprendes para siempre. La mesa también inscribe hechizos en pergaminos"
	]
	quest.00E293F54B17F913.quest_subtitle: "Donde nacen los glifos"
	quest.00E293F54B17F913.title: "Mesa de escriba"
	quest.013392E1A0096E4E.quest_desc: [
		"La &bSource Jar&r almacena el &dSource&r que le envían los &asourcelinks&r cercanos. De ella beben la cámara de imbuición, el Enchanting Apparatus y los rituales"
		""
		"Sin Source, no hay magia: mantén siempre una jarra llena"
		"{@pagebreak}"
	]
	quest.013392E1A0096E4E.quest_subtitle: "El depósito de la magia"
	quest.013392E1A0096E4E.title: "Jarra de Source"
	quest.0155AE75D75B4AC1.quest_desc: [
		"Un ritual de un solo uso que monta una &bmazmorra&r de nivel inicial junto a la piedra maestra, la puerta al &cReino Demoníaco&r"
		""
		"Gasta mucho &cEV&r, así que prepara tu Anima. Dentro encontrarás el &bTau&r para mejorar el altar"
		"{@pagebreak}"
		""
		"{image:undercraft:textures/questpics/neo_vitae/breaching_edge_demon_realm_runes.png width:100 height:100 align:center}"
		"{@pagebreak}"
		""
		"{image:undercraft:textures/questpics/neo_vitae/breaching_edge_demon_realm_structure.png width:100 height:100 align:center}"
	]
	quest.0155AE75D75B4AC1.quest_subtitle: "Ritual de entrada"
	quest.0155AE75D75B4AC1.title: "Breaching the Edge Of Demon Realm"
	quest.016DF2CD555AAD9A.quest_desc: [
		"La tabula de este tier del altar"
		""
		"Con ella, lapislázuli y nether wart aplicas &bBlood Mending&r en la &bHellfire Forge&r: necesita &6200 espíritus&r y gasta &6400&r"
		""
		"También se usa para fabricar el &bRitual Ledger&r"
	]
	quest.016DF2CD555AAD9A.quest_subtitle: "Tabula"
	quest.018C8B503871E9B7.quest_desc: [
		"Paga &675 monedas&r y recibe &buna mejora al azar&r para tus cajones de &aFunctional Storage&r, las de nivel alto salen menos"
		""
		"Se puede comprar de nuevo &7cada 30 minutos&r"
	]
	quest.018C8B503871E9B7.quest_subtitle: "Una mejora al azar"
	quest.018C8B503871E9B7.title: "Mejoras de Functional Storage"
	quest.01A001BFD1856210.quest_desc: [
		"El &aenriquecido&r es un paso intermedio muy común en &bMekanism&r: redstone, carbono, diamante, oro y más tienen su versión enriquecida"
		""
		"Se fabrican en la &bEnrichment Chamber&r o en la &bMetallurgic Infuser&r, según el material, y se usan en aleaciones, circuitos y máquinas avanzadas"
	]
	quest.01A001BFD1856210.quest_subtitle: "Materiales enriquecidos"
	quest.01A001BFD1856210.title: "Enriquecidos"
	quest.01C469B45DC7E77E.quest_desc: [
		"La &bgeode shelf&r aporta &aestabilidad cuántica&r: evita que el quanta te dé resultados peores que el nivel base"
		""
		"Imprescindible si quieres subir el quanta sin miedo"
	]
	quest.01C469B45DC7E77E.quest_subtitle: "Estabilidad cuántica"
	quest.01C469B45DC7E77E.title: "Estantería de geoda"
	quest.01CF544A825273E3.quest_desc: [
		"Entrega &a5 &6bloques de cobre&r&r de una vez y recibe &610 monedas&r en tu cartera"
		""
		"Es la versión por lote de la venta de uno en uno, para vaciar el almacén más rápido"
	]
	quest.01CF544A825273E3.quest_subtitle: "10 monedas"
	quest.01CF544A825273E3.title: "Vender cobre x5"
	quest.01DDA1FCE6A52444.quest_desc: [
		"Las mejoras convierten la mochila en una herramienta: recogida automática, imán, filtros, alimentación automática, vaciado de basura, relleno, hornos, crafteo, tocadiscos y más"
		""
		"Cada una ocupa una ranura. Elige las que más te ayuden"
	]
	quest.01DDA1FCE6A52444.quest_subtitle: "Haz que trabaje por ti"
	quest.01DDA1FCE6A52444.title: "Mejoras de mochila"
	quest.0217EAD4071C99D2.quest_desc: ["La &breforging table&r es la versión mejorada: trabaja con las rarezas más altas y ofrece más control sobre el resultado"]
	quest.0217EAD4071C99D2.quest_subtitle: "Versión mejorada"
	quest.0217EAD4071C99D2.title: "Mesa de reforja"
	quest.02956D4142749704.quest_desc: [
		"El &aTinted Glass&r &bno deja pasar la luz&r, así puedes ver dentro de la granja sin que los mobs dejen de aparecer"
		""
		"Además &aaguanta los ataques de un Wither&r"
	]
	quest.02956D4142749704.quest_subtitle: "Mira sin dejar pasar luz"
	quest.02956D4142749704.title: "Tinted Glass"
	quest.02C3965086911BC9.quest_desc: [
		"Con todo lo anterior ya puedes armar tu granja, aquí tienes la &bguía para construirla&r con los materiales que ya conoces"
		""
		"Cada misión explica un paso y te recomiendo seguirlas en orden: &aárea&r, &aventiladores&r, &aredstone&r, &aalmacenamiento&r y &asonido&r"
	]
	quest.02C3965086911BC9.quest_subtitle: "Construyéndola paso a paso"
	quest.02C3965086911BC9.title: "Guía de la granja"
	quest.02E2C6608B293F7C.quest_desc: [
		"Paga &6200 monedas&r y recibe &bun accesorio al azar&r de los mejores de &aArtifacts&r y &aRelics&r"
		""
		"Se puede comprar de nuevo &7cada 6 horas&r"
	]
	quest.02E2C6608B293F7C.quest_subtitle: "Un accesorio al azar"
	quest.02E2C6608B293F7C.title: "High Tier Curio"
	quest.039462CFD081746A.quest_desc: ["La &bdraconic endshelf&r se fabrica con la cabeza de un dragón. Por sí sola sube la mesa hasta el nivel 100, sin estadísticas secundarias"]
	quest.039462CFD081746A.quest_subtitle: "El techo de la eterna"
	quest.039462CFD081746A.title: "Estantería dracónica"
	quest.03BEFC665A07E9F7.quest_desc: [
		"La &btreasure shelf&r permite que aparezcan en la mesa los encantamientos de &atesoro&r, como el &dMending&r"
		""
		"Sin ella, esos encantamientos no salen de la mesa"
	]
	quest.03BEFC665A07E9F7.quest_subtitle: "Encantamientos de tesoro"
	quest.03BEFC665A07E9F7.title: "Estantería de tesoro"
	quest.03C7082D5A76AD4B.quest_desc: [
		"&aBuilding Gadgets 2&r trae herramientas para &bconstruir sin esfuerzo&r, una para &aconstruir&r muros y pisos, otra para &aintercambiar&r bloques, otras para &acopiar, cortar y pegar&r estructuras y una para &cdestruir&r zonas enteras"
		""
		"&cFuncionan con RF&r, así que tendrás que cargarlas, y revisa sus atajos de teclado en &bOpciones > Controles&r"
	]
	quest.03C7082D5A76AD4B.quest_subtitle: "Construir a lo grande"
	quest.03C7082D5A76AD4B.title: "Building Gadgets"
	quest.03DFAEBF27239E61.quest_desc: [
		"Cada plantilla se fabrica con 5 lingotes de su nivel y una base de mejora (4 lingotes de ferricore). Duplica la plantilla con 2 de su material"
		""
		"Las plantillas de los niveles superiores son las que suben el equipo de nivel"
	]
	quest.03DFAEBF27239E61.quest_subtitle: "Para empezar"
	quest.03DFAEBF27239E61.title: "Plantilla de ferricore"
	quest.03F0AF00BDF55C23.quest_desc: [
		"&aIron Furnaces&r reemplaza el horno clásico por &bversiones mucho más rápidas&r, cada una de un material distinto, &6cobre&r, &fhierro&r, &7plata&r, &eoro&r, &bdiamante&r, &aesmeralda&r, &dcristal&r, &5obsidiana&r y &7netherite&r"
		""
		"&aCada nivel funde más rápido que el anterior&r, y no tienes que romper tu horno para mejorarlo, &blos kits de mejora lo suben de nivel ahí mismo&r"
		""
		"Además cada horno tiene &dranuras de aumentos&r que cambian su función, &6revisa las otras misiones de este capítulo&r"
	]
	quest.03F0AF00BDF55C23.quest_subtitle: "El horno de siempre se queda corto"
	quest.03F0AF00BDF55C23.title: "Hornos mejorados"
	quest.04456E930AAA443F.quest_desc: ["El &bdragonskin spell book&r potencia los hechizos de &aender&r. Se fabrica con piel del Ender Dragon"]
	quest.04456E930AAA443F.quest_subtitle: "Magia de ender"
	quest.04456E930AAA443F.title: "Libro de piel de dragón"
	quest.0490D64413FE81C8.quest_desc: [
		"Las &brunas inscritas&r son objetos mágicos propios de cada escuela. Se usan en recetas avanzadas, como el equipo de las distintas escuelas"
		""
		"Pulsa &2R&r sobre una para ver qué necesitas"
	]
	quest.0490D64413FE81C8.quest_subtitle: "Un nivel más"
	quest.0490D64413FE81C8.title: "Runas inscritas"
	quest.04971418E7FE9CD9.quest_desc: [
		"El &aMob Masher&r &bmata a los mobs&r que entran en su espacio, y &acuentan como muertes de jugador&r, así que sueltan todo su botín"
		""
		"&cNecesita una señal de redstone para funcionar&r"
	]
	quest.04971418E7FE9CD9.quest_subtitle: "El final del camino"
	quest.04971418E7FE9CD9.title: "Mob Masher"
	quest.04D9B443CBC8A3A8.quest_desc: [
		"Tres teclas que te salvarán más de una vez:"
		""
		"&2R&r sobre un objeto muestra cómo se fabrica; &2U&r, para qué sirve. Funciona en el visor de recetas, &bJEI&r"
		""
		"&2M&r abre el mapa de &bJourneyMap&r, donde exploras y reclamas terreno"
		""
		"&2V&r abre el menú del chat de voz (&bSimple Voice Chat&r) para ajustar tu micrófono y hablar con quienes estén cerca"
	]
	quest.04D9B443CBC8A3A8.quest_subtitle: "Tres atajos"
	quest.04DDC43B0FC60E9F.quest_desc: [
		"Las máquinas de nivel 1 actúan sobre el bloque o entidad que tienen delante: rompen, colocan, hacen clic, detectan, sueltan objetos, intercambian bloques y manejan fluidos"
		""
		"La &allave de ferricore&r las rota y enlaza los intercambiadores. El &acopiador de ajustes&r copia la configuración de una y la pega en otra"
	]
	quest.04DDC43B0FC60E9F.quest_subtitle: "Automatización directa"
	quest.04DDC43B0FC60E9F.title: "Máquinas básicas"
	quest.04EA21F4FE4D4087.quest_desc: ["El &bextraction tome&r saca &atodos&r los encantamientos de un objeto y lo deja &aintacto&r. Es el más caro, pero es el que no pierde nada"]
	quest.04EA21F4FE4D4087.title: "Tomo de extracción"
	quest.04FF0F7FFC343125.quest_desc: [
		"Un relé pasivo, sin inventario ni filtros, que alarga el alcance entre nodos"
		""
		"Puedes encadenar tantos como quieras"
	]
	quest.04FF0F7FFC343125.quest_subtitle: "Alargador"
	quest.054E7CA23E4D7B8F.quest_desc: ["El &bSigil of Unnaming&r sirve para quitar el nombre que los afijos le dan a un objeto"]
	quest.054E7CA23E4D7B8F.title: "Sigilo de borrado de nombre"
	quest.058293C28BB45951.quest_desc: [
		"El &bcristal de lava&r alimenta al &bAthanor&r a cambio de &650 EV&r por objeto"
		""
		"También es la base del &bcristal de activación débil&r para empezar los rituales"
	]
	quest.058293C28BB45951.quest_subtitle: "Combustible"
	quest.06C01998B5F8E899.quest_desc: [
		"El &6Rotation Speed Controller&r te deja &belegir la velocidad exacta&r de una parte de tu red"
		""
		"Se coloca debajo de un engranaje grande y &acontrola la velocidad de ese engranaje&r, perfecto para máquinas que necesitan una RPM concreta"
	]
	quest.06C01998B5F8E899.quest_subtitle: "Velocidad exacta"
	quest.06E15AFA4C8487F0.quest_desc: ["La &binfused seashelf&r es la versión infundida: sube el techo de eterna para llegar a nivel 60"]
	quest.06E15AFA4C8487F0.title: "Seashelf infundida"
	quest.070973BBE710289E.quest_desc: [
		"La &6Cinder Essence&r la dejan las armaduras poseidas, &by también aparece en los cofres de algunas estructuras&r"
		""
		"&aOtro ingrediente para el ojo del jefe&r"
	]
	quest.070973BBE710289E.quest_subtitle: "Ceniza con poder"
	quest.070DAF383221E9CF.quest_desc: [
		"El &aElectrolytic Separator&r separa el agua en &bhidrógeno y oxígeno&r usando bastante &cRF&r"
		""
		"El &boxígeno&r es lo que pide la &aPurification Chamber&r para &atriplicar tus minerales&r, y el hidrógeno sirve como combustible del &6Jetpack&r"
		""
		"Cada gas sale por un lado distinto, usa el &aConfigurator&r para ver por dónde"
	]
	quest.070DAF383221E9CF.quest_subtitle: "Agua en gases"
	quest.070DAF383221E9CF.title: "Electrolytic Separator"
	quest.07C0CF55475F62B4.quest_desc: ["El &btomo de arma&r y el &btomo de arco&r solo aceptan encantamientos válidos para su objeto"]
	quest.07C0CF55475F62B4.quest_subtitle: "Espada y arco"
	quest.07C0CF55475F62B4.title: "Tomos de armas"
	quest.07F5F5A750E258CE.quest_desc: [
		"La tabula de este tier del altar"
		""
		"Hace falta para mejorar la gema de espíritu al nivel &bCommon&r"
	]
	quest.07F5F5A750E258CE.quest_subtitle: "Tabula"
	quest.0879B3FBF7FDE74E.quest_desc: [
		"El &bPaxel de diamante&r es la &amejora del Gilded Paxel&r, se hace igual que la armadura, con la plantilla en la mesa de herrería"
		""
		"&aMás rápido y duradero que cualquier herramienta que hayas tenido hasta ahora&r"
	]
	quest.0879B3FBF7FDE74E.quest_subtitle: "Mejora del Gilded"
	quest.08F3B09FCC9F84B2.quest_desc: [
		"Cada &aescuela de magia&r necesita un objeto distinto como foco al fabricar sus pergaminos. A continuación los tienes todos"
		""
		"&6Rayo:&r botella de rayo. &6Hielo:&r hueso congelado. &6Sangre:&r vial de sangre. &6Sagrado:&r perla divina. &6Ender:&r perla de ender. &6Evocación:&r esmeralda. &6Eldritch:&r fragmento de eco. &6Naturaleza:&r patata venenosa. &6Fuego:&r vara de blaze"
	]
	quest.08F3B09FCC9F84B2.quest_subtitle: "Un foco por escuela"
	quest.08F3B09FCC9F84B2.title: "Materiales de pergaminos"
	quest.09289EBE288F4F9C.quest_desc: ["La &bmagic cloth&r se fabrica con esencia arcana y es la base de la armadura de mago"]
	quest.09289EBE288F4F9C.quest_subtitle: "Para el equipo de mago"
	quest.09289EBE288F4F9C.title: "Tela mágica"
	quest.094E25B735F8F7B8.quest_desc: [
		"Aquí se agrupan formas especiales como el proyectil teledirigido de &bArs Elemental&r y los glifos &aRecall&r y &aRetaliate&r de &bArs Additions&r"
		""
		"Consulta cada glifo con &2R&r para ver su coste y su efecto"
	]
	quest.094E25B735F8F7B8.quest_subtitle: "Más control"
	quest.094E25B735F8F7B8.title: "Formas avanzadas"
	quest.09DCAF5418A8239D.quest_desc: [
		"La &bMetallurgic Infuser&r es la primera máquina de &bMekanism&r que usa &cRF&r: necesitas conectarla a tu red de energía"
		""
		"Funciona mezclando un material con un &ainfusionable&r (carbono, redstone, diamante...) para crear aleaciones y materiales mejores. Los infusionables salen de objetos como el carbón y se almacenan en la propia máquina"
		""
		"Con ella vas a fabricar &aacero&r, la base para casi todo lo que viene después"
	]
	quest.09DCAF5418A8239D.quest_subtitle: "Tu primera máquina con RF"
	quest.09DCAF5418A8239D.title: "Metallurgic Infuser"
	quest.0A455E3F176C90B1.quest_desc: [
		"El &6vapor&r es de las formas más fuertes de generar rotación en &aCreate&r"
		""
		"Necesitas tres cosas, un &btanque de fluidos&r como caldera, &6calor&r de quemadores de blaze debajo y &bagua&r constante, y sobre eso pegas los &6motores de vapor&r"
		""
		"&aMientras más calor, agua y tamaño tenga la caldera, más motores puede mover&r, revísalo todo con las gafas"
	]
	quest.0A455E3F176C90B1.quest_subtitle: "El motor de la industria"
	quest.0A455E3F176C90B1.title: "Vapor"
	quest.0A4A6F91004AFD2D.quest_desc: [
		"El &bReactor&r es el generador más potente. Pide uraninita, un mineral raro que aparece en las profundidades"
		""
		"El libro de Powah detalla su refrigeración y cómo montarlo"
		"{@pagebreak}"
		"Reactores"
		"{image:powah:textures/gui/book/images/reactor.png width:150 height:100 align:center click_action:none:}"
		""
		"Interfaz"
		"{image:powah:textures/gui/book/images/reactor_gui.png width:200 height:75 align:center click_action:none:}"
	]
	quest.0A4A6F91004AFD2D.quest_subtitle: "Mucha energía"
	quest.0A4A6F91004AFD2D.title: "Reactor"
	quest.0A7E37388EE521C7.quest_desc: [
		"La &6Portable Fluid Interface&r &bpasa fluidos entre un artefacto en movimiento y un tanque fijo&r, cuando quedan frente a frente"
		""
		"&aMuy útil para trenes y artefactos que cargan líquidos&r"
	]
	quest.0A7E37388EE521C7.quest_subtitle: "Fluidos en movimiento"
	quest.0AA13A9333C44163.quest_desc: [
		"El &aLogistical Transporter&r mueve &bobjetos&r entre cofres y máquinas, y puedes verlos viajar por dentro"
		""
		"&cSi no saca objetos de un cofre&r cambia el modo de esa conexión con el &aConfigurator&r, también se puede &dpintar por colores&r para separar rutas"
	]
	quest.0AA13A9333C44163.quest_subtitle: "Tuberías de objetos"
	quest.0AA13A9333C44163.title: "Logistical Transporter"
	quest.0B44BBE17254097F.quest_desc: [
		"Las &bdagas arrojadizas&r marcan a un enemigo hostil con motas espectrales"
		""
		"Si lo matas mientras está marcado, suelta &cespíritus&r"
	]
	quest.0B44BBE17254097F.quest_subtitle: "Marca a tus presas"
	quest.0B4939865B4F6D44.quest_desc: ["El &bcursed doll spell book&r (libro vampírico) potencia los hechizos de &asangre&r y da algo de resistencia a los hechizos"]
	quest.0B4939865B4F6D44.quest_subtitle: "Magia de sangre"
	quest.0B4939865B4F6D44.title: "Libro vampírico"
	quest.0BC0A9C21086C16B.quest_desc: [
		"La &dabjuration essence&r se prepara en la cámara de imbuición con una gema de Source y objetos como el ojo de araña fermentado, el azúcar o el cubo de leche"
		""
		"Se usa en glifos de protección y en objetos defensivos"
	]
	quest.0BC0A9C21086C16B.quest_subtitle: "Protección y alquimia"
	quest.0BC0A9C21086C16B.title: "Esencia de abjuración"
	quest.0BC3F2D2AF247D0B.quest_desc: [
		"El fregadero de &aCooking for Blockheads&r da &bagua infinita&r, sirve para llenar cubetas y botellas sin tener que armar una fuente"
		""
		"&aTambién se le puede sacar agua con tuberías&r, ideal para máquinas que necesitan agua constante"
	]
	quest.0BC3F2D2AF247D0B.quest_subtitle: "Agua infinita"
	quest.0BC3F2D2AF247D0B.title: "Fregadero"
	quest.0C3945AAEA11B20C.quest_desc: [
		"&bPowah&r empieza con la &adielectric paste&r (3 carbones, 2 bolas de arcilla y un cubo de lava) y las varillas dieléctricas, con las que haces el &acasing&r"
		""
		"Al completar la quest recibes la llave de Powah y su libro. Úsalos: el libro explica cada máquina"
	]
	quest.0C3945AAEA11B20C.quest_subtitle: "El comienzo de Powah"
	quest.0C3945AAEA11B20C.title: "Dielectric Casing"
	quest.0C39A7302E7CFCFA.title: "Anillo"
	quest.0C583A3499EE4E1A.quest_desc: ["Los generadores pasivos no necesitan combustible: los &asolar panels&r captan la luz del sol y los &athermo generators&r aprovechan el calor"]
	quest.0C583A3499EE4E1A.quest_subtitle: "Generadores pasivos"
	quest.0C8F56E07629B7B9.quest_desc: [
		"Usando &d/sethome (nombre del home)&r puedes crear un home, y usando &2/home (nombre del home)&r puedes hacerte teleport hacia él"
		""
		"Puedes tener un &#FF022Amáximo de 2&r homes diferenciados por el nombre"
	]
	quest.0C8F56E07629B7B9.quest_subtitle: "Hogar dulce hogar"
	quest.0CB7B61DCBC2D9F6.quest_desc: [
		"Casi un ender chest, pero no del todo: con &bShift + clic derecho&r en un contenedor lo enlazas, y luego con clic derecho al aire lo abres desde lejos por &6200 EV&r"
		""
		"El chunk del contenedor debe estar cargado y, si lo destruyes, el enlace se rompe"
	]
	quest.0CB7B61DCBC2D9F6.quest_subtitle: "Contenedor remoto"
	quest.0DF4E5FE556A26BC.quest_desc: ["En la mesa de herrería, el equipo de celestigem, esta plantilla y un lingote de eclipse alloy dan el equipo de &beclipse alloy&r"]
	quest.0DF4E5FE556A26BC.quest_subtitle: "La última"
	quest.0DF4E5FE556A26BC.title: "Plantilla de eclipse"
	quest.0E1BB3A7203F5B5E.quest_desc: [
		"El &bAthanor&r es un horno alquímico y es necesario para seguir avanzando: aquí juntaremos los materiales para mejorar el altar"
		""
		"Funciona con una &bcélula de combustible primitiva&r (128 operaciones) o con un &bcristal de lava&r (&650 EV&r por objeto)"
		"{@pagebreak}"
		"Va más rápido cuanto más &cespíritu&r suelto haya en el chunk, el doble con &6100&r y la mitad sin ninguno"
	]
	quest.0E1BB3A7203F5B5E.quest_subtitle: "Horno alquímico"
	quest.0E6C01B1F19617FC.quest_desc: [
		"La &bStorage Tool&r enlaza y bloquea almacenes y muestra u oculta contadores, niveles y mejoras. Cambia de modo con &2Shift + rueda&r"
		""
		"Hecha sobre el controlador, el cambio afecta a toda la red"
	]
	quest.0E6C01B1F19617FC.quest_subtitle: "Ajustes en un clic"
	quest.0E6C01B1F19617FC.title: "Herramienta de almacenamiento"
	quest.0E774399EE646584.quest_desc: [
		"Con el &6Copper Casing&r se abren las &6máquinas de cobre&r, enfocadas en &bfluidos&r"
		""
		"&aLlenar, vaciar, mover y bombear líquidos&r, revisa cada misión de esta rama"
	]
	quest.0E774399EE646584.quest_subtitle: "Todo sobre fluidos"
	quest.0E774399EE646584.title: "Máquinas de cobre"
	quest.0EDD07BF66F9C889.quest_desc: [
		"Coloca los &aMob Fan&r donde se ve en la imagen, se activan con &aRedstone Links&r de &bCreate&r, aunque simples palancas también funcionan"
		""
		"{image:undercraft:textures/questpics/grinding_utils/mob_farm_setup_step_3.png width:200 height:175 align:center click_action:none:}"
		"{@pagebreak}"
		"Revisa el &brango de los ventiladores&r para saber &acuántas mejoras&r necesitan"
		""
		"{image:undercraft:textures/questpics/grinding_utils/mob_farm_setup_step_4.png width:200 height:175 align:center click_action:none:}"
		"{@pagebreak}"
		"Ajústalos para que &bconverjan&r en el punto donde estará el &aMob Masher&r"
		""
		"{image:undercraft:textures/questpics/grinding_utils/mob_farm_setup_step_5.png width:200 height:175 align:center click_action:none:}"
	]
	quest.0EDD07BF66F9C889.quest_subtitle: "Empuja a los mobs al centro"
	quest.0EDD07BF66F9C889.title: "Los ventiladores"
	quest.0F4126D65257FF17.quest_desc: [
		"El &6Latón&r se hace mezclando &6cobre&r y &7zinc&r en una &bBasin&r con la mezcladora y &ccalor de un quemador de blaze&r"
		""
		"&aCon el fabricas el casing de latón&r y todo el equipo avanzado de &aCreate&r"
	]
	quest.0F4126D65257FF17.quest_subtitle: "El metal del ingeniero"
	quest.0F4126D65257FF17.title: "Latón"
	quest.0F68109D9790A5C3.quest_desc: [
		"El &bEnergizing Orb&r fabrica materiales con &cenergía&r. Necesita varillas (&aenergizing rods&r) a menos de 9x9 bloques: más varillas y de mayor nivel, más velocidad"
		""
		"Las varillas deben colocarse sobre cables u otros bloques de energía para recibir &cRF&r"
		"{@pagebreak}"
		""
		"{image:powah:textures/gui/book/images/energizing.png width:200 height:110 align:center click_action:none:}"
	]
	quest.0F68109D9790A5C3.quest_subtitle: "Cocinar con energía"
	quest.0F68109D9790A5C3.title: "Orbe de energía"
	quest.0F8CFA0A74615A75.quest_desc: [
		"Acá el equipo de diamante &cno se fabrica directo&r, &ase consigue mejorando tu equipo Gilded&r en la mesa de herrería"
		""
		"Necesitas esta &bplantilla de mejora de diamante&r, el diamante y la pieza &6Gilded&r que quieras mejorar, &afunciona igual para armadura y herramientas&r"
		""
		"Revisa con &bR&r la receta de la plantilla, &9los fragmentos de cristal luminoso&r son la parte difícil"
	]
	quest.0F8CFA0A74615A75.quest_subtitle: "El diamante también se gana"
	quest.0F8CFA0A74615A75.title: "Plantilla de diamante"
	quest.0FBCB3428F7AA81B.quest_desc: [
		"El &aThermodynamic Conductor&r mueve &bcalor&r en lugar de energía u objetos"
		""
		"Lo vas a necesitar con las máquinas que trabajan con temperatura, como los calentadores y las calderas"
	]
	quest.0FBCB3428F7AA81B.quest_subtitle: "Tuberías de calor"
	quest.0FBCB3428F7AA81B.title: "Thermodynamic Conductor"
	quest.105871D061F5ADA7.quest_desc: [
		"La &bpacking tape&r (8 usos) te deja romper un cofre o barril y llevarlo empaquetado con todo su contenido. La &bsuper packing tape&r tiene 32 usos"
		""
		"&eOjo:&r no funciona con almacenes enlazados a un controlador"
	]
	quest.105871D061F5ADA7.quest_subtitle: "Mudanzas sin dramas"
	quest.105871D061F5ADA7.title: "Cinta de embalaje"
	quest.108B45C671DAD1CB.quest_desc: [
		"El &aAdvanced Control Circuit&r junta un &7Basic&r con &aInfused Alloy&r"
		""
		"Lo piden las máquinas de nivel medio y los &6Tier Installers&r avanzados"
	]
	quest.108B45C671DAD1CB.quest_subtitle: "Circuito nivel 2"
	quest.108B45C671DAD1CB.title: "Advanced Control Circuit"
	quest.10946E1AB1685E09.quest_desc: [
		"Los &abastones&r son armas mágicas: cada uno trae un hechizo propio que lanzas con clic derecho y que, además, potencia su &aescuela&r"
		""
		"Combinan muy bien con un libro de hechizos: el bastón para tu hechizo principal y el libro para el resto"
	]
	quest.10946E1AB1685E09.quest_subtitle: "Magia sin libro"
	quest.10946E1AB1685E09.title: "Bastones"
	quest.10BA90DFC88C22D8.quest_desc: [
		"El controlador une los cajones sin que tengan que tocarse. Su radio por defecto es de 8 bloques, y las mejoras de almacenamiento lo amplían"
		""
		"Enlaza los cajones con la herramienta de enlace"
	]
	quest.10BA90DFC88C22D8.quest_subtitle: "Cajones conectados"
	quest.10BA90DFC88C22D8.title: "Storage Controller"
	quest.10E19A838E81C09B.quest_desc: [
		"Has llegado lejos, y es buen momento para revisar tus &dniveles de mundo&r de &bApotheosis&r: puede que ya tengas uno nuevo desbloqueado"
		""
		"Pulsa &2CTRL+T&r para verlos y, si te sientes listo, &aactívalo&r. El botín mejora, pero los enemigos se vuelven más duros"
	]
	quest.10E19A838E81C09B.quest_subtitle: "Revisa tu World Tier"
	quest.10E19A838E81C09B.title: "Un nuevo nivel de mundo"
	quest.10F23604B6A2B7C0.quest_desc: [
		"El &5Ender Inhibitor&r evita que los Enderman se teletransporten en un área cercana"
		""
		"Perfecto para &aevitar que salgan de la granja&r y roben bloques"
	]
	quest.10F23604B6A2B7C0.quest_subtitle: "No saldrán de ahí"
	quest.10F23604B6A2B7C0.title: "Ender Inhibitor"
	quest.1107EF420EC2B398.quest_desc: ["Para mover la energía de un sitio a otro usa cables, puertas de ender (&aender gates&r) o transmisores de jugador"]
	quest.1107EF420EC2B398.quest_subtitle: "Mover energía"
	quest.116BC056694F3A8C.quest_desc: ["El &bender gem case&r es la versión mejorada del estuche, con más capacidad"]
	quest.116BC056694F3A8C.quest_subtitle: "Versión mejorada"
	quest.116BC056694F3A8C.title: "Estuche de gemas del End"
	quest.1183FF54F5718BEB.quest_desc: ["El nivel de cobre sube el almacén a 45 huecos. Hay mejoras que saltan niveles directamente, como de básico a cobre"]
	quest.1183FF54F5718BEB.quest_subtitle: "Más espacio"
	quest.1183FF54F5718BEB.title: "Cobre"
	quest.11A58628DDE6C3AB.quest_desc: [
		"Paga &6100 monedas&r y recibe &bun accesorio al azar&r de nivel medio de &aArtifacts&r y &aRelics&r"
		""
		"Se puede comprar de nuevo &7cada 2 horas&r"
	]
	quest.11A58628DDE6C3AB.quest_subtitle: "Un accesorio al azar"
	quest.11A58628DDE6C3AB.title: "Medium Tier Curio"
	quest.11A69A421DA07539.quest_desc: [
		"La &6Mechanical Mixer&r, puesta encima de una &bBasin&r, &amezcla ingredientes y hace recetas sin forma fija&r"
		""
		"&cAlgunas recetas necesitan calor&r, para eso va el quemador de blaze debajo de la basin"
	]
	quest.11A69A421DA07539.quest_subtitle: "Recetas sin manos"
	quest.11A69A421DA07539.title: "Mezcladora"
	quest.122CFA6B71734794.quest_desc: ["Elimina &c25 blazes&r"]
	quest.122CFA6B71734794.quest_subtitle: "25 monedas"
	quest.122CFA6B71734794.title: "Cazador de blazes III"
	quest.12492814044531F3.quest_desc: [
		"El &aBundle&r guarda &bvarios objetos distintos en un solo espacio&r, su capacidad es igual a un stack de 64"
		""
		"Un objeto que se apila hasta 64 ocupa 1, uno de 16 ocupa 4 y &cuno que no se apila ocupa todo el bundle&r"
		""
		"Mete objetos haciendo clic con ellos sobre el bundle, y &asácalos con clic derecho en un espacio vacío&r"
	]
	quest.12492814044531F3.quest_subtitle: "Un bolsillo extra"
	quest.12492814044531F3.title: "Bundle"
	quest.1255585B72EA751F.quest_desc: ["El glifo &aSplit&r divide el proyectil en varios. Es potente, pero cada copia gasta maná"]
	quest.1255585B72EA751F.quest_subtitle: "Un hechizo, varios objetivos"
	quest.1255585B72EA751F.title: "Split"
	quest.126C2D89FF26C7BE.quest_desc: [
		"Los glifos de nivel 2 incluyen explosiones, curación, intercambio de bloques, crecimiento y varios efectos elementales de &bArs Elemental&r"
		""
		"Para usarlos necesitas un libro de nivel superior"
	]
	quest.126C2D89FF26C7BE.quest_subtitle: "Más poder"
	quest.126C2D89FF26C7BE.title: "Efectos de nivel 2"
	quest.12F3916BDA18777D.quest_desc: [
		"La &bEnder Gate&r mueve energía entre el bloque que toca y tu red de ender. No sirve para ampliar la capacidad de la red"
		""
		""
		"{image:powah:textures/gui/book/images/ender_gate.png width:150 height:100 align:center}"
	]
	quest.12F3916BDA18777D.quest_subtitle: "Puerta a tu red de ender"
	quest.12F3916BDA18777D.title: "Ender Gate"
	quest.133388F1B267B87A.quest_desc: [
		"Por fin aparece el &bdiamante&r, &cpero no lo gastes en equipo todavía&r, lo necesitas para el invocador de &6Eldorath&r"
		""
		"Al pasarlo por la &aEnrichment Chamber&r se convierte en &bdiamante enriquecido&r, el ingrediente clave de la &bBuilder Stone&r"
	]
	quest.133388F1B267B87A.quest_subtitle: "Un diamante para el invocador"
	quest.134BCEA6B2CCE8D3.quest_desc: [
		"Las &aConstruction Sticks&r colocan &bvarios bloques a la vez&r, siguiendo la cara del bloque que estás mirando"
		""
		"Mientras mejor el material, más bloques por uso, &6desde 3 con la de madera&r hasta &7512 con la de netherite&r"
		""
		"También se pueden &dmejorar con plantillas&r en la mesa de herrería, para colocar desde lejos, romper rápido, no gastar durabilidad o funcionar con &cRF&r"
	]
	quest.134BCEA6B2CCE8D3.quest_subtitle: "Muchos bloques de un golpe"
	quest.134BCEA6B2CCE8D3.title: "Varitas de construcción"
	quest.13B88310A6DCEC8A.quest_desc: ["El &bSigil of Rebirth&r se usa en la mesa de reforja para &arerolear los afijos&r de un objeto"]
	quest.13B88310A6DCEC8A.title: "Sigilo de renacimiento"
	quest.1404EFF0AF3652FC.quest_desc: [
		"Con el hierro llegan los escudos de &aShield Expansion&r"
		""
		"Para fabricar el de &fhierro&r necesitas un &bescudo normal&r, que se mejora con el material, &casí que no lo tires&r"
		""
		"Los escudos mejores &aaguantan más golpes&r, &cpero dejan menos margen para hacer parry&r"
	]
	quest.1404EFF0AF3652FC.quest_subtitle: "Mejores escudos"
	quest.1404EFF0AF3652FC.title: "Escudo de hierro"
	quest.14439E8D98D2C7C2.quest_desc: ["El &6Brass Casing&r se hace aplicando &6latón&r sobre madera sin corteza, &ay es la base de todas las máquinas de latón&r"]
	quest.14439E8D98D2C7C2.quest_subtitle: "Base de lo avanzado"
	quest.1470AF6840EECE73.quest_desc: [
		"En la &bMob Jar&r vive la criatura que capturaste. Sigue actuando con normalidad: las gallinas ponen huevos, las ovejas se esquilan y las vacas se ordeñan"
		""
		"Para capturar más de un mob se ocupan más jars son necesarios, además es necesario tener source jars con &dsource&r"
		"{@pagebreak}"
	]
	quest.1470AF6840EECE73.quest_subtitle: "Un zoo en miniatura"
	quest.1470AF6840EECE73.title: "Jarra de contención"
	quest.14A07D6BB23D8862.quest_desc: [
		"El &aHang Glider&r te deja &bplanear largas distancias&r, perfecto para viajar desde montañas o torres altas"
		""
		"Salta desde lo alto, ábrelo y &aplanea en vez de caer&r, mientras más alto empieces, más lejos llegas"
		""
		"&cNo te hace ganar altura&r, así que siempre vas a necesitar un punto alto para empezar"
	]
	quest.14A07D6BB23D8862.quest_subtitle: "Planear desde lo alto"
	quest.14A07D6BB23D8862.title: "Ala delta"
	quest.14AB8B5461C068DA.quest_desc: ["La &bsoul-touched deepshelf&r es una deepshelf mejorada que usa arena de almas y llega a nivel 75"]
	quest.14AB8B5461C068DA.title: "Deepshelf del alma"
	quest.14CA99A0BE41EF14.quest_desc: ["Las mejoras multiplican la capacidad: cobre x8, oro x16, diamante x24 y netherite x32. Existe también una versión de hierro que, al contrario, la reduce"]
	quest.14CA99A0BE41EF14.quest_subtitle: "Cajones más grandes"
	quest.14CA99A0BE41EF14.title: "Mejoras de capacidad"
	quest.14DC8782F02AD852.quest_desc: [
		"Paga &6250 monedas&r y consigue un &btoken de regeneración&r para poder regenerar 1 estructura completa desde cero"
		""
		"Se puede comprar de nuevo &7cada 6 horas&r"
	]
	quest.14DC8782F02AD852.title: "Token de regeneración"
	quest.14F343F38540D872.quest_desc: ["El oro sube hasta 81 huecos y 3 ranuras de mejora"]
	quest.14F343F38540D872.quest_subtitle: "Aún más capacidad"
	quest.14F343F38540D872.title: "Oro"
	quest.1565144FB476D896.quest_desc: [
		"Dale el &aGM Chicken Feed Cursed&r a una gallina y pondrá un &aRotten Egg&r"
		""
		"Usa el huevo sobre tierra o pasto y se convertirá en un área de &b5x5 de Dreadful Dirt&r, donde &blos monstruos aparecen mucho más rápido&r en la oscuridad"
		""
		"&cSe quema con el sol si queda al aire libre&r, &ccuidado con lo que aparece&r"
	]
	quest.1565144FB476D896.quest_subtitle: "Más mobs, más rápido"
	quest.1565144FB476D896.title: "Tierra maldita"
	quest.15669E312F75304C.quest_desc: [
		"Se mejora en la &bHellfire Forge&r con &bdiamante&r, &blapislázuli&r y &bredstone&r"
		""
		"La capacidad sube de 64 a &6256&r"
	]
	quest.15669E312F75304C.quest_subtitle: "Gema 2 de 5"
	quest.156D0EEAC6796665.quest_desc: [
		"Cada &bBookwyrm Charm&r añade un bookwyrm al atril y aumenta cuántos inventarios puede conectar"
		""
		"Se consigue aumentando el ritual del despertar con un libro y pluma"
	]
	quest.156D0EEAC6796665.quest_subtitle: "Más cofres conectados"
	quest.156D0EEAC6796665.title: "Bookwyrm"
	quest.158767C96747EE25.quest_desc: ["El &bcopper spell book&r (diario endeble) es el primer libro de hechizos. Tiene muy pocas ranuras, pero ya te permite empezar"]
	quest.158767C96747EE25.quest_subtitle: "Tu primer libro"
	quest.158767C96747EE25.title: "Libro de cobre"
	quest.161266FDA6767D23.quest_desc: ["El &btomo de pico&r, el &btomo de caña&r y el &btomo genérico&r solo aceptan encantamientos válidos para su tipo de objeto. El genérico sirve para todo lo demás"]
	quest.161266FDA6767D23.quest_subtitle: "Pico, caña y otros"
	quest.161266FDA6767D23.title: "Tomos de herramientas"
	quest.16222B70F878D5C0.quest_desc: ["La armadura de mago da &amaná máximo&r y potencia tus hechizos."]
	quest.16222B70F878D5C0.title: "Armadura de mago"
	quest.162C8978E771AB88.quest_desc: [
		"La &bEnder Cell&r almacena energía en un canal de tu red de ender y se accede desde cualquier parte, si tienes capacidad suficiente"
		""
		"Para agregar capacidad hay que coloca una &aEnergy Cell&r o una &aBateria&r, cualquiera funciona y &csera consumida&r, agregando su capacidad a la &bEnder Cell&r"
		""
		""
		"{image:powah:textures/gui/book/images/ender_cell.png width:150 height:100 align:center}"
	]
	quest.162C8978E771AB88.quest_subtitle: "Energía por canales"
	quest.162C8978E771AB88.title: "Ender Cell"
	quest.167DAD010FAA6434.quest_desc: [
		"Las mejoras de herramienta añaden detector de minerales y de mobs, minado de vetas, tala de árboles, martillo de área, fundición automática y mucho más. Se instalan en la mesa de herrería"
		""
		"Con &2Shift + clic derecho&r abres los ajustes de la herramienta"
	]
	quest.167DAD010FAA6434.quest_subtitle: "El arsenal del explorador"
	quest.167DAD010FAA6434.title: "Mejoras de armas y herramientas"
	quest.16C53A3EB0DEE53F.quest_desc: [
		"La &aTrowel&r de &aUtilitarian&r coloca un &bbloque al azar de tu barra rápida&r cada vez que la usas"
		""
		"Mientras más bloques tengas de un tipo, más probable es que salga, &aperfecta para pisos y paredes con aspecto natural&r sin tener que ir eligiendo bloque por bloque"
	]
	quest.16C53A3EB0DEE53F.quest_subtitle: "Bloques al azar"
	quest.16C53A3EB0DEE53F.title: "Paleta"
	quest.16F34D070DF3FAC2.quest_desc: [
		"La &6Hose Pulley&r baja una manguera y &bsaca o llena grandes cantidades de fluido&r de una sola vez"
		""
		"&aSi el lago es lo bastante grande, cuenta como infinito&r"
	]
	quest.16F34D070DF3FAC2.quest_subtitle: "Lagos enteros"
	quest.17194F1C820C7858.quest_desc: [
		"El conjunto de &bCultista&r potencia los hechizos de &asangre&r, la escuela de magia que más rinde con él"
		""
		"Pulsa &2R&r sobre el objeto para ver cómo conseguirlo"
	]
	quest.17194F1C820C7858.quest_subtitle: "Pieza 4 de 4"
	quest.173C69F26ACA4F6D.quest_desc: [
		"Las &aBotany Pots&r son macetas donde puedes plantar &bcasi cualquier cultivo&r, solo ponle su tierra y su semilla, cada planta pide la suya, &6ponle una azada&r para que produzca"
		""
		"Las &aBonsai Pots&r hacen lo mismo con &bárboles en miniatura&r, ponle un retoño y su tierra, y para que corte sola &6dale un hacha&r, la madera, hojas y frutos se guardan en la maceta"
		""
		"&6Las Botany Pots con tolva&r mandan la cosecha a un cofre, de las Bonsai Pots la sacas con una tolva o tubería"
		""
		"Una herramienta con &dCurse of Idle Hands&r &ano se gasta nunca dentro de la maceta&r, esta quest te deja elegir una"
	]
	quest.173C69F26ACA4F6D.quest_subtitle: "Cultivos y árboles en maceta"
	quest.173C69F26ACA4F6D.title: "Macetas botánicas"
	quest.173E015B23A2E3FD.quest_desc: [
		"El &6Encased Fan&r crea una corriente de aire que &bprocesa los objetos que atraviesa&r, según el bloque que pongas delante"
		""
		"&cLava&r para fundir, &6fuego&r para ahumar, &bagua&r para lavar y &3fuego de almas&r para embrujar"
		""
		"&aLavar minerales triturados te da pepitas extra&r"
	]
	quest.173E015B23A2E3FD.quest_subtitle: "El viento hace magia"
	quest.173E015B23A2E3FD.title: "Ventilador"
	quest.173ED989CD7AB269.quest_desc: [
		"El &aMob Fan&r &bempuja a los mobs&r hacia donde apunta, úsalo para llevarlos al punto donde los vas a matar"
		""
		"&cNecesita una señal de redstone para funcionar&r"
	]
	quest.173ED989CD7AB269.quest_subtitle: "Empuja a los mobs"
	quest.173ED989CD7AB269.title: "Mob Fan"
	quest.1789B6A3C5F93C32.quest_desc: [
		"Cada &aData Model&r sube de nivel &bmatando al mob que estudia&r con el &aDeep Learner&r encima"
		""
		"Hay cinco niveles, &7Faulty&r, &aBasic&r, &9Advanced&r, &dSuperior&r y &6Self Aware&r, &cun modelo Faulty no se puede simular&r y mientras más nivel, más simulaciones salen bien"
	]
	quest.1789B6A3C5F93C32.quest_subtitle: "Entrena a tus modelos"
	quest.1789B6A3C5F93C32.title: "Data Models"
	quest.178A2B5A1B877DC4.quest_desc: ["El &bAdvanced Wireless Terminal&r se obtiene mejorando el terminal inalámbrico con el netherite. Tiene mucho más alcance, unos 64 bloques por defecto"]
	quest.178A2B5A1B877DC4.quest_subtitle: "Más lejos"
	quest.178A2B5A1B877DC4.title: "Terminal inalámbrico avanzado"
	quest.184827C8B8A4D869.quest_desc: ["El &bnetherite spell book&r es el mejor libro de la línea clásica: máximo de ranuras, mucho maná y menos enfriamiento de hechizos"]
	quest.184827C8B8A4D869.quest_subtitle: "El mejor libro común"
	quest.184827C8B8A4D869.title: "Libro de netherite"
	quest.189F8C4C49AD1DA3.quest_desc: [
		"Entrega un &ebloque de oro&r y recibe &615 monedas&r en tu cartera"
		""
		"Se puede repetir todas las veces que quieras"
	]
	quest.189F8C4C49AD1DA3.quest_subtitle: "15 monedas"
	quest.189F8C4C49AD1DA3.title: "Vender oro"
	quest.18C791F05380BC8B.quest_desc: [
		"Las &carmas pesadas&r son &clentas y a dos manos&r, pero &acada golpe hace muchísimo daño&r y muchas &bpegan en área&r"
		""
		"Las de &eoro&r llegan después del &6Goblin Lord&r, &6ideales si prefieres pocos golpes pero contundentes&r"
	]
	quest.18C791F05380BC8B.quest_subtitle: "Golpes de oro macizo"
	quest.18C791F05380BC8B.title: "Armas pesadas de oro"
	quest.193E2B0CB80ED7C7.quest_desc: ["El &6Item Drain&r &bvacía los objetos que pasan sobre él&r, como cubetas o botellas, y guarda el fluido para que lo saques con tuberías"]
	quest.193E2B0CB80ED7C7.quest_subtitle: "Vaciar objetos"
	quest.1949DDA04261CDA8.quest_desc: [
		"La &bspawner rune&r es la runa base de mejoras de spawner"
		""
		"A partir de ella se fabrican runas más específicas dependiendo que quieras para tu spawner"
	]
	quest.1949DDA04261CDA8.quest_subtitle: "La mejora básica"
	quest.1949DDA04261CDA8.title: "Runa de spawner"
	quest.19642B83554917FB.quest_desc: [
		"El &aAdvanced Solar Generator&r es la versión grande del solar, &bocupa más espacio pero produce bastante más energía&r"
		""
		"Tiene las mismas limitaciones, &csolo funciona de día y con el cielo despejado&r, pero un par de ellos ya pueden mantener una base pequeña"
	]
	quest.19642B83554917FB.quest_subtitle: "Más grande, más energía"
	quest.19642B83554917FB.title: "Advanced Solar Generator"
	quest.19682AD389D3B8D8.quest_desc: [
		"Los drygmies son criaturas pequeñas y trabajadoras de &bArs Nouveau&r. Para empezar necesitas el &acuerno wilden&r y dárselo a un drygmy del mundo, este te dará un fragmento de drygmy"
		""
		"Con ellos fabricarás el amuleto que los invoca"
	]
	quest.19682AD389D3B8D8.quest_subtitle: "El primer paso"
	quest.19682AD389D3B8D8.title: "Llamar a un drygmy"
	quest.19D7B42D4AEA174E.quest_desc: ["La energía hay que almacenarla. Las &aenergy cells&r guardan mucha, y las &aender cells&r la comparten por canales en tu red de ender"]
	quest.19D7B42D4AEA174E.quest_subtitle: "Guardar energía"
	quest.19E56E0C5983CF00.title: "Manos"
	quest.19E8B94AAA0211E6.quest_desc: [
		"El conjunto de &bCultista&r potencia los hechizos de &asangre&r, la escuela de magia que más rinde con él"
		""
		"Ideal para robar vida y levantar muertos"
		""
		"Pulsa &2R&r sobre el objeto para ver cómo conseguirlo"
	]
	quest.19E8B94AAA0211E6.quest_subtitle: "Pieza 1 de 4"
	quest.19E9ED96A63C8A98.quest_desc: [
		"Se crea con el goo de nivel 4 sobre un bloque de amatista en crecimiento. Para producir, debe cargarse en tres etapas: Overworld, Nether y End"
		""
		"Las yemas solo se pueden recoger una vez maduras. Si rompes una sin madurar, la pierdes"
	]
	quest.19E9ED96A63C8A98.quest_subtitle: "Cristales del tiempo"
	quest.19E9ED96A63C8A98.title: "Bloque de cristal del tiempo"
	quest.1A0586C0A1B202FD.quest_desc: [
		"El conjunto de &bPlagado&r potencia los hechizos de &anaturaleza&r, la escuela de magia que más rinde con él"
		""
		"Ideal para envenenar y resistir"
		""
		"Pulsa &2R&r sobre el objeto para ver cómo conseguirlo"
	]
	quest.1A0586C0A1B202FD.quest_subtitle: "Pieza 1 de 4"
	quest.1A5A815D195E49BC.quest_desc: [
		"El altar que necesitarás para avanzar a lo largo de &4Neo Vitae&r"
		""
		"Como recompensa recibes la &bScriptura Vitae&r, la guía del mod dentro del juego"
		"{@pagebreak}"
		"El altar a nivel máximo mide &c6 bloques de altura&r, así que conviene empezarlo con la altura que necesitará en el futuro"
		"{image:undercraft:textures/questpics/neo_vitae/tier_0_altar.png width:70 height:200 align:center click_action:none:}"
		"{@pagebreak}"
		"Los buffers del altar vistos de forma gráfica: &dMain&r, &9Input&r y &cOutput&r"
		""
		"Lo que bombeas con tuberías entra por el &9Input&r y pasa poco a poco al &dMain&r, la cuenca donde se gasta el &cEV&r"
		""
		"{image:undercraft:textures/questpics/neo_vitae/altar_buffers.png width:100 height:100 align:center}"
	]
	quest.1A5A815D195E49BC.quest_subtitle: "Ara Vitae"
	quest.1A98EB1403E22541.quest_desc: ["El &bSigil of Enhancement&r sirve para mejorar un objeto. Pulsa &2R&r sobre él para ver su uso exacto"]
	quest.1A98EB1403E22541.quest_subtitle: "El combustible"
	quest.1A98EB1403E22541.title: "Sigilo de mejora"
	quest.1AD0981070695E5E.quest_desc: [
		"La &btinta poco común&r se fabrica en el caldero a partir de &atinta común&r y una &apatata venenosa&r"
		""
		"Es uno de los ingredientes del &bEmerald Totem&r, el invocador de &6Arion&r"
	]
	quest.1AD0981070695E5E.quest_subtitle: "Para el invocador de Arion"
	quest.1AD0981070695E5E.title: "Tinta poco común"
	quest.1AD1478F78F5DA9D.quest_desc: [
		"El conjunto de &bArchievocador&r potencia los hechizos de &aevocación&r, la escuela de magia que más rinde con él"
		""
		"Pulsa &2R&r sobre el objeto para ver cómo conseguirlo"
	]
	quest.1AD1478F78F5DA9D.quest_subtitle: "Pieza 2 de 4"
	quest.1AE056883D51F2AE.quest_desc: ["El &6Spout&r &bllena objetos con fluidos&r, como botellas, cubetas o ingredientes de recetas, cuando pasan por debajo sobre un depot o una cinta"]
	quest.1AE056883D51F2AE.quest_subtitle: "Llenar objetos"
	quest.1B1ACDE3BC9E146D.quest_desc: ["El &bCrafting Terminal&r añade una cuadrícula de crafteo a la vista de la red y usa directamente los materiales almacenados"]
	quest.1B1ACDE3BC9E146D.quest_subtitle: "Almacena y fabrica"
	quest.1B1ACDE3BC9E146D.title: "Terminal de crafteo"
	quest.1B2D2036475034C1.quest_desc: [
		"El &bStarbuncle Charm&r te da un starbuncle, una criatura que transporta objetos entre cofres"
		""
		"Con la &bDominion Wand&r, clic en el starbuncle y luego en el cofre de destino; para el origen, primero el cofre y luego el starbuncle"
	]
	quest.1B2D2036475034C1.quest_subtitle: "Un ayudante con prisa"
	quest.1B2D2036475034C1.title: "Starbuncle"
	quest.1B5D995C3E689188.quest_desc: [
		"La &aarmadura de esmeralda&r no tiene nada de especial, es una armadura extra que no sera necesaria para la progresion."
		""
		"Es mas fuerte que la Gilded y mas debil que la de diamante."
	]
	quest.1B5D995C3E689188.title: "Armadura de esmeralda"
	quest.1B932B48667CE42A.quest_desc: [
		"Entrega un &7bloque de hierro&r y recibe &65 monedas&r en tu cartera"
		""
		"Se puede repetir todas las veces que quieras"
	]
	quest.1B932B48667CE42A.quest_subtitle: "5 monedas"
	quest.1B932B48667CE42A.title: "Vender hierro"
	quest.1BA61A9AB13EE12C.quest_desc: ["La &besmeralda&r es el foco de la escuela de &aevocación&r"]
	quest.1BA61A9AB13EE12C.quest_subtitle: "Foco de evocación"
	quest.1BA61A9AB13EE12C.title: "Esmeralda"
	quest.1BB971C9FEF18A55.quest_desc: [
		"El &cNether&r es un lugar &cmuy peligroso&r, lagos de lava, ghasts que disparan desde lejos y piglins que te atacan si no llevas algo de oro puesto"
		""
		"&6Lleva pociones de resistencia al fuego&r, bloques para construir puentes y &bcomida de sobra&r"
		""
		"&aLas fortalezas fueron renovadas&r con &aYUNG's Better Nether Fortresses&r, más grandes y con mejor botín"
	]
	quest.1BB971C9FEF18A55.quest_subtitle: "Bienvenido al infierno"
	quest.1BB971C9FEF18A55.title: "El Nether"
	quest.1BD13C058C89748B.quest_desc: [
		"El &aElite Control Circuit&r junta un &aAdvanced&r con &aReinforced Alloy&r"
		""
		"Con él llegas al nivel &belite&r de fábricas, cables y almacenamiento"
	]
	quest.1BD13C058C89748B.quest_subtitle: "Circuito nivel 3"
	quest.1BD13C058C89748B.title: "Elite Control Circuit"
	quest.1C153998001514F9.quest_desc: ["La &btinta épica&r da pergaminos de mucho más nivel. Se prepara en el caldero a partir de la rara"]
	quest.1C153998001514F9.title: "Tinta épica"
	quest.1CC66163637D9D1C.quest_desc: [
		"Para invocar al &9Leviathan&r necesitas el &9Abyssal Sacrifice&r, lo fabricas con &bobjetos del Elder Guardian, El Kraken&r y lo que dejan los &cmobs de la Ciudad Hundida&r"
		""
		"&6Úsalo en el altar de la ciudad&r para invocarlo"
		"{@pagebreak}"
		"&cEs una pelea difícil y bajo el agua&r, ve con tu mejor equipo"
		""
		"&aDerrotarlo desbloquea la fase 5&r"
	]
	quest.1CC66163637D9D1C.quest_subtitle: "Jefe de Cataclysm"
	quest.1CC66163637D9D1C.title: "El sacrificio del abismo"
	quest.1D0C2C7D95DBAA95.quest_desc: [
		"Con el slime puedes fabricar el equipo de &aUsefulSlime&r, &bperfecto para moverte y explorar más cómodo&r"
		""
		"Las &aSlime Boots&r te hacen &brebotar en vez de recibir daño por caída&r, &6agáchate&r si quieres dejar de rebotar"
		""
		"La &aSlime Sling&r &bte lanza por los aires&r, carga el tiro manteniendo clic derecho y suéltalo, &cpruébala con cuidado antes de usarla cerca de un precipicio&r"
	]
	quest.1D0C2C7D95DBAA95.quest_subtitle: "Rebotar es más rápido"
	quest.1D0C2C7D95DBAA95.title: "Equipo de slime"
	quest.1D134E43079B6E40.quest_desc: [
		"Con el hierro ya puedes fabricar el &fPaxel de hierro&r de &aPickle Tweaks&r, &bpico, hacha y pala en una sola herramienta&r"
		""
		"&aDura bastante más que el de piedra y mina más rápido&r, de los mejores primeros usos para tus lingotes"
	]
	quest.1D134E43079B6E40.quest_subtitle: "Una herramienta para todo"
	quest.1D2B9DF959C1DC99.quest_desc: [
		"&aPipez&r mueve &bobjetos, fluidos, energía y gases&r con tuberías, y la &duniversal&r hace todo a la vez"
		""
		"&cUna tubería no extrae por sí sola&r, usa la &6llave&r con &6Shift + clic&r en la punta conectada al inventario para ponerla en modo de extracción"
		""
		"Las &amejoras&r se ponen dentro de la tubería, &baumentan la velocidad&r y dan filtros y control con redstone"
	]
	quest.1D2B9DF959C1DC99.quest_subtitle: "Tuberías sin complicaciones"
	quest.1D2B9DF959C1DC99.title: "Pipez"
	quest.1DF2AA98149024FF.quest_desc: [
		"Para desbloquear el &6Ascenso&r hay que equipar un set completo de equipo &aPoco Común&r y derrotar a un &6Invasor Apótico&r"
		""
		"Es el siguiente paso tras la Frontera: botín mejor, afijos más fuertes y enemigos más duros"
	]
	quest.1DF2AA98149024FF.quest_subtitle: "Más dificultad, más botín"
	quest.1DF2AA98149024FF.title: "World Tier: Ascent"
	quest.1E012433D6EBF58F.quest_desc: [
		"La versión mejorada del paxel de oro, &bse hace igual que la armadura&r, en la mesa de herrería con la plantilla y la placa Gilded"
		""
		"&aGana muchísima durabilidad&r y es de las mejores herramientas de esta fase"
	]
	quest.1E012433D6EBF58F.quest_subtitle: "El paxel reforzado"
	quest.1E04F492D49BF777.quest_desc: ["La &bdormant deepshelf&r se fabrica con deepslate y se convierte en &bdeepshelf&r mediante infusión. Sube la eterna hasta nivel 70"]
	quest.1E04F492D49BF777.quest_subtitle: "Estanterías del subsuelo"
	quest.1E04F492D49BF777.title: "Deepshelf"
	quest.1E0BE013CFC96C58.quest_desc: ["La &farmadura de hierro&r ya protege bastante más que la de cobre, &afabrícala con tus primeros lingotes que ahora puedes minar&r"]
	quest.1E0BE013CFC96C58.quest_subtitle: "Pieza 1 de 4"
	quest.1E6A4E3674A62496.quest_desc: [
		"Con la mezcladora y el quemador listos, &aya puedes hacer latón&r, mezclando &6cobre&r y &7zinc&r con calor en la basin"
		""
		"&bLo vas a necesitar para el ojo que te guía al jefe&r, y de paso abre todas las máquinas de latón de &aCreate&r"
	]
	quest.1E6A4E3674A62496.quest_subtitle: "El metal del ingeniero"
	quest.1E6A4E3674A62496.title: "Latón"
	quest.1E77D49888ED4EB1.quest_desc: [
		"Colócalo contra un cofre y unirá todos los inventarios que lo toquen en una sola red. Con el cable puedes extender el alcance"
		""
		"Todo lo que conectes aparecerá en tus terminales"
	]
	quest.1E77D49888ED4EB1.quest_subtitle: "El corazón de la red"
	quest.1E77D49888ED4EB1.title: "Inventory Connector"
	quest.1E9468B440E35CDB.quest_desc: [
		"La &dair essence&r se prepara en la cámara de imbuición con una gema de Source y objetos como plumas, alas wilden o flechas"
		""
		"La necesitarás para glifos y objetos ligados al viento y al movimiento"
	]
	quest.1E9468B440E35CDB.quest_subtitle: "Ligereza"
	quest.1E9468B440E35CDB.title: "Esencia de aire"
	quest.1EFD2AFBF91A7BB3.quest_desc: ["Se hacen colocando un bloque de carbón junto al goo del nivel correspondiente. Queman 2, 4, 8 y 16 veces más rápido que el carbón normal, y más tiempo"]
	quest.1EFD2AFBF91A7BB3.quest_subtitle: "Más calor"
	quest.1EFD2AFBF91A7BB3.title: "Carbones especiales"
	quest.1F4366C0518F2C69.quest_desc: [
		"El conjunto de &bCaminante de sombras&r potencia los hechizos de &aender&r, la escuela de magia que más rinde con él"
		""
		"Ideal para teletransportarte y moverte con ligereza"
		""
		"Pulsa &2R&r sobre el objeto para ver cómo conseguirlo"
	]
	quest.1F4366C0518F2C69.quest_subtitle: "Pieza 1 de 4"
	quest.1FD03D0877BAD418.quest_desc: [
		"Elimina &c10 esqueletos&r"
		""
		"Cuidado con sus flechas, un &bescudo&r ayuda mucho"
	]
	quest.1FD03D0877BAD418.quest_subtitle: "5 monedas"
	quest.1FD03D0877BAD418.title: "Cazador de esqueletos I"
	quest.1FDF04B8B7E0219B.quest_desc: [
		"El &aacero&r se fabrica en varios pasos con la &bMetallurgic Infuser&r:"
		""
		"Primero conviertes el hierro en &aenriched iron&r, luego lo pasas por la máquina para obtener &asteel dust&r y por último lo fundes en un horno para sacar el &asteel ingot&r"
		""
		"Se necesita un infusionable de &acarbono&r, que sacas del carbón o del carbón vegetal. Cuanta más energía tengas, más rápido va"
	]
	quest.1FDF04B8B7E0219B.quest_subtitle: "El metal de las máquinas"
	quest.1FDF04B8B7E0219B.title: "Cómo hacer acero"
	quest.2039117F0F094A87.quest_desc: [
		"El goo de nivel 1 es la base de &bJust Dire Things&r. Fabrícalo con bola de arcilla, azúcar, tierra y carne podrida y colócalo en el mundo"
		""
		"Actívalo haciendo clic con su ingrediente. Si colocas un bloque válido al lado, tras un tiempo se transforma: un bloque de hierro se convierte en bloque de &bferricore&r en bruto"
		""
		"&eAviso:&r tiene un 10% de probabilidad de desactivarse tras cada transformación, así que vuelve a alimentarlo"
		"{@pagebreak}"
		"{image:undercraft:textures/questpics/jdt/goo_spread.png width:100 height:100 align:center click_action:none:}"
	]
	quest.2039117F0F094A87.quest_subtitle: "El goo que lo cambia todo"
	quest.2039117F0F094A87.title: "Primogel"
	quest.20410EC7C0FD7517.quest_desc: [
		"El conjunto de &bElectromante&r potencia los hechizos de &arayo&r, la escuela de magia que más rinde con él"
		""
		"Pulsa &2R&r sobre el objeto para ver cómo conseguirlo"
	]
	quest.20410EC7C0FD7517.quest_subtitle: "Pieza 3 de 4"
	quest.2072ECDBB6472AE3.quest_desc: [
		"La &bWand of Symmetry&r de &aCreate&r &acopia en espejo todo lo que colocas&r, perfecta para construcciones simétricas"
		""
		"Mientras esté en tu &ebarra rápida&r sigue activa. Pon el espejo con clic derecho en el suelo y cambia su forma con &eShift + clic derecho&r"
		""
		"Mantén &eW&r sobre la varita para ver su tutorial de &aCreate&r"
	]
	quest.2072ECDBB6472AE3.quest_subtitle: "Construye en espejo"
	quest.207A8EFA3DB54B63.quest_desc: ["Los cajones de fluidos guardan líquidos en lugar de objetos. Se mejoran como los demás, aunque la capacidad crece a la mitad de ritmo"]
	quest.207A8EFA3DB54B63.quest_subtitle: "Almacena líquidos"
	quest.207A8EFA3DB54B63.title: "Cajones de fluidos"
	quest.208B30C782332579.quest_desc: [
		"Los &bsigilos&r son focos grabados que convierten tu &dAnima&r en efectos"
		""
		"Se crean en un &barray de alquimia&r con un &breactivo&r de la Tabula Vitae como base y una &bpizarra&r como catalizador"
		""
		"Si te falta Anima, algunos cobran de tu &cvida&r, ten cuidado"
	]
	quest.208B30C782332579.quest_subtitle: "¿Qué son?"
	quest.208B30C782332579.title: "Sigilos"
	quest.20A0549E29212506.quest_desc: [
		"La &btimeworn fabric&r es el &amaterial de rareza poco común&r. Se obtiene desmontando equipo poco común"
		""
		"Es uno de los ingredientes del &bEmerald Totem&r, el invocador de &6Arion&r"
	]
	quest.20A0549E29212506.quest_subtitle: "Material de nivel 2"
	quest.20A0549E29212506.title: "Tela desgastada"
	quest.20CC9B1135A19EEE.quest_desc: [
		"Al derrotar al &9Kraken&r soltará algunos de sus &adientes&r, un &bmaterial muy valioso&r"
		""
		"Los necesitarás para crear el &5ojo del abismo&r y el &9sacrificio del abismo&r"
	]
	quest.20CC9B1135A19EEE.quest_subtitle: "Un material valioso"
	quest.20F42E21ED75997E.quest_desc: [
		"El &bIron Remote&r, el objeto que invoca al jefe, combina dos ramas del pack: una &amecánica&r y otra &dmágica&r"
		""
		"De &bCreate&r necesitarás la &alámina de hierro&r, que se fabrica aplastando un lingote con la &bmechanical press&r. De &bArs Nouveau&r, la &bimbuement chamber&r y su &dgema de Source&r"
		""
		"Sigue las misiones vinculadas de los capítulos de &bCreate&r y &bArs Nouveau&r: cada una te lleva paso a paso hasta lo que pide el invocador. Pulsa &2R&r sobre el Iron Remote para ver su receta completa"
	]
	quest.20F42E21ED75997E.quest_subtitle: "Cómo invocarlo"
	quest.20F42E21ED75997E.title: "El Coloso de Hierro"
	quest.20FBCC009789BF3E.quest_desc: [
		"Cuando una simulación sale bien, la cámara crea una &dPrediction&r del mob"
		""
		"Llévalas al &aLoot Fabricator&r para convertirlas en botín"
	]
	quest.20FBCC009789BF3E.quest_subtitle: "Muertes simuladas"
	quest.20FBCC009789BF3E.title: "Predictions"
	quest.21A486C24FA7062D.quest_desc: [
		"El conjunto de &bElectromante&r potencia los hechizos de &arayo&r, la escuela de magia que más rinde con él"
		""
		"Pulsa &2R&r sobre el objeto para ver cómo conseguirlo"
	]
	quest.21A486C24FA7062D.quest_subtitle: "Pieza 2 de 4"
	quest.21C5DF3011D7BD98.quest_desc: [
		"La &aNature's Compass&r te ayuda a &bencontrar cualquier bioma&r, dale clic derecho, elige el que buscas y la brújula te apuntará al más cercano"
		""
		"&6La búsqueda puede tardar un poco&r si el bioma está lejos, pero te ahorra horas de caminar sin rumbo"
	]
	quest.21C5DF3011D7BD98.quest_subtitle: "Encuentra cualquier bioma"
	quest.21C5DF3011D7BD98.title: "Brújula de la naturaleza"
	quest.21FC429E5174A2D3.quest_desc: [
		"Estas runas modifican una característica concreta del spawner: rango de aparición, control con &aredstone&r, ignorar la &aluz&r, salud inicial, &asilencio&r, mobs &ajóvenes&r o mobs &aardiendo&r"
		""
		"Colócalas con clic derecho. Cada estadística tiene su propio tope, así que prioriza lo que te interese"
	]
	quest.21FC429E5174A2D3.quest_subtitle: "Ajusta tu spawner"
	quest.21FC429E5174A2D3.title: "Runas de estadísticas"
	quest.21FF60D45512F53C.quest_desc: [
		"La &bTabula Rasa&r es una tablilla en blanco, el punto de partida para las &bmesas&r (tabulae) y las &bruna en blanco&r con las que mejorarás tu altar"
		""
		"Se fabrica en el &cAra Vitae&r gastando &cEV&r"
	]
	quest.21FF60D45512F53C.quest_subtitle: "Base de mesas y runas"
	quest.22191CFE5B7977B5.quest_desc: [
		"Los &bMonumentos Oceánicos&r fueron renovados con &aYUNG's Better Ocean Monuments&r, &bmás grandes, con más salas y más peligrosos&r"
		""
		"Adentro te espera el &3Elder Guardian&r, &cmucho más fuerte que en vanilla&r, encuentra el monumento y derrótalo para completar esta misión"
		"{@pagebreak}"
		"Cuidado con la &cfatiga de minería&r que te aplica, mientras estés cerca no podrás romper bloques rápido"
	]
	quest.22191CFE5B7977B5.quest_subtitle: "Un templo renovado"
	quest.22191CFE5B7977B5.title: "El Monumento Oceánico"
	quest.22945A08DC46C550.quest_desc: [
		"La &dfire essence&r se prepara en la cámara de imbuición con una gema de Source y objetos como el mechero, las antorchas o la pólvora"
		""
		"Se usa en los glifos de fuego y explosiones"
	]
	quest.22945A08DC46C550.quest_subtitle: "Llamas"
	quest.22945A08DC46C550.title: "Esencia de fuego"
	quest.230EF2B139D64B2C.quest_desc: [
		"El &aGas-Burning Generator&r quema gases para generar energía, &bmientras mejor el gas, más energía produce&r"
		""
		"El &6etileno&r es de los que más rinden, &cel hidrógeno también sirve, pero sacarlo con el separador electrolítico gasta casi toda la energía que luego te devuelve&r, así que no lo uses como fuente principal"
	]
	quest.230EF2B139D64B2C.quest_subtitle: "Energía a base de gas"
	quest.230EF2B139D64B2C.title: "Gas-Burning Generator"
	quest.2315C2806AC875D6.quest_desc: [
		"El siguiente reto es el &6Goblin Lord&r, el rey de los goblins y &6segundo jefe&r de &aArmageddon&r"
		""
		"Para invocarlo necesitas la &dStrange Coin&r, que se fabrica en el &dEnchanting Apparatus&r de &aArs Nouveau&r, &bpara llegar ahí tendrás que armar tu red de Source&r con sourcelinks, jarras y bloques de gema de source"
		""
		"También vas a necesitar &7Ferricore&r de &aJust Dire Things&r, que sale del &agoo de nivel 1&r"
		"{@pagebreak}"
		"&6Las misiones vinculadas de este capítulo te llevan a cada cosa que pide el invocador&r, y con &bR&r sobre la moneda puedes ver la receta exacta"
	]
	quest.2315C2806AC875D6.quest_subtitle: "Segundo jefe"
	quest.2315C2806AC875D6.title: "El Señor Goblin"
	quest.23C94CAE51E0C9DB.quest_desc: [
		"El &aHeat Generator&r genera energía de dos formas, &bquemando combustible&r como carbón o madera, o &bcon lava a su alrededor&r"
		""
		"&aLa lava que lo rodea le da energía sin gastar nada&r, así que rodearlo de fuentes de lava es una forma simple de tener energía constante"
	]
	quest.23C94CAE51E0C9DB.quest_subtitle: "Calor convertido en energía"
	quest.23C94CAE51E0C9DB.title: "Heat Generator"
	quest.23D8B8958BFD9455.quest_desc: [
		"El conjunto de &bArchievocador&r potencia los hechizos de &aevocación&r, la escuela de magia que más rinde con él"
		""
		"Pulsa &2R&r sobre el objeto para ver cómo conseguirlo"
	]
	quest.23D8B8958BFD9455.quest_subtitle: "Pieza 4 de 4"
	quest.23D9DBF910FE8B4F.quest_desc: ["La &bendshelf&r y la &bpearl endshelf&r se fabrican con aliento infundido y sirven para llegar casi al nivel máximo. La versión con perla añade estadísticas extra"]
	quest.23D9DBF910FE8B4F.quest_subtitle: "Línea de endshelf"
	quest.23D9DBF910FE8B4F.title: "Estanterías del End"
	quest.240707DBDC0B03F8.quest_desc: [
		"El &bferricore&r sale del goo de nivel 1. Rompe el bloque en bruto, funde el material en un horno y obtendrás lingotes"
		""
		"Es algo mejor que el hierro y la base de todas las herramientas del mod"
	]
	quest.240707DBDC0B03F8.quest_subtitle: "El primer metal"
	quest.240707DBDC0B03F8.title: "Ferricore"
	quest.242FBE1D4EAA74A5.quest_desc: [
		"Las &6armas medianas&r se usan &ca dos manos&r y quedan &bentre las ligeras y las pesadas&r, ni muy lentas ni muy débiles"
		""
		"Las de &eoro&r llegan después del &6Goblin Lord&r, &acon más durabilidad que las de hierro&r"
	]
	quest.242FBE1D4EAA74A5.quest_subtitle: "Balance dorado"
	quest.242FBE1D4EAA74A5.title: "Armas medianas de oro"
	quest.2440152D8D5FE69F.quest_desc: ["La linterna se puede &aequipar con la tecla &eB&r, y así te &bilumina automáticamente&r mientras caminas, sin tener que llevar antorchas"]
	quest.2440152D8D5FE69F.quest_subtitle: "Una luz que te acompaña"
	quest.2440152D8D5FE69F.title: "Siempre contigo"
	quest.24607525037B253D.quest_desc: [
		"El &cAncient Battleground&r de &aIron's Spellbooks&r es un campo de batalla abandonado, &clleno de armaduras poseidas y muy poderosas&r"
		""
		"&6Derrotarlas no es fácil&r, pero dejan materiales que vas a necesitar, como &6Cinder Essence&r y &7chatarra de netherite&r"
	]
	quest.24607525037B253D.quest_subtitle: "Las armaduras no están vacías"
	quest.24607525037B253D.title: "Campo de batalla antiguo"
	quest.24637D488002436C.quest_desc: ["La &braven enchanting table&r es la mesa de encantamientos definitiva, la que cierra la línea de estanterías. Pulsa &2R&r para ver su receta completa"]
	quest.24637D488002436C.quest_subtitle: "El final de la línea"
	quest.24637D488002436C.title: "Mesa del cuervo"
	quest.24860D7D143F4018.quest_desc: [
		"El &aWind Generator&r produce energía con el viento, &btanto de día como de noche&r"
		""
		"&aMientras más alto lo pongas, más energía genera&r, en la cima de una montaña rinde muchísimo más que a nivel del suelo"
	]
	quest.24860D7D143F4018.quest_subtitle: "Mientras más alto, mejor"
	quest.24860D7D143F4018.title: "Wind Generator"
	quest.24A493C339146511.quest_desc: [
		"Los &btanques&r de &aSophisticated Storage&r guardan &bfluidos&r"
		""
		"Igual que los cofres y barriles del mod, tienen versiones de &6cobre a netherita&r con más capacidad"
	]
	quest.24A493C339146511.quest_subtitle: "Fluidos bien guardados"
	quest.24AA24846A27C698.title: "Cabeza"
	quest.251D65131068ED29.quest_desc: ["El &beclipse alloy&r sale del goo de nivel 4. Se funde en lingotes y da lugar al mejor equipo de &bJust Dire Things&r, que guarda mucha &cenergía&r"]
	quest.251D65131068ED29.quest_subtitle: "El material final"
	quest.251D65131068ED29.title: "Eclipse Alloy"
	quest.25645362B7746211.quest_desc: [
		"La &aEnrichment Chamber&r de &aMekanism&r es de las primeras máquinas que vas a usar, &bduplica el rendimiento de los minerales&r y fabrica materiales &benriquecidos&r"
		""
		"Ahora la necesitas para el &bdiamante enriquecido&r, ingrediente de la &bBuilder Stone&r"
		""
		"&cRecuerda que funciona con RF&r, conéctala a tu red de energía antes de usarla"
	]
	quest.25645362B7746211.quest_subtitle: "Doble de mineral, mejor material"
	quest.25645362B7746211.title: "Enrichment Chamber"
	quest.258500633A5259B7.quest_desc: ["[ \"Para más información mira los \", { \"text\": \"routers\", \"underlined\": true, \"color\": \"aqua\", \"clickEvent\": { \"action\": \"change_page\", \"value\": \"3F8FE937DDA58F1A\" } } ]"]
	quest.25E5EB9B6088648F.quest_desc: [
		"El conjunto de &bPlagado&r potencia los hechizos de &anaturaleza&r, la escuela de magia que más rinde con él"
		""
		"Pulsa &2R&r sobre el objeto para ver cómo conseguirlo"
	]
	quest.25E5EB9B6088648F.quest_subtitle: "Pieza 4 de 4"
	quest.2623FBBD6CFCB4A8.quest_desc: [
		"El &aBio-Generator&r quema &bBio Fuel&r, un combustible que se hace triturando semillas, plantas y comida en el &bCrusher&r de &aMekanism&r"
		""
		"Si tienes una granja automática, &aes una buena forma de aprovechar lo que sobra&r y convertirlo en energía"
	]
	quest.2623FBBD6CFCB4A8.quest_subtitle: "Energía de la granja"
	quest.2623FBBD6CFCB4A8.title: "Bio-Generator"
	quest.263C721822D390BF.quest_desc: [
		"Con el &6casing de latón&r y el &dcuarzo pulido&r se abren las &6máquinas de latón&r, las más avanzadas de &aCreate&r"
		""
		"&aAutomatizan casi cualquier cosa&r, desde recetas de crafteo hasta mover objetos o imitar a un jugador"
	]
	quest.263C721822D390BF.quest_subtitle: "La era del latón"
	quest.263C721822D390BF.title: "Máquinas de latón"
	quest.265ADF563EADC01E.quest_desc: [
		"La &bsalvaging table&r sirve para &adesmontar equipo y gemas&r y recuperar los materiales con que se hicieron"
		""
		"[\"Es necesario haber conseguido polvo de gema para crearla, si aún no tienes, mira cómo obtenerlo en el capítulo de \", { \"text\": \"Apotheosis\", \"color\": \"gold\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"3032AAA6017E9749\" } }]"
		""
		"Es la principal forma de conseguir los materiales de rareza: hierro viejo, tela, cristales y más. Pon el objeto, rómpelo y recoge el resultado"
	]
	quest.265ADF563EADC01E.quest_subtitle: "Rompe y recupera"
	quest.265ADF563EADC01E.title: "Mesa de recuperación"
	quest.26A7EB5492AA081E.quest_desc: [
		"La &dearth essence&r se prepara en la cámara de imbuición con una gema de Source y objetos como el hierro, cultivos de magebloom, semillas o bloques del suelo"
		""
		"Aparece en glifos y objetos de resistencia y de la naturaleza"
	]
	quest.26A7EB5492AA081E.quest_subtitle: "Cimientos"
	quest.26A7EB5492AA081E.title: "Esencia de tierra"
	quest.26BC13CA12D50087.quest_desc: ["El &7Crushing Hammer&r sirve para &aduplicar tus minerales&r: tritura tus menas y saca más de cada una"]
	quest.26BC13CA12D50087.quest_subtitle: "Más minerales por menos"
	quest.26CA6F51D63A2219.quest_desc: ["La &6armadura Gilded&r, &ase consigue mejorando la armadura de oro&r en la mesa de herrería"]
	quest.26CA6F51D63A2219.title: "Armadura Gilded"
	quest.26EACB737FF15ABE.quest_desc: [
		"Para pasar del tier 0 al &6tier 1&r pon &68 runas&r en un anillo de 3x3 un nivel por debajo del altar, con el centro libre"
		""
		"Solo las cuatro runas del centro dan efecto al altar. Es posible solo usar las runas en blanco, no deben tener efectos para ningun tier"
		""
		"En este altar se fabrica el orbe &bDiscipulus&r, de &625.000 EV&r"
		""
		"{@pagebreak}"
		"{image:undercraft:textures/questpics/neo_vitae/tier_1_altar.png width:100 height:150 align:center click_action:none:}"
	]
	quest.26EACB737FF15ABE.title: "Altar Tier 1"
	quest.27296BEFDC8FB32F.quest_desc: ["La &becho deepshelf&r es una deepshelf mejorada con fragmentos de eco. También llega a nivel 75"]
	quest.27296BEFDC8FB32F.title: "Deepshelf resonante"
	quest.273FACD0FC48E025.quest_desc: [
		"Para desbloquear la &6Frontera&r debes equipar el &aset completo de armadura Gilded&r y derrotar al &6Goblin Lord&r"
		""
		"Una vez desbloqueada, pulsa &2CTRL+T&r para activarla. Sube la calidad del botín, trae mejores afijos y vuelve el mundo más peligroso"
		""
		"&eAviso:&r el logro se completa solo cuando cumples ambos requisitos: tener el set Gilded puesto y haber derrotado al Goblin"
	]
	quest.273FACD0FC48E025.quest_subtitle: "El primer salto"
	quest.273FACD0FC48E025.title: "World Tier: Frontier"
	quest.279F3AFBC7BE768F.quest_desc: [
		"Hay dos formas de &bmover mobs de un lugar a otro&r"
		""
		"El &aCreature Catcher&r de &aJust Dire Things&r se lanza contra el mob para &bcapturarlo&r, y se vuelve a lanzar para soltarlo"
		""
		"La &aJaula&r de &aSupplementaries&r funciona con clic derecho sobre el mob, &cpero solo acepta algunas criaturas&r"
	]
	quest.279F3AFBC7BE768F.quest_subtitle: "Llévate a tus criaturas"
	quest.279F3AFBC7BE768F.title: "Capturar mobs"
	quest.27E0B4A86FC268B1.quest_desc: [
		"Las &aarmas ligeras&r atacan &brapidísimo y a una mano&r, así que puedes &acombinar dos a la vez&r o usarlas con escudo"
		""
		"Con el &eoro&r ya mejorado en este modpack, &aaguantan bastante más que las de hierro&r"
	]
	quest.27E0B4A86FC268B1.quest_subtitle: "Velocidad dorada"
	quest.27E0B4A86FC268B1.title: "Armas ligeras de oro"
	quest.27E80D615B1E17B6.quest_desc: [
		"El &bMagmator&r quema fluidos calientes, como la lava, y produce &cRF&r. Es sencillo de automatizar con un cubo o una tubería"
		""
		""
		"{image:powah:textures/gui/book/images/magmator.png width:150 height:100 align:center}"
	]
	quest.27E80D615B1E17B6.quest_subtitle: "Calor líquido"
	quest.27E80D615B1E17B6.title: "Magmators"
	quest.291B05D45B58788D.quest_desc: [
		"Con el &aAugment de generador&r el horno deja de fundir y pasa a &bquemar combustible para producir RF&r"
		""
		"Es de las &aformas más sencillas de empezar a generar energía&r, perfecta para aprovechar el carbón o la madera que te sobra, &caunque no esperes grandes cantidades&r"
	]
	quest.291B05D45B58788D.quest_subtitle: "El horno que da energía"
	quest.291B05D45B58788D.title: "Aumento de generador"
	quest.292979FB15ED2079.quest_desc: [
		"Así conectarás los nodos para input y output"
		""
		"Clic derecho en el &bmaestro&r para guardarlo y luego en los nodos que estén a menos de &616 bloques&r. Con &bShift&r y clic cortas los enlaces"
	]
	quest.292979FB15ED2079.quest_subtitle: "Herramienta de enlace"
	quest.29510F8CA7621B5E.quest_desc: [
		"El &9Luminous Crystal Shard&r es el &9material de rareza rara&r de &aApotheosis&r"
		""
		"Se consigue &bdesmontando equipo de rareza rara&r en la mesa de recuperación, y lo necesitas para la &bplantilla de diamante&r"
	]
	quest.29510F8CA7621B5E.quest_subtitle: "Material raro"
	quest.29510F8CA7621B5E.title: "Fragmento de cristal luminoso"
	quest.29791A68932CC04F.quest_desc: [
		"El conjunto de &bCriomante&r potencia los hechizos de &ahielo&r, la escuela de magia que más rinde con él"
		""
		"Ideal para congelar y ralentizar enemigos"
		""
		"Pulsa &2R&r sobre el objeto para ver cómo conseguirlo"
	]
	quest.29791A68932CC04F.quest_subtitle: "Pieza 1 de 4"
	quest.298AB4753E9185CA.quest_desc: ["El netherite llega a 132 huecos y 5 ranuras de mejora, el máximo"]
	quest.298AB4753E9185CA.quest_subtitle: "La cima"
	quest.298AB4753E9185CA.title: "Netherite"
	quest.29B3BEAE78E2974D.quest_desc: ["El &biron spell book&r tiene más ranuras que el de cobre. Si no tienes uno mejor, es un buen compañero para empezar"]
	quest.29B3BEAE78E2974D.quest_subtitle: "Un poco más de espacio"
	quest.29B3BEAE78E2974D.title: "Libro de hierro"
	quest.29F1CA3E56364F88.quest_desc: [
		"Aquí puedes craftear tabulas con mucha más velocidad"
		""
		"Toma el EV directamente de la &bcuenca del altar&r al que lo enlazas"
	]
	quest.29F1CA3E56364F88.quest_subtitle: "Crafteo rápido"
	quest.2A1D0F13C353192F.quest_desc: [
		"Para mejorar el altar al tier 3 tendrás que buscar &bTau&r en la mazmorra"
		"{@pagebreak}"
		"El &bweak tau&r tal cual no es muy útil, hay que &aascenderlo&r"
		""
		"{image:undercraft:textures/questpics/neo_vitae/weak_tau.png width:100 height:100 align:center}"
		"{@pagebreak}"
		"La imagen muestra un zombie sobre el tau: el &bweak tau&r absorbe la vida de los mobs cercanos y así asciende a &bstrong tau&r"
		""
		"{image:undercraft:textures/questpics/neo_vitae/strong_tau.png width:100 height:100 align:center}"
	]
	quest.2A1D0F13C353192F.quest_subtitle: "Cultivo de tau"
	quest.2A3649F6CB691F82.quest_desc: ["Un tomo que permite guardar &aexperiencia&r"]
	quest.2A3649F6CB691F82.quest_subtitle: "Experiencia"
	quest.2A421485FBE4A47F.quest_desc: [
		"&bWall-Jump TXF&r te deja trepar y saltar entre paredes, como en un juego de plataformas"
		""
		"Salta hacia una pared y mantén pulsada la tecla para agacharte (&2Shift&r por defecto) para agarrarte. Con ella pulsada, mantén &2W&r y suéltala para saltar desde la pared"
		""
		"También puedes subir por una sola pared y el mod suaviza las caídas cortas, así que explorar acantilados, ruinas y cuevas es mucho más ágil"
		""
		"&eAviso:&r la tecla se puede cambiar en &2Opciones > Controles&r. Y como siempre, las caídas largas siguen doliendo"
	]
	quest.2A421485FBE4A47F.quest_subtitle: "Parkour sin límites"
	quest.2A421485FBE4A47F.title: "Salto de pared"
	quest.2A5E087BC3956EE3.quest_desc: ["La &btinta legendaria&r es la de mayor calidad: con ella fabricas los pergaminos más poderosos"]
	quest.2A5E087BC3956EE3.quest_subtitle: "El máximo nivel"
	quest.2A5E087BC3956EE3.title: "Tinta legendaria"
	quest.2A9C5E61FDA16711.quest_desc: ["El &bice staff&r es el bastón de la escuela de &ahielo&r"]
	quest.2A9C5E61FDA16711.quest_subtitle: "Magia de hielo"
	quest.2A9C5E61FDA16711.title: "Bastón de hielo"
	quest.2BB3883B607970E0.quest_desc: [
		"El &bWireless Terminal&r accede a la red a distancia. Agáchate y haz clic derecho sobre un terminal colocado para vincularlo"
		""
		"Su alcance por defecto es de unos 16 bloques"
	]
	quest.2BB3883B607970E0.quest_subtitle: "Tu almacén en la mano"
	quest.2BB3883B607970E0.title: "Terminal inalámbrico"
	quest.2BC2383433C9B8A5.quest_desc: [
		"El goo de nivel 2 se fabrica a partir del de nivel 1 con polvo de blaze, redstone y verruga del Nether. Hace todo lo que el nivel 1, pero más rápido"
		""
		"Convierte un bloque de oro en bloque de &bblazegold&r en bruto"
	]
	quest.2BC2383433C9B8A5.quest_subtitle: "El goo del Nether"
	quest.2BC2383433C9B8A5.title: "Blazebloom"
	quest.2BFE55184B18C5D8.quest_desc: [
		"La &binfused alloy&r se hace con hierro y redstone en la &bMetallurgic Infuser&r. Es la primera de las aleaciones de &bMekanism&r"
		""
		"Con ella se fabrican los circuitos de control y un montón de máquinas. Más adelante la mejorarás con diamante y obsidiana"
	]
	quest.2BFE55184B18C5D8.quest_subtitle: "La base de las aleaciones"
	quest.2BFE55184B18C5D8.title: "Infused Alloy"
	quest.2C626C3B66F70321.quest_desc: [
		"Para las estanterías de sculk hace falta un &atendón de Warden&r, y para conseguirlo tienes que enfrentarte al &6Warden&r"
		""
		"Es un enemigo muy duro. Ve bien preparado y evita el ruido"
	]
	quest.2C626C3B66F70321.quest_subtitle: "Un jefe para las estanterías"
	quest.2C626C3B66F70321.title: "El Warden"
	quest.2CA83CA064CCEE88.quest_desc: [
		"El &aElectrolytic Separator&r necesita &bagua constante&r, y el fregadero de &aCooking for Blockheads&r da agua infinita"
		""
		"Conéctalo al separador con una &aMechanical Pipe&r o una tubería de fluidos y &ano te volverás a preocupar por el agua&r"
	]
	quest.2CA83CA064CCEE88.quest_subtitle: "Agua para el separador"
	quest.2CA83CA064CCEE88.title: "Agua infinita"
	quest.2CFEC321947AEBD2.quest_desc: [
		"El &6Empty Blaze Burner&r sirve para &bcapturar un blaze&r, dale clic derecho a uno o a su spawner"
		""
		"Aliméntalo con combustible y &ada calor a tus máquinas&r, &6con Blaze Cake llega a su nivel más alto&r"
		""
		"&cLos blazes viven en el Nether&r, así que tendrás que esperar a llegar allá"
	]
	quest.2CFEC321947AEBD2.quest_subtitle: "Calor portátil"
	quest.2CFEC321947AEBD2.title: "Quemador de blaze"
	quest.2D3788AE43F07FF7.quest_desc: [
		"El &6Steam Engine&r se pega a un costado del tanque y &bconvierte el vapor en rotación&r, una de las fuentes de energía más fuertes de &aCreate&r"
		""
		"Ponle un &beje&r para sacar la rotación, y revisa el nivel de la caldera con las &6gafas del ingeniero&r, &ccalor, agua y tamaño tienen que estar balanceados&r"
	]
	quest.2D3788AE43F07FF7.quest_subtitle: "Fuerza a vapor"
	quest.2D41137527D4C775.title: "Amuleto"
	quest.2D736EA983EF2438.quest_desc: [
		"El &aLoot Fabricator&r convierte las &dPredictions&r en &bobjetos reales&r usando &cRF&r"
		""
		"&aEliges qué objeto del botín quieres fabricar&r, así puedes sacar solo lo que necesitas"
	]
	quest.2D736EA983EF2438.quest_subtitle: "Donde nace el botín"
	quest.2D736EA983EF2438.title: "Loot Fabricator"
	quest.2D741CF4D79219B8.quest_desc: [
		"Entrega un &abloque de esmeralda&r y recibe &610 monedas&r en tu cartera"
		""
		"Se puede repetir todas las veces que quieras"
	]
	quest.2D741CF4D79219B8.quest_subtitle: "10 monedas"
	quest.2D741CF4D79219B8.title: "Vender esmeralda"
	quest.2D81E50B01016F22.quest_desc: ["Guarda muchísima &cenergía&r y admite las mejoras más potentes, como el vuelo, en la coraza"]
	quest.2D81E50B01016F22.quest_subtitle: "El final del camino"
	quest.2D81E50B01016F22.title: "Armadura de eclipse"
	quest.2DA87F56102A5BDF.quest_desc: [
		"El conjunto de &bPlagado&r potencia los hechizos de &anaturaleza&r, la escuela de magia que más rinde con él"
		""
		"Pulsa &2R&r sobre el objeto para ver cómo conseguirlo"
	]
	quest.2DA87F56102A5BDF.quest_subtitle: "Pieza 3 de 4"
	quest.2DED40DE11E59D3D.quest_desc: ["El &bDrygmy Charm&r se fabrica en el &bEnchanting Apparatus&r"]
	quest.2DED40DE11E59D3D.quest_subtitle: "Un obrero a tu servicio"
	quest.2DED40DE11E59D3D.title: "Amuleto de drygmy"
	quest.2E83625F61673886.quest_desc: [
		"El &7Millstone&r y las &7Crushing Wheels&r &btrituran objetos&r, desde grava hasta minerales en bruto"
		""
		"&aTriturar minerales te da mineral triturado con chance de extras&r, y lavarlo con el ventilador da pepitas, &6así sacas más lingotes de cada mineral&r"
	]
	quest.2E83625F61673886.quest_subtitle: "Más de cada mineral"
	quest.2E83625F61673886.title: "Triturar"
	quest.2ECE0FD141F3E690.quest_desc: [
		"¿Algo no funciona, se rompió o simplemente no sabes por dónde seguir?"
		""
		"Habla con &eSirPapucho&r por &eDiscord&r. Cuéntale qué hacías, qué esperabas que pasara y, si hay un error, adjunta una captura"
		""
		"Con esos datos será mucho más fácil ayudarte"
	]
	quest.2ECE0FD141F3E690.quest_subtitle: "No estás solo"
	quest.2F1349EF6C493667.quest_desc: ["El &bSigil of Socketing&r permite &aañadir una ranura&r (socket) a un objeto para colocar gemas"]
	quest.2F1349EF6C493667.title: "Sigilo de engaste"
	quest.2F2C2553B74B8BAD.quest_desc: [
		"Aquí hay muchos más &dencantamientos&r que en Minecraft vanilla, y gracias a &bApotheosis&r los niveles pueden superar el máximo vanilla: un Filo V ya no es el techo"
		""
		"Los aldeanos no venden niveles altos, así que tendrás que buscarlos en la exploración, el botín y la mesa de encantamientos"
		""
		"&eCambio importante:&r el &dMending&r ya no se vende en las aldeas. Sigue apareciendo como tesoro de &bApotheosis&r y también puedes fabricarlo en el &bEnchanting Apparatus&r de &bArs Nouveau&r"
	]
	quest.2F2C2553B74B8BAD.quest_subtitle: "Más allá de lo vanilla"
	quest.2F49E459C885DEA9.quest_desc: [
		"La &bRueda hidráulica&r aprovecha la corriente del agua que pasa a su lado, &ala grande gira más lento pero aguanta mucho más estrés&r"
		""
		"Para el viento necesitas un &6Windmill Bearing&r y &bal menos 8 bloques de vela&r, &amientras más velas, más fuerza&r"
		"{@pagebreak}"
		"{image:unaland:textures/questpics/create/water_wheel_example.png width:100 height:100 align:center click_action:none:}"
	]
	quest.2F49E459C885DEA9.quest_subtitle: "Agua y viento"
	quest.2F49E459C885DEA9.title: "Fuerza natural"
	quest.2F58DE69B4B9D3BE.quest_desc: ["El &bimproved scrap tome&r saca &atodos&r los encantamientos del objeto, aunque lo destruye"]
	quest.2F58DE69B4B9D3BE.title: "Tomo de desguace mejorado"
	quest.2F6AF9D520460FA4.quest_desc: ["La &bBlazejet Wand&r te lanza hacia donde miras con un impulso de aire. No sufres daño por caída mientras la tienes en la mano"]
	quest.2F6AF9D520460FA4.quest_subtitle: "Impulso aéreo"
	quest.2F6AF9D520460FA4.title: "Varita Blazejet"
	quest.2F745F39B1819745.quest_desc: [
		"La &aEnergy Upgrade&r &breduce el gasto de energía&r de la máquina y &bagranda su batería interna&r, puedes poner hasta 8"
		""
		"Es la pareja perfecta de la &aSpeed Upgrade&r"
	]
	quest.2F745F39B1819745.quest_subtitle: "Menos consumo"
	quest.2F745F39B1819745.title: "Energy Upgrade"
	quest.2FAFF0E72E3FD805.quest_desc: ["El &bWarp Index&r de &bArs Additions&r da acceso remoto a tus Storage Lecterns, estés donde estés"]
	quest.2FAFF0E72E3FD805.quest_subtitle: "Tu almacén, a distancia"
	quest.2FAFF0E72E3FD805.title: "Warp Index"
	quest.3017AD8AE3F71A72.quest_desc: [
		"Cada ritual tiene su tableta. Hay para cambiar el día y la noche, cultivar, invocar criaturas, proteger o capturar entidades, entre muchos otros"
		""
		"Los addons como &bArs Elemental&r, &bArs Additions&r y &bArs 'n' Spells&r añaden aún más"
		""
		"&eConsejo:&r mira la receta de cada tableta con &2R&r antes de preparar los materiales"
	]
	quest.3017AD8AE3F71A72.quest_subtitle: "Poderes del brasero"
	quest.3017AD8AE3F71A72.title: "Rituales"
	quest.3028A34E0C9260CC.quest_desc: [
		"Los teleport de jugadores tienen 2 partes, &2enviar la solicitud,&r y &baceptar la solicitud&r"
		""
		"Para enviar una solicitud e ir donde algún otro jugador puedes usar &2/tpa (nombre del jugador)&r"
		"Para aceptar una solicitud de otro jugador, debes usar &2/tpaccept&r"
		""
		"Si quieres que algún jugador vaya hacia donde estás tú, puedes usar &2/tpahere (nombre del jugador)&r"
		"El otro jugador deberá usar el &2/tpaccept&r"
		""
		"Así mismo, también es posible aceptar y rechazar las solicitudes directamente desde el chat dándoles click"
	]
	quest.3028A34E0C9260CC.quest_subtitle: "Para visitas o exploración"
	quest.3032AAA6017E9749.quest_desc: [
		"Para conseguir tu primer poco de &bpolvo de gema&r (gem dust) debes &asoltar un yunque sobre gemas&r. Las gemas se destruyen y se convertirán en polvo"
		""
		"Es el material base para mejorar la rareza de otras gemas en la mesa de corte"
	]
	quest.3032AAA6017E9749.quest_subtitle: "Un yunque sobre las gemas"
	quest.3032AAA6017E9749.title: "Polvo de gema"
	quest.304A2C05CD662D76.quest_desc: [
		"Las &carmas pesadas&r de &7netherite&r son &blas más fuertes de su tipo&r, lentas y a dos manos, &apero con golpes que arrasan&r"
		""
		"&6Ideales contra jefes grandes&r, siempre que sepas cuándo atacar"
	]
	quest.304A2C05CD662D76.quest_subtitle: "Lo mejor de lo brutal"
	quest.304A2C05CD662D76.title: "Armas pesadas de netherite"
	quest.30825AAC2DA3947C.quest_desc: ["El hierro llega a 54 huecos y 2 ranuras de mejoras. Existen mejoras que saltan niveles, como de básico a hierro"]
	quest.30825AAC2DA3947C.quest_subtitle: "Más espacio, más mejoras"
	quest.30825AAC2DA3947C.title: "Hierro"
	quest.30C83B54A2FC027F.quest_desc: [
		"&bArs Additions&r añade amuletos que se llevan equipados como curios: resistencia al fuego, protección contra el void, respiración bajo el agua, visión nocturna, caída suave y otros"
		""
		"Tienen cargas limitadas. Cuando se agotan, se recargan en la &bImbuement Chamber&r"
	]
	quest.30C83B54A2FC027F.quest_subtitle: "Pequeños seguros"
	quest.30C83B54A2FC027F.title: "Amuletos de Ars Additions"
	quest.30F1BCD3C5DE1B2A.quest_desc: [
		"&aChipped&r añade mesas que convierten un bloque normal en &bdecenas de variantes decorativas&r"
		""
		"Cada mesa tiene su especialidad, la &7mesa de albañil&r para piedra y ladrillos, la del &6carpintero&r para madera, la del &bsoplador de vidrio&r para cristal, el &dtelar&r para lana y alfombras, y el &5banco de alquimia&r y el &ataller del botánico&r para bloques de luz y plantas"
		""
		"Solo mete el bloque y &aelige la variante que más te guste&r"
	]
	quest.30F1BCD3C5DE1B2A.quest_subtitle: "Decoración a otro nivel"
	quest.30F1BCD3C5DE1B2A.title: "Mesas de Chipped"
	quest.310468EC0992F751.quest_desc: ["La gema de espíritu más grande, con &616.384&r de capacidad"]
	quest.310468EC0992F751.quest_subtitle: "Gema 5 de 5"
	quest.3143D5DEB6FF4FBA.quest_desc: ["El &bStabilized Warp Index&r es la versión mejorada y añade acceso entre dimensiones"]
	quest.3143D5DEB6FF4FBA.quest_subtitle: "Sin fronteras"
	quest.3143D5DEB6FF4FBA.title: "Warp Index estabilizado"
	quest.31DA9E65E2EF0DAA.quest_desc: ["El &bcontrolador&r une los almacenes que lo rodean en un solo multibloque, hasta 15 bloques de distancia. Clic derecho inserta lo que llevas y doble clic deposita todo lo igual"]
	quest.31DA9E65E2EF0DAA.quest_subtitle: "Una red de almacenes"
	quest.31DA9E65E2EF0DAA.title: "Controlador"
	quest.3277B64A6DBAFA0F.quest_desc: [
		"El conjunto de &bPiromante&r potencia los hechizos de &afuego&r, la escuela de magia que más rinde con él"
		""
		"Pulsa &2R&r sobre el objeto para ver cómo conseguirlo"
	]
	quest.3277B64A6DBAFA0F.quest_subtitle: "Pieza 4 de 4"
	quest.3297F9F51DE14560.quest_desc: ["La &bBasic Tier Upgrade&r convierte un cofre o barril vanilla en su versión sofisticada, y abre las mejoras de nivel y la ranura de mejoras"]
	quest.3297F9F51DE14560.quest_subtitle: "El primer paso"
	quest.3297F9F51DE14560.title: "Mejora básica"
	quest.32E97633B583F970.quest_desc: ["La &bgodforged pearl&r es el &amaterial de rareza mítica&r, el más difícil de conseguir"]
	quest.32E97633B583F970.quest_subtitle: "Material de nivel 5"
	quest.32E97633B583F970.title: "Perla forjada por dioses"
	quest.32F334B4CFF5C7D6.quest_desc: [
		"El siguiente jefe es el &9Leviathan&r de &aCataclysm&r, &cuna criatura gigante que vive en la Ciudad Hundida&r, en lo más profundo del océano"
		""
		"Entre sus ataques tiene mordidas, &cgolpes con sus tentáculos&r y un &5rayo del abismo&r, &cy bajo el agua es muy rápido&r"
		"{@pagebreak}"
		"&aCompletar esta misión te da acceso a la Ciudad Hundida&r, &bantes no podías entrar&r"
	]
	quest.32F334B4CFF5C7D6.quest_subtitle: "El terror del abismo"
	quest.32F334B4CFF5C7D6.title: "El Leviathan"
	quest.330B4E19E1E10ED5.quest_desc: ["Define cómo entra y sale lo almacenado: &aentrada&r (solo inserta), &asalida&r (solo extrae) o &aambos&r"]
	quest.330B4E19E1E10ED5.quest_subtitle: "Entrada y salida"
	quest.330B4E19E1E10ED5.title: "Storage I/O"
	quest.331334B067BCA4DE.quest_desc: ["La armadura de &bcelestigem&r funciona con &cRF&r en lugar de durabilidad: cárgala, por ejemplo, con el &bPocket Generator&r"]
	quest.331334B067BCA4DE.quest_subtitle: "Energía en lugar de durabilidad"
	quest.331334B067BCA4DE.title: "Armadura de celestigem"
	quest.339BC37E6E2DA5AB.quest_desc: [
		"Elimina &c10 arañas&r"
		""
		"De día son tranquilas, pero &cde noche atacan&r"
	]
	quest.339BC37E6E2DA5AB.quest_subtitle: "5 monedas"
	quest.339BC37E6E2DA5AB.title: "Cazador de arañas I"
	quest.33B9CAC32E1DE119.quest_desc: ["Elimina &c10 blazes&r"]
	quest.33B9CAC32E1DE119.quest_subtitle: "10 monedas"
	quest.33B9CAC32E1DE119.title: "Cazador de blazes II"
	quest.33D32A7F6948ECC4.quest_desc: ["El &apaxel&r combina pico, hacha y pala. Se fabrica en la mesa de herrería a partir del pico, el hacha y la pala de celestigem"]
	quest.33D32A7F6948ECC4.quest_subtitle: "Tres herramientas en una"
	quest.33D32A7F6948ECC4.title: "Paxel de celestigem"
	quest.33E8249EC27D254A.quest_desc: ["Clic izquierdo dispara un portal azul y clic derecho uno naranja. Jugadores y objetos pasan de uno a otro"]
	quest.33E8249EC27D254A.quest_subtitle: "Con una pistola de portales"
	quest.33E8249EC27D254A.title: "Portal Gun"
	quest.34267895005807F6.quest_desc: [
		"El conjunto de &bCaminante de sombras&r potencia los hechizos de &aender&r, la escuela de magia que más rinde con él"
		""
		"Pulsa &2R&r sobre el objeto para ver cómo conseguirlo"
	]
	quest.34267895005807F6.quest_subtitle: "Pieza 4 de 4"
	quest.3427948161FC39CF.quest_desc: ["Colocado sobre un almacén y enlazado al controlador con la herramienta, conecta ese almacén y todos los que lo tocan"]
	quest.3427948161FC39CF.quest_subtitle: "Almacenes lejanos"
	quest.3427948161FC39CF.title: "Storage Link"
	quest.348E4A87BDCC12D9.quest_desc: [
		"Paga &6120 monedas&r y recibe &bun material de rareza al azar&r de &aApotheosis&r, desde chatarra misteriosa hasta la rarísima &dperla forjada por dioses&r"
		""
		"Se puede comprar de nuevo &7cada 30 minutos&r"
	]
	quest.348E4A87BDCC12D9.quest_subtitle: "Materiales de rareza"
	quest.348E4A87BDCC12D9.title: "Materiales de Apotheosis"
	quest.34F5092E767F18BA.quest_desc: [
		"Un reino de goblins se esconde detrás de esta moneda, &cy su señor no va a entregar su tesoro sin pelear&r"
		""
		"Es el &6Goblin Lord&r, segundo jefe de &aArmageddon&r, consigue la &dStrange Coin&r, invócalo y derrótalo, &bve con tu set de hierro completo y bastante comida&r"
		"{@pagebreak}"
		"Al vencerlo recibirás un logro de &aArmageddon&r y &aya podrás picar oro&r y fabricar su equipo"
		""
		"Además el goblin deja materiales para &6mejorar el oro&r en la mesa de herrería, &bel primer paso hacia el nivel de mundo Frontera&r"
	]
	quest.34F5092E767F18BA.quest_subtitle: "Segundo jefe"
	quest.34F5092E767F18BA.title: "El goblin de oro"
	quest.35157C5DEA2CDBE5.quest_desc: [
		"El conjunto de &bPiromante&r potencia los hechizos de &afuego&r, la escuela de magia que más rinde con él"
		""
		"Pulsa &2R&r sobre el objeto para ver cómo conseguirlo"
	]
	quest.35157C5DEA2CDBE5.quest_subtitle: "Pieza 3 de 4"
	quest.35635AA0071328DC.quest_desc: [
		"La &7chatarra de netherite&r se consigue fundiendo &7escombros ancestrales&r del Nether, &bo derrotando a las armaduras&r del campo de batalla antiguo"
		""
		"&aLa necesitas para el ojo del jefe&r"
	]
	quest.35635AA0071328DC.quest_subtitle: "Fragmentos del infierno"
	quest.35E90E7D71536DE9.quest_desc: [
		"Elimina &c100 esqueletos&r"
		""
		"&aSe puede repetir&r: cada vez que la completes ganas &650 monedas&r más, así que es una buena forma de &afarmear dinero&r"
	]
	quest.35E90E7D71536DE9.quest_subtitle: "50 monedas"
	quest.35E90E7D71536DE9.title: "Cazador de esqueletos IV"
	quest.363472B5EC42256E.quest_desc: [
		"Elimina &c50 zombis&r"
		""
		"Una zona oscura cerca de tu base o una &agranja de mobs&r te ahorra mucho tiempo"
	]
	quest.363472B5EC42256E.quest_subtitle: "25 monedas"
	quest.363472B5EC42256E.title: "Cazador de zombis III"
	quest.3647A5EA3096E947.quest_desc: [
		"El &6Arado&r ara la tierra, el &6Cosechador&r recoge cultivos, el &6Taladro&r rompe bloques, la &6Sierra&r corta árboles y procesa madera, el &6Deployer&r imita a un jugador y el &6Rodillo&r pavimenta caminos"
		""
		"&aMontadas en artefactos móviles&r, como pistones mecánicos o rodamientos, &bpueden trabajar áreas enteras por su cuenta&r"
	]
	quest.3647A5EA3096E947.quest_subtitle: "Arar, cosechar, minar y cortar"
	quest.3647A5EA3096E947.title: "Máquinas básicas"
	quest.3694FB83743B9BBE.quest_desc: [
		"Con el ritual &cHighway to Hell&r se abre una puerta permanente a la &bendless dungeon&r, una mazmorra procedural donde se encuentra el &bdemonita&r"
		""
		"Con él se hacen los &blingotes de hellforged&r y sus bloques"
	]
	quest.3694FB83743B9BBE.quest_subtitle: "Endless Dungeon"
	quest.3697E377987B0431.quest_desc: [
		"Con el &7Andesite Casing&r se abren las &7máquinas de andesita&r, la base de &aCreate&r"
		""
		"&aProcesan, cortan, minan y mueven objetos&r, revisa cada misión de esta rama para ver lo que hace cada una"
	]
	quest.3697E377987B0431.quest_subtitle: "Las primeras máquinas"
	quest.3697E377987B0431.title: "Máquinas de andesita"
	quest.369C6667C34F1EE6.quest_desc: [
		"La &aEnrichment Chamber&r convierte un mineral en &bdos de polvo&r, así que &acada mineral te da el doble de lingotes&r"
		""
		"También fabrica los &dmateriales enriquecidos&r que piden las aleaciones y los circuitos, y funciona con &cRF&r"
	]
	quest.369C6667C34F1EE6.quest_subtitle: "Tu primera duplicación"
	quest.369C6667C34F1EE6.title: "Enrichment Chamber"
	quest.36D4161FBA4269B2.quest_desc: [
		"La &6Tienda&r funciona con las monedas de &aMagic Coins&r, que se guardan en tu &bcartera&r, un saldo propio de cada jugador"
		""
		"Las monedas físicas que encuentres se pueden &adepositar en la cartera&r desde los botones del inventario, y también se &bganan vendiendo recursos&r en la parte de arriba de este capítulo"
		""
		"Para &acomprar&r, haz clic en la tarea de precio de la quest, el pago &bse descuenta directo de tu cartera&r, y después reclama la recompensa, &csi no te alcanza no se cobra nada&r"
		""
		"&eLa tienda se expandirá en el futuro, y los precios pueden cambiar&r"
	]
	quest.36D4161FBA4269B2.quest_subtitle: "Monedas a cambio de recursos"
	quest.36D4161FBA4269B2.title: "Tienda"
	quest.384ABE0A08E5FF94.title: "Pies"
	quest.38A5446FE8570E69.quest_desc: [
		"Paga &610 monedas&r y recibe &bun plato al azar&r de &aFarmer's Delight&r y sus addons, pensado para cuando la comida escasea al inicio"
		""
		"Salen sobre todo sándwiches y guisos, y de vez en cuando algo raro como la &6Calabaza rellena&r"
		""
		"Se puede comprar de nuevo &7sin espera&r"
	]
	quest.38A5446FE8570E69.quest_subtitle: "Un plato al azar"
	quest.38A5446FE8570E69.title: "Comida"
	quest.38D781FB8D3287C6.quest_desc: ["La &bsoul-touched sculkshelf&r llega a nivel 80 y usa drops del Warden"]
	quest.38D781FB8D3287C6.title: "Sculkshelf del alma"
	quest.38E1CB94A07A6CC5.quest_desc: [
		"El &bPlayer Transmitter&r carga los objetos del jugador vinculado: inventario, armadura y mano secundaria"
		""
		"Con una tarjeta de enlace funciona en la misma dimensión, y con la dimensional entre dimensiones. Vincúlala a ti con clic derecho &eantes&r de ponerla en el transmisor"
		""
		"{image:powah:textures/gui/book/images/player_transmitter.png width:150 height:100 align:center click_action:none:}"
	]
	quest.38E1CB94A07A6CC5.quest_subtitle: "Energía en tu inventario"
	quest.38E1CB94A07A6CC5.title: "Player Transmitter"
	quest.39B03A4AF6B7C1EC.quest_desc: [
		"Ahora que entraste al Nether puedes &acapturar un blaze&r con el &6Empty Blaze Burner&r, dale clic derecho a un blaze o a su spawner"
		""
		"Aliméntalo con combustible y &ada calor a tus máquinas de Create&r, &6con Blaze Cake llega a su nivel más alto&r"
		""
		"&bLo vas a necesitar para fabricar latón&r"
	]
	quest.39B03A4AF6B7C1EC.quest_subtitle: "Calor portátil"
	quest.39B03A4AF6B7C1EC.title: "Quemador de blaze"
	quest.39B630E1DA74B52B.quest_desc: [
		"El área de ejemplo es un &a5x5 de Dreadful Dirt&r, &btapada&r para evitar que desaparezca"
		""
		"{image:undercraft:textures/questpics/grinding_utils/mob_farm_setup_step_1.png width:200 height:200 align:center click_action:none:}"
		"{@pagebreak}"
		"Después hacemos un &bperímetro con Tinted Glass&r para poder ver dentro sin que entre la luz"
		""
		"{image:undercraft:textures/questpics/grinding_utils/mob_farm_setup_step_2.png width:200 height:200 align:center click_action:none:}"
	]
	quest.39B630E1DA74B52B.quest_subtitle: "Donde nacerán los mobs"
	quest.39B630E1DA74B52B.title: "El área de aparición"
	quest.39BA5FB7E6BCDA09.quest_desc: [
		"Se cosecha de las yemas del bloque ya maduras. Se usa para el fluido del tiempo, para la mejora Insta-Break y para otras mejoras avanzadas"
		""
		"Con 9 cristales fabricas un bloque"
	]
	quest.39BA5FB7E6BCDA09.quest_subtitle: "El recurso más lento"
	quest.39BA5FB7E6BCDA09.title: "Cristal del tiempo"
	quest.39C4C46224DFD669.quest_desc: [
		"La &aExplorer's Compass&r te ayuda a &bencontrar estructuras&r, dale clic derecho, elige la que buscas y te apuntará a la más cercana"
		""
		"&6Úsala para encontrar el Monumento Oceánico&r, el siguiente paso de tu aventura"
		""
		"&cLa búsqueda puede tardar un poco&r si la estructura está lejos"
	]
	quest.39C4C46224DFD669.quest_subtitle: "Encuentra cualquier estructura"
	quest.3A6C7C7055AE0216.title: "Espalda"
	quest.3A6E400174E9C39C.quest_desc: ["Se fabrica directamente con lingotes de ferricore. Un poco mejor que el hierro, y base de las armaduras superiores"]
	quest.3A6E400174E9C39C.quest_subtitle: "Algo mejor que el hierro"
	quest.3A6E400174E9C39C.title: "Armadura de ferricore"
	quest.3A8644908B0EF29D.quest_desc: [
		"El goo de nivel 3 se fabrica con el de nivel 2, perla de ender, piedra del End y aliento de dragón"
		""
		"Convierte un bloque de diamante en bloque de &bcelestigem&r en bruto"
	]
	quest.3A8644908B0EF29D.quest_subtitle: "El goo del End"
	quest.3A8644908B0EF29D.title: "VoidShimmer"
	quest.3A8FF67D3D97B9D8.quest_desc: [
		"La &bcelestigem&r sale del goo de nivel 3 y se obtiene directamente como gema, sin necesidad de fundirla"
		""
		"Su equipo funciona con &cRF&r en lugar de durabilidad"
	]
	quest.3A8FF67D3D97B9D8.quest_subtitle: "Gema del End"
	quest.3A8FF67D3D97B9D8.title: "Celestigem"
	quest.3AAAAA144E43C14C.quest_desc: [
		"El conjunto de &bCriomante&r potencia los hechizos de &ahielo&r, la escuela de magia que más rinde con él"
		""
		"Pulsa &2R&r sobre el objeto para ver cómo conseguirlo"
	]
	quest.3AAAAA144E43C14C.quest_subtitle: "Pieza 4 de 4"
	quest.3ABA4FB655F74CC7.quest_desc: [
		"El conjunto de &bSacerdote&r potencia los hechizos de &asagrada&r, la escuela de magia que más rinde con él"
		""
		"Ideal para curar y proteger a ti y a tus aliados"
		""
		"Pulsa &2R&r sobre el objeto para ver cómo conseguirlo"
	]
	quest.3ABA4FB655F74CC7.quest_subtitle: "Pieza 1 de 4"
	quest.3B1ADBB1B92AEAD6.quest_desc: ["Mejora de las herramientas de ferricore. Más fuertes y con reparación en lava. El arco tiene 2 ranuras de poción"]
	quest.3B1ADBB1B92AEAD6.quest_subtitle: "Más resistencia"
	quest.3B1ADBB1B92AEAD6.title: "Herramientas de blazegold"
	quest.3B93213ECB331D52.quest_desc: [
		"Aquí llegarán ofertas de &amateriales de Create&r"
		""
		"&7Todavía no está disponible&r"
	]
	quest.3B93213ECB331D52.quest_subtitle: "Próximamente"
	quest.3B93213ECB331D52.title: "Materiales: Create"
	quest.3B943F7C432A270D.quest_desc: [
		"El henge del drygmy genera objetos y gemas de experiencia a partir de las criaturas que tiene cerca, sin hacerles daño. Las jarras de contención cuentan, y cada tipo distinto de criatura aumenta su felicidad"
		""
		"Pon un cofre y una &dSource Jar&r junto al henge: el cofre recibe lo que produce y la jarra paga el coste de cada ciclo"
		""
		"&eConsejo:&r haz &2Shift + clic&r con la &bDominion Wand&r sobre el henge para que use solo las criaturas enjauladas"
		"{@pagebreak}"
		"{image:undercraft:textures/questpics/ars/drygmy_farm_example.png width:180 height:80 align:center click_action:none:}"
	]
	quest.3B943F7C432A270D.quest_subtitle: "Producción sin fin"
	quest.3B943F7C432A270D.title: "La granja de drygmies"
	quest.3C2E92F8F469626F.quest_desc: ["Los &bcables de inventario&r conectan contenedores lejanos con el conector. Hay una versión enmarcada para disimularlos"]
	quest.3C2E92F8F469626F.quest_subtitle: "Para unir lo lejano"
	quest.3C2E92F8F469626F.title: "Cables de inventario"
	quest.3C77650A1737CEF6.quest_desc: [
		"Los sigilos activos se encienden con &bShift + clic derecho&r al aire y consumen &cEV&r cada cierto tiempo hasta que los apagas"
		""
		"&bMagnetismo&r: &650 EV&r cada 5 s, recoge objetos a &67 bloques&r"
		"&bMinero veloz&r: &6100 EV&r cada 5 s, te da &aprisa&r"
		"&bBosque verde&r: &6150 EV&r de crecimiento o un aura de &67x7x5&r bloques"
		"{@pagebreak}"
		"&bLago helado&r: congela el agua en &62 bloques&r a tu alrededor"
		"&bSupresión&r: quita fluidos en unos &66 bloques&r"
		"&bPuente fantasma&r: crea plataformas temporales mientras caminas"
		""
		"Si te quedas sin Anima, se apagan solos hasta que la recargues"
	]
	quest.3C77650A1737CEF6.quest_subtitle: "Consumen mientras están activos"
	quest.3C824B17FCD3E54E.quest_desc: [
		"La &aMuffling Upgrade&r &bbaja el ruido&r de la máquina, con 4 queda en silencio total"
		""
		"No cambia nada más, pero &atus oídos lo van a agradecer&r cuando tengas una sala llena de máquinas"
	]
	quest.3C824B17FCD3E54E.quest_subtitle: "Silencio en la base"
	quest.3C824B17FCD3E54E.title: "Muffling Upgrade"
	quest.3C9FC617C2486427.quest_desc: ["El &bscrap tome&r saca &aaproximadamente la mitad&r de los encantamientos de un objeto, pero destruye el objeto en el proceso"]
	quest.3C9FC617C2486427.title: "Tomo de desguace"
	quest.3CB90E97B7D76217.quest_desc: [
		"La &btimeworn fabric&r es el &amaterial de rareza poco común&r. Se obtiene desmontando equipo poco común"
		""
		"Es uno de los ingredientes del &bEmerald Totem&r, el invocador de &6Arion&r"
	]
	quest.3CB90E97B7D76217.quest_subtitle: "Material de nivel 2"
	quest.3CB90E97B7D76217.title: "Tela desgastada"
	quest.3CC9743B6203C6EC.quest_desc: [
		"El &aAtomic Disassembler&r es &bpico, hacha, pala y espada a la vez&r, y funciona con &cRF&r en lugar de durabilidad"
		""
		"Tiene &dvarios modos&r que cambian la velocidad de minado y el gasto de energía, &6revisa la tecla de cambio de modo en Opciones > Controles&r"
		""
		"&cNo se puede encantar&r"
	]
	quest.3CC9743B6203C6EC.quest_subtitle: "Una herramienta para todo"
	quest.3CC9743B6203C6EC.title: "Atomic Disassembler"
	quest.3CDD38E5375109EA.quest_desc: [
		"Busca el &bbarco del Kraken&r con la &aExplorer's Compass&r y entra a explorarlo"
		""
		"Parece bastante tranquilo, pero algo acecha desde &5las profundidades&r..."
	]
	quest.3CDD38E5375109EA.quest_subtitle: "Algo acecha en el barco"
	quest.3CDD38E5375109EA.title: "El Kraken"
	quest.3CDEBC8829F842C3.quest_desc: [
		"El &aacero&r se fabrica en varios pasos con la &bMetallurgic Infuser&r:"
		""
		"Primero conviertes el hierro en &aenriched iron&r, luego lo pasas por la máquina para obtener &asteel dust&r y por último lo fundes en un horno para sacar el &asteel ingot&r"
		""
		"Se necesita un infusionable de &acarbono&r, que sacas del carbón o del carbón vegetal. Cuanta más energía tengas, más rápido va"
	]
	quest.3CDEBC8829F842C3.quest_subtitle: "El metal de las máquinas"
	quest.3CDEBC8829F842C3.title: "Cómo hacer acero"
	quest.3D2D6370EC0EDFFC.quest_desc: [
		"La &bmysterious scrap metal&r es el &amaterial de rareza común&r. Se obtiene desmontando equipo común en la &bSalvaging table&r"
		""
		"También se usa para fabricar tinta común en el &bcaldero de Iron's Spellbooks&r"
	]
	quest.3D2D6370EC0EDFFC.quest_subtitle: "Material de nivel 1"
	quest.3D2D6370EC0EDFFC.title: "Chatarra misteriosa"
	quest.3D3FC143C037BD30.quest_desc: ["El &ePaxel de oro&r de &aPickle Tweaks&r llega con esta fase, y &aaguanta bastante más que el de hierro&r"]
	quest.3D3FC143C037BD30.quest_subtitle: "Un paxel más duro"
	quest.3D410A453E2EFE05.quest_desc: [
		"La &bfiltering shelf&r quita encantamientos que no te interesan de la reserva de la mesa. Lo configuras con libros de un solo encantamiento"
		""
		"Perfecta para buscar un encantamiento concreto"
	]
	quest.3D410A453E2EFE05.quest_subtitle: "Elimina lo que no quieres"
	quest.3D410A453E2EFE05.title: "Estantería de filtrado"
	quest.3DAA73E468B3964C.quest_desc: [
		"Casi todo en &bPowah&r tiene siete niveles: Starter, Basic, Hardened, Blazing, Niotic, Spirited y Nitro. Cuanto más alto, más producción, capacidad y velocidad"
		""
		"Sube de nivel a medida que progresas"
	]
	quest.3DAA73E468B3964C.quest_subtitle: "Siete niveles"
	quest.3DDF15A64E2BA01A.quest_desc: [
		"Tu &dred de sangre&r, de aquí salen los costes de sigilos, rituales y muchos crafteos"
		""
		"Con &bclic derecho&r le das de tu propia sangre. Cerca de un &cAra Vitae&r va directo al altar, y lejos se guarda en el orbe"
		""
		"También puedes llevarlo en la &bmano secundaria&r al matar mobs: cada uno da &c10 EV&r por punto de vida máxima"
		"{@pagebreak}"
		"&cEV&r (Essentia Vitae) es la sangre que tiene el altar, y tu &dAnima&r es la que llevas contigo. Pon el orbe en el altar y pasará su EV a tu Anima"
		""
		"Este orbe aguanta &65.000 EV&r, los siguientes se fabrican en altares de más tier"
	]
	quest.3DDF15A64E2BA01A.quest_subtitle: "Orbe de Novicius"
	quest.3E03EB5D27971235.quest_desc: ["Una vez enlazado a un controlador, actúa como él. Útil para tener un punto de acceso en otra parte de la base"]
	quest.3E03EB5D27971235.quest_subtitle: "Un acceso extra"
	quest.3E03EB5D27971235.title: "Controller Extension"
	quest.3E4D4EBDD12EE558.quest_desc: [
		"&aEn la forja&r vive la &4Netherite Monstrosity&r, &cun jefe enorme con muchos ataques distintos&r"
		""
		"&cEs una pelea difícil&r, ve con tu mejor equipo, &6resistencia al fuego&r y suficiente comida"
		""
		"&aDerrotarla te abre paso a la siguiente fase&r, las &9Profundidades&r"
	]
	quest.3E4D4EBDD12EE558.quest_subtitle: "Jefe de Cataclysm"
	quest.3E4D4EBDD12EE558.title: "La forja del monstruo"
	quest.3E5BCD99651B6F24.quest_desc: [
		"El paxel, de &bPickle Tweaks&r, reúne en una sola herramienta el pico, el hacha y la pala"
		""
		"Menos objetos que cargar y menos cambios en la barra rápida. Empieza con uno de piedra; hay paxeles de cada material, así que tu herramienta crecerá contigo"
	]
	quest.3E5BCD99651B6F24.quest_subtitle: "Pico, hacha y pala en una"
	quest.3E5BCD99651B6F24.title: "Herramienta todo en uno"
	quest.3E7A853FE40434DD.quest_desc: [
		"Paga &6120 monedas&r y recibe &buna batería de Powah al azar&r, mientras mejor la batería, más rara"
		""
		"Se puede comprar de nuevo &7cada hora&r"
	]
	quest.3E7A853FE40434DD.quest_subtitle: "Una batería al azar"
	quest.3E7A853FE40434DD.title: "Baterías con energía"
	quest.3EA929541922AF5A.quest_desc: [
		"El conjunto de &bPiromante&r potencia los hechizos de &afuego&r, la escuela de magia que más rinde con él"
		""
		"Ideal si lanzas bolas de fuego y quemas enemigos"
		""
		"Pulsa &2R&r sobre el objeto para ver cómo conseguirlo"
	]
	quest.3EA929541922AF5A.quest_subtitle: "Pieza 1 de 4"
	quest.3EB275B7877CCE6E.quest_desc: ["El &bfrozen bone&r es el foco de la escuela de &ahielo&r"]
	quest.3EB275B7877CCE6E.quest_subtitle: "Foco de hielo"
	quest.3EB275B7877CCE6E.title: "Hueso congelado"
	quest.3F4E4642DDF41135.quest_desc: [
		"Las &desencias&r son la base de casi todo el equipo mágico de &bArs Nouveau&r. Cada una se prepara en la &bimbuement chamber&r con una &dgema de Source&r y un objeto que le da su carácter"
		""
		"Hay una por cada elemento y por cada tipo de magia: &afuego&r, &aagua&r, &atierra&r, &aaire&r, &amanipulación&r, &aabjuración&r y &aconjuración&r. Más abajo ves cómo se hace cada una"
		"{@pagebreak}"
		"{image:undercraft:textures/questpics/ars/essence_crafting.png width:175 height:100 align:center click_action:none:}"
	]
	quest.3F4E4642DDF41135.quest_subtitle: "Magia en estado puro"
	quest.3F4E4642DDF41135.title: "Crear esencias"
	quest.3F8FE937DDA58F1A.quest_desc: [
		"El cerebro de la red, sin él nada se comunica"
		""
		"Solo puede haber &buno por red&r. Tiene dos ranuras de mejora: &bStack&r (hasta 64) aumenta lo que mueve cada operación, y &bSpeed&r (hasta 19) la hace más frecuente"
		"{@pagebreak}"
		"Sin mejoras mueve &616 objetos&r, &61.000 mB&r de fluido o &610.000 FE&r cada &620 ticks&r"
	]
	quest.3F8FE937DDA58F1A.quest_subtitle: "Nodo maestro"
	quest.3FA268DC92EEBBF2.quest_desc: [
		"Las &6armas medianas&r de &7netherite&r son &blas mejores de su tipo&r, a dos manos y con el mejor balance entre daño y velocidad"
		""
		"&aUna opción segura para casi cualquier jefe&r"
	]
	quest.3FA268DC92EEBBF2.quest_subtitle: "Lo mejor del balance"
	quest.3FA268DC92EEBBF2.title: "Armas medianas de netherite"
	quest.3FB8F32E71824E52.quest_desc: [
		"Tu primer equipo de verdad será de &ecobre&r"
		""
		"Busca cobre bajo tierra, recoge el mineral en bruto y fúndelo en un horno para obtener lingotes"
		""
		"Con ellos fabricarás armadura y mejoras. Guarda todo el que puedas: lo vas a necesitar"
	]
	quest.3FB8F32E71824E52.quest_subtitle: "El camino del cobre"
	quest.3FB8F32E71824E52.title: "Primer equipamiento"
	quest.3FCBBFC8F9878BB0.quest_desc: [
		"El &bReactor&r de Powah es un multibloque que produce mucha &cenergía&r. Su combustible principal es la &auraninita&r"
		""
		"Se monta colocando los bloques del reactor en una zona libre, y se ensambla solo"
	]
	quest.3FCBBFC8F9878BB0.quest_subtitle: "Reactores"
	quest.3FEAD6A0D535B218.quest_desc: [
		"&4Neo Vitae&r es un mod de magia y alquimia que usa la &csangre&r como maná y como fuente de poder"
		""
		"Empiezas con un diamante y una herida: con eso se levanta todo lo demás"
		"{@pagebreak}"
		"Aquí te guiamos por el &baltar&r, los &borbes&r, las &brunas&r, los &bsigilos&r y los &brituales&r"
		""
		"Para el detalle completo usa la &bScriptura Vitae&r, la guía del propio mod"
	]
	quest.3FEAD6A0D535B218.quest_subtitle: "Introducción"
	quest.3FEAD6A0D535B218.title: "Un diamante y una herida"
	quest.4011996046EB8AEC.quest_desc: [
		"El &bsigilo de Holding&r guarda hasta &65 sigilos&r en uno solo"
		""
		"Abre su inventario con la tecla de &bHolding&r y cambia de sigilo con &bShift + rueda&r. Los efectos pasivos de los guardados siguen funcionando"
	]
	quest.4011996046EB8AEC.quest_subtitle: "Varios en uno"
	quest.4023E8C6F6A2D506.quest_desc: [
		"La &bsimple reforging table&r permite &areforjar&r un objeto: gastas materiales de rareza y vuelves a tirar sus afijos para buscar mejores resultados"
		""
		"Es la versión básica. Sirve para ir probando mientras reúnes material"
	]
	quest.4023E8C6F6A2D506.quest_subtitle: "Cambia los afijos"
	quest.4023E8C6F6A2D506.title: "Mesa de reforja básica"
	quest.402ED09DF680A21C.quest_desc: [
		"Con el goo de nivel 2 puedes producir &bblazegold&r en bruto. Fúndelo en lingotes"
		""
		"Con ellos mejorarás tu equipo de ferricore"
	]
	quest.402ED09DF680A21C.quest_subtitle: "Paso al Nether"
	quest.402ED09DF680A21C.title: "Blazegold"
	quest.4035BF10E7E6C36C.quest_desc: [
		"Los &bEnergy Cables&r llevan &cRF&r entre máquinas. Con la llave de Powah en modo configuración decides en qué lados entra o sale la energía"
		""
		""
		"{image:powah:textures/gui/book/images/energy_cable.png width:150 height:100 align:center click_action:none:}"
	]
	quest.4035BF10E7E6C36C.quest_subtitle: "Conecta tus máquinas"
	quest.4035BF10E7E6C36C.title: "Cables de energía"
	quest.4074466AAED15A59.quest_desc: [
		"La base para empezar con los &brituales&r, que se desbloquean con el altar en tier 2"
		""
		"Cada ritual pide un número distinto de piedras y un patrón concreto"
	]
	quest.4074466AAED15A59.quest_subtitle: "Piedra de ritual"
	quest.408BD7C2769B23C1.quest_desc: [
		"La mejora de &avacío&r elimina el exceso de objetos y fluidos para que el cajón nunca se desborde. La de &aredstone&r emite una señal según el contenido"
		""
		"Cada cajón admite 3 mejoras de utilidad"
	]
	quest.408BD7C2769B23C1.quest_subtitle: "Control de excedentes"
	quest.408BD7C2769B23C1.title: "Mejoras de utilidad I"
	quest.409F2BE072436D8C.quest_desc: [
		"El conjunto de &bCultista&r potencia los hechizos de &asangre&r, la escuela de magia que más rinde con él"
		""
		"Pulsa &2R&r sobre el objeto para ver cómo conseguirlo"
	]
	quest.409F2BE072436D8C.quest_subtitle: "Pieza 3 de 4"
	quest.40B7A74FD6458A4A.quest_desc: [
		"Elimina &c5 blazes&r"
		""
		"Viven en las &cfortalezas del Nether&r y atacan con bolas de fuego, lleva &bresistencia al fuego&r"
	]
	quest.40B7A74FD6458A4A.quest_subtitle: "5 monedas"
	quest.40B7A74FD6458A4A.title: "Cazador de blazes I"
	quest.40CEB01125038058.quest_desc: [
		"Para ver todos tus &brituales activos&r con su nombre y la posición de su piedra maestra"
		""
		"Al pasar el cursor muestra la dimensión y el &cEV&r que gasta cada ciclo, y con clic copia las coordenadas"
	]
	quest.40CEB01125038058.quest_subtitle: "Ritual Ledger"
	quest.4154BFFCF3557373.quest_desc: [
		"Una caldera &cnecesita agua constante&r, y mientras más grande sea, más agua consume"
		""
		"La forma más fácil es el &bfregadero&r de &aCooking for Blockheads&r, que da &aagua infinita&r, conéctalo al tanque con una &btubería de fluidos&r de &aPipez&r en modo de extracción"
	]
	quest.4154BFFCF3557373.quest_subtitle: "Sin agua no hay vapor"
	quest.4154BFFCF3557373.title: "Agua para la caldera"
	quest.4155441A25D24D4C.quest_desc: ["La &btinta rara&r es el siguiente escalón. Se prepara en el caldero a partir de la poco común. Pulsa &2R&r para ver su receta"]
	quest.4155441A25D24D4C.title: "Tinta rara"
	quest.417B3C6EA531AACF.quest_desc: [
		"Con &6Arion&r derrotado, el mundo te deja &apicar osmio&r, la base de &bMekanism&r"
		""
		"Recoge el mineral en bruto y fúndelo en un horno. Con los lingotes fabricarás tus primeras máquinas"
	]
	quest.417B3C6EA531AACF.quest_subtitle: "El osmio ya es tuyo"
	quest.417B3C6EA531AACF.title: "Osmio"
	quest.419242384CBD74A0.quest_desc: ["El &bgold spell book&r da más ranuras y suma &amaná máximo&r y menos tiempo de lanzamiento"]
	quest.419242384CBD74A0.quest_subtitle: "Maná y rapidez"
	quest.419242384CBD74A0.title: "Libro de oro"
	quest.41D28A825656AB3B.quest_desc: [
		"&bComforts&r añade sacos de dormir y hamacas. El saco se fabrica con lana, se tiñe y funciona como una cama, pero &enunca cambia tu punto de reaparición&r"
		""
		"Sirven para saltarte la noche en plena expedición sin perder tu cama"
	]
	quest.41D28A825656AB3B.quest_subtitle: "Descansa donde sea"
	quest.41D28A825656AB3B.title: "Comforts"
	quest.41D73E258F40D506.quest_desc: [
		"Entre los bosques de este mundo crecen árboles de colores imposibles. Son los &darchwood&r, el origen de toda la magia de &bArs Nouveau&r"
		""
		"Consigue troncos y tablones de archwood: serán la base de casi todo lo que construyas a partir de ahora"
	]
	quest.41D73E258F40D506.quest_subtitle: "El susurro del bosque"
	quest.41D73E258F40D506.title: "La magia del mundo"
	quest.41F2421687315915.quest_desc: ["Un material necesario para poder &aautomatizar la sangre&r"]
	quest.41F2421687315915.quest_subtitle: "Material de mazmorra"
	quest.423730AC37CE09E0.quest_desc: [
		"Los imanes de &aSimple Magnets&r &batraen los objetos del suelo hacia ti&r, solo dales clic derecho para encenderlos o apagarlos"
		""
		"El &7básico&r atrae en un radio de 5 bloques, &bel avanzado llega hasta 11&r y además tiene &dfiltro&r, ábrelo con &6Shift + clic derecho&r"
	]
	quest.423730AC37CE09E0.quest_subtitle: "Todo el botín a tus pies"
	quest.423730AC37CE09E0.title: "Imanes"
	quest.42598A04C6A0F344.quest_desc: [
		"El &aPaxel de esmeralda&r de &aPickle Tweaks&r tiene &bmuchísima durabilidad y velocidad de minado&r"
		""
		"&6Es la última mejora antes de dar el salto al diamante&r"
	]
	quest.42598A04C6A0F344.quest_subtitle: "La herramienta de la fase"
	quest.42725B6A376BBA48.quest_desc: [
		"El siguiente jefe es la &4Netherite Monstrosity&r de &aCataclysm&r, &cun coloso gigante de netherite y lava&r que vive en una forja abandonada del Nether"
		""
		"&cGolpea el suelo y hace brotar lava a su alrededor&r, lanza &6bombas de magma&r desde lejos y &cse vuelve más agresivo cuando está herido&r"
		""
		"&aEquipo recomendado:&r set de diamante, &6pociones de resistencia al fuego&r, buena comida y si puedes, un escudo"
		"{@pagebreak}"
		"Para encontrar su forja necesitas el &4Monstrous Eye&r, &blas siguientes misiones te muestran cada ingrediente&r"
	]
	quest.42725B6A376BBA48.quest_subtitle: "Un coloso de lava"
	quest.42725B6A376BBA48.title: "La monstruosidad de netherite"
	quest.4285A9383A751CEF.quest_desc: ["La base de mejoras (&aupgrade base&r) es el ingrediente de todas las mejoras. Fabrícala primero y úsala en el resto"]
	quest.4285A9383A751CEF.quest_subtitle: "El componente común"
	quest.4285A9383A751CEF.title: "Base de mejoras"
	quest.42938E4F6DC3CAD6.quest_desc: [
		"El mundo es enorme y peligroso, pero no tienes por qué recorrerlo solo"
		""
		"Con &bFTB Teams&r puedes formar un equipo: sus miembros &acomparten el progreso de las misiones&r, así que lo que logra uno, lo logran todos"
		""
		"Para proteger tu base, &bFTB Chunks&r te deja reclamar chunks desde el mapa (&2M&r). Los chunks reclamados pertenecen a tu equipo: tus compañeros pueden construir y usar tus cofres; los demás, no"
		""
		"&eOjo:&r lo que no esté reclamado no está protegido"
	]
	quest.42938E4F6DC3CAD6.quest_subtitle: "Mejor en compañía"
	quest.42959133EAC13801.quest_desc: [
		"Se coloca en el &bAthanor&r y necesita un suministro de &bagua&r"
		""
		"Es necesaria para convertir el &btau saturado&r en fragmentos de sangre, el siguiente paso"
	]
	quest.42959133EAC13801.quest_subtitle: "Necesaria para el Athanor"
	quest.42A8A6A427D60DD2.quest_desc: [
		"Un spawner normal sigue generando mobs, pero con &bApotheosis&r puedes &arecogerlo&r con un libro de &dSilk Touch&r y llevártelo a tu base"
		""
		"Usa tus propios spawners para granjas de mobs: es la forma más cómoda de conseguir objetos de criaturas concretas"
	]
	quest.42A8A6A427D60DD2.quest_subtitle: "Más que un bloque de cuevas"
	quest.42A8A6A427D60DD2.title: "Spawner"
	quest.42A9F7D6675F03F5.quest_desc: [
		"El &bCopper Age Backport&r trae al pack el equipo de cobre de las versiones nuevas de Minecraft"
		""
		"No es la mejor protección, pero es un comienzo. Tu equipo irá mejorando fase a fase"
	]
	quest.42A9F7D6675F03F5.quest_subtitle: "Tu primera armadura"
	quest.42A9F7D6675F03F5.title: "Armadura de cobre"
	quest.42B56944F22DDDC4.quest_desc: [
		"Elimina &c50 blazes&r"
		""
		"&aSe puede repetir&r: cada vez que la completes ganas &650 monedas&r más, así que es una buena forma de &afarmear dinero&r"
	]
	quest.42B56944F22DDDC4.quest_subtitle: "50 monedas"
	quest.42B56944F22DDDC4.title: "Cazador de blazes IV"
	quest.4374F06CB06366E8.title: "Cuello"
	quest.439B07A3D0E5EDF0.quest_desc: ["La &blightning rod&r (vara de rayo) es el bastón de la escuela de &arayo&r"]
	quest.439B07A3D0E5EDF0.quest_subtitle: "Magia de rayo"
	quest.439B07A3D0E5EDF0.title: "Vara de rayo"
	quest.43D30C4586F49997.quest_desc: [
		"El &aAugment de fábrica&r convierte tu horno en una &bpequeña fábrica&r, capaz de &afundir varios objetos a la vez&r en ranuras separadas"
		""
		"Se coloca en la &dranura de aumentos&r del horno, &cpero a cambio el horno pasa a funcionar con RF&r, así que tendrás que conectarlo a tu red de energía"
	]
	quest.43D30C4586F49997.quest_subtitle: "Más ranuras, más producción"
	quest.43D30C4586F49997.title: "Aumento de fábrica"
	quest.448A8B92AD406946.quest_desc: [
		"La base de toda runa"
		""
		"Por sí sola &ano da ningún efecto&r, pero sirve para completar la estructura del altar y mejorarlo. Por ejemplo, en el tier 1 las ocho runas pueden ir en blanco"
	]
	quest.448A8B92AD406946.quest_subtitle: "Runa en blanco"
	quest.44B6EE92CA2BC625.quest_desc: ["El &6Copper Casing&r se hace aplicando &6cobre&r sobre madera sin corteza, &ay es la base de las máquinas de fluidos&r"]
	quest.44B6EE92CA2BC625.quest_subtitle: "Para los fluidos"
	quest.44DE33E717C5E26F.quest_desc: [
		"La &6Llave&r de &aCreate&r &brota las piezas&r con clic derecho, y con &bShift + clic derecho&r las recoge al instante, sin romperlas"
		""
		"Las &6Gafas del ingeniero&r te dejan &bver la información de cada pieza&r, velocidad, estrés y capacidad, &ano armes nada sin ellas&r"
	]
	quest.44DE33E717C5E26F.quest_subtitle: "Lo básico del ingeniero"
	quest.44DE33E717C5E26F.title: "Herramientas"
	quest.453F4C8DF3B49B86.quest_desc: [
		"Acá el oro &cno es el metal de adorno de siempre&r, fue &arebalanceado&r para ser una opción real después del hierro"
		""
		"La armadura y herramientas de &eoro&r &aaguantan muchísimo más que las de hierro&r, y la armadura gana algo de &bdureza&r con una protección parecida"
	]
	quest.453F4C8DF3B49B86.quest_subtitle: "Mejor que el hierro"
	quest.453F4C8DF3B49B86.title: "Oro mejorado"
	quest.454BCBC3F05697E4.quest_desc: [
		"La &bHellfire Forge&r funciona con &cespíritus&r"
		""
		"Con ella harás &bgemas de espíritu&r, herramientas sintientes, cargas explosivas y más dagas"
	]
	quest.454BCBC3F05697E4.quest_subtitle: "Forja de espíritus"
	quest.45DD499988E92E63.quest_desc: [
		"La &6Mechanical Mixer&r, encima de una &bBasin&r, &amezcla ingredientes y hace recetas sin forma fija&r"
		""
		"&cAlgunas recetas necesitan calor&r, como el latón, para eso vas a necesitar un quemador de blaze debajo de la basin"
	]
	quest.45DD499988E92E63.quest_subtitle: "Recetas sin manos"
	quest.45DD499988E92E63.title: "Mezcladora"
	quest.46123B9E270D8371.quest_desc: [
		"La &bpatata venenosa&r es el foco de la escuela de &anaturaleza&r"
		""
		"También se usa para fabricar tinta poco común"
	]
	quest.46123B9E270D8371.quest_subtitle: "Foco de naturaleza"
	quest.46123B9E270D8371.title: "Patata venenosa"
	quest.4617EF3CED887639.quest_desc: [
		"Los &aElevators&r te llevan &barriba y abajo al instante&r, solo pon dos o más en la misma columna"
		""
		"&aSalta&r sobre uno para subir al siguiente y &aagáchate&r para bajar"
		""
		"Además puedes teñirlos y &dcamuflarlos&r con otro bloque, dándoles clic derecho con él"
	]
	quest.4617EF3CED887639.quest_subtitle: "Subir sin escaleras"
	quest.4617EF3CED887639.title: "Elevadores"
	quest.461F4C3F95573C59.quest_desc: ["Los cajones de compactación convierten automáticamente entre formas, como pepitas, lingotes y bloques, y guardan todo en un solo cajón"]
	quest.461F4C3F95573C59.quest_subtitle: "Pepitas, lingotes y bloques"
	quest.461F4C3F95573C59.title: "Cajones de compactación"
	quest.469E0BAB5744B17F.quest_desc: [
		"La &bseashelf&r es una estantería de los océanos que sube la eterna hasta 45 y se enfoca en la arcana"
		""
		"Es el primer paso de una línea que se mejora con infusiones y la alternativa a la hellshelf"
	]
	quest.469E0BAB5744B17F.quest_subtitle: "Línea de seashelf"
	quest.469E0BAB5744B17F.title: "Estanterías marinas"
	quest.46F216CA7939E85D.quest_desc: [
		"&bApotheosis&r cambia por completo los &aspawners&r: ahora puedes recogerlos, moverlos y &amejorarlos&r para que trabajen a tu favor"
		""
		"Para recogerlos necesitas un libro con &dSilk Touch&r. Una vez colocado, cada spawner tiene sus propias estadísticas: rapidez, cantidad de mobs, rango y más. Se mejoran con &arunas&r que le aplicas con clic derecho"
		""
		"El tipo de mob se cambia con &ahuevos de spawn&r, y los huevos de los mobs que quieras los consigues con el encantamiento de &dcapturing&r"
	]
	quest.46F216CA7939E85D.quest_subtitle: "Un rework a fondo"
	quest.46F216CA7939E85D.title: "Spawners"
	quest.46F56FCD02111060.quest_desc: [
		"Necesitas &648 runas&r más para pasar del tier 3 al &6tier 4&r, en un anillo de radio 8 un nivel más abajo"
		""
		"Los cuatro puntos cardinales se rematan con &bbloques de hellforged&r. Aquí se fabrica el orbe &bDominus&r, de &65.000.000 EV&r"
		""
		"{image:undercraft:textures/questpics/neo_vitae/tier_4_altar.png width:170 height:150 align:center click_action:none:}"
	]
	quest.46F56FCD02111060.title: "Altar Tier 4"
	quest.47112AB7D32D3D47.quest_desc: [
		"Los &bpergaminos&r son de lo primero que vas a encontrar. Se pueden lanzar, pero &cse gastan al usarlos&r"
		""
		"Para usar un hechizo sin límite, inscríbelo en un &dlibro de hechizos&r con la &aInscription Table&r, y desde ahí lo lanzas con &bmaná&r"
	]
	quest.47112AB7D32D3D47.quest_subtitle: "Hechizos de un solo uso"
	quest.47112AB7D32D3D47.title: "Pergaminos"
	quest.472FF135A607167E.quest_desc: [
		"El &aUniversal Cable&r mueve &cRF&r entre generadores, baterías y máquinas"
		""
		"Se conecta solo a todo lo que tenga energía, y &bse puede mejorar&r a niveles con más capacidad cuando tengas mejores circuitos"
	]
	quest.472FF135A607167E.quest_subtitle: "Energía de un lado a otro"
	quest.472FF135A607167E.title: "Universal Cable"
	quest.47CA8FC3321F30D3.quest_desc: ["La &blightning bottle&r es el foco de la escuela de &arayo&r. Pulsa &2R&r para ver cómo se consigue"]
	quest.47CA8FC3321F30D3.quest_subtitle: "Foco de rayo"
	quest.47CA8FC3321F30D3.title: "Botella de rayo"
	quest.47D127FE82A04650.quest_desc: ["Elimina &c50 arañas&r"]
	quest.47D127FE82A04650.quest_subtitle: "25 monedas"
	quest.47D127FE82A04650.title: "Cazador de arañas III"
	quest.48341B538A6A9F88.quest_desc: [
		"Elimina &c10 creepers&r"
		""
		"Ataca rápido y aléjate: &cexplotan si les das tiempo&r"
	]
	quest.48341B538A6A9F88.quest_subtitle: "5 monedas"
	quest.48341B538A6A9F88.title: "Cazador de creepers I"
	quest.4876A0FF740ED39B.quest_desc: [
		"Los sigilos de un solo uso hacen una cosa por vez y &cgastan EV&r cada vez que los usas"
		""
		"&bAgua&r: &6100 EV&r por uso"
		"&bLava&r: &61.000 EV&r, y si no tienes cobra &c5 corazones&r"
		"&bVacío&r: &650 EV&r por bloque de fluido que quita"
		"&bAire&r: &650 EV&r por impulso, no te protege de la caída"
		"{@pagebreak}"
		"&bLuz de sangre&r: &610 EV&r por luz colocada, brillo de 1 a 15"
		"&bNecromancia&r: &62.000 EV&r, invoca un no-muerto durante &65 minutos&r"
		"&bTeleposición&r: &61.000 EV&r para llevarte a un teleposer enlazado, incluso entre dimensiones"
	]
	quest.4876A0FF740ED39B.quest_subtitle: "Un efecto por uso"
	quest.48CE00B5121FA15A.quest_desc: [
		"Las &aWaystones&r son piedras de teletransporte, &bactívalas y podrás viajar a cualquiera que hayas descubierto&r"
		""
		"&cViajar cuesta experiencia según la distancia&r, pero también hay objetos como la &dWarp Stone&r para teletransportarte sin tener una waystone cerca"
		""
		"Pon una en cada base importante y &ael mundo se volverá mucho más pequeño&r"
	]
	quest.48CE00B5121FA15A.quest_subtitle: "Viaje rápido"
	quest.48CE00B5121FA15A.title: "Waystones"
	quest.48D48C3D1A9285CB.quest_desc: [
		"Las &6armas medianas&r de &bdiamante&r mantienen el &bbalance entre velocidad y daño&r, a dos manos"
		""
		"&aUna gran opción para las peleas del Nether&r"
		""
		"&6Se consiguen con la plantilla de mejora de diamante&r"
	]
	quest.48D48C3D1A9285CB.quest_subtitle: "El balance perfecto"
	quest.48D48C3D1A9285CB.title: "Armas medianas de diamante"
	quest.48D80E0BA1D023E6.title: "Brazalete"
	quest.4973D92284E9BC8F.quest_desc: [
		"El conjunto de &bSacerdote&r potencia los hechizos de &asagrada&r, la escuela de magia que más rinde con él"
		""
		"Pulsa &2R&r sobre el objeto para ver cómo conseguirlo"
	]
	quest.4973D92284E9BC8F.quest_subtitle: "Pieza 2 de 4"
	quest.49B695D8BD43D7DA.quest_desc: ["El &bSimple Fuel Generator&r quema fluidos refinados y produce &cRF&r. Por defecto da 5000 RF/t con un búfer de 5M"]
	quest.49B695D8BD43D7DA.quest_subtitle: "Combustible líquido"
	quest.49B695D8BD43D7DA.title: "Generador de fluido"
	quest.49E149070DBAE7DF.quest_desc: [
		"El conjunto de &bElectromante&r potencia los hechizos de &arayo&r, la escuela de magia que más rinde con él"
		""
		"Pulsa &2R&r sobre el objeto para ver cómo conseguirlo"
	]
	quest.49E149070DBAE7DF.quest_subtitle: "Pieza 4 de 4"
	quest.49E3091A6C2152BA.quest_desc: [
		"Tarde o temprano &cel inventario se queda corto&r, y acá es donde entran las mochilas de &aSophisticated Backpacks&r"
		""
		"Las mochilas &bse llevan en la espalda o en la mano&r y se abren con la B, además &ase pueden mejorar&r a versiones con más espacio y con &dupgrades&r como recoger objetos, filtrar o comer solas"
		""
		"Revisa el capítulo de &aSophisticated Mods&r para ver todo lo que pueden hacer"
		""
		"Nota: El cuero puede crearse combinando y cocinando carne podrida"
	]
	quest.49E3091A6C2152BA.quest_subtitle: "Nunca hay suficiente espacio"
	quest.49E3091A6C2152BA.title: "El problema del inventario"
	quest.49F6680DFAE7317D.quest_desc: [
		"La &aSpeed Upgrade&r hace que la máquina &btrabaje más rápido&r, puedes poner hasta 8"
		""
		"&cCada una también aumenta el gasto de energía&r, así que combínala con la &aEnergy Upgrade&r"
	]
	quest.49F6680DFAE7317D.quest_subtitle: "Más rápido"
	quest.49F6680DFAE7317D.title: "Speed Upgrade"
	quest.4A6AFFBCE370E396.quest_desc: [
		"La &binfused spawner rune&r es la versión avanzada: se consigue &ainfundiendo&r una runa normal"
		""
		"Con ella se fabrican las mejoras más poderosas: mobs sin IA, ignorar condiciones y jugadores, o &aecoing&r"
	]
	quest.4A6AFFBCE370E396.quest_subtitle: "Mejoras avanzadas"
	quest.4A6AFFBCE370E396.title: "Runa infundida"
	quest.4A96B3D72597B9FD.quest_desc: ["En la mesa de herrería, una herramienta de ferricore, esta plantilla y un lingote de blazegold dan el equipo de &bblazegold&r. Las mejoras instaladas se conservan"]
	quest.4A96B3D72597B9FD.quest_subtitle: "Un nivel más"
	quest.4A96B3D72597B9FD.title: "Plantilla de blazegold"
	quest.4AAD120082A42857.quest_desc: [
		"El conjunto de &bCriomante&r potencia los hechizos de &ahielo&r, la escuela de magia que más rinde con él"
		""
		"Pulsa &2R&r sobre el objeto para ver cómo conseguirlo"
	]
	quest.4AAD120082A42857.quest_subtitle: "Pieza 3 de 4"
	quest.4ACB2966F55F6CB4.quest_desc: [
		"Con &6latón&r, &6Cinder Essence&r, el &dtótem&r y la &7chatarra de netherite&r ya puedes fabricar el &4Monstrous Eye&r"
		""
		"&aLánzalo y te guiará hasta la forja"
	]
	quest.4AD5EAF05C5FD7FD.quest_desc: [
		"Las &carmas pesadas&r son &clentas y se usan a dos manos&r, a cambio &ahacen un daño enorme&r y muchas &bgolpean en área&r, perfectas contra grupos de enemigos"
		""
		"&6Cuidado con el tiempo entre golpes&r, si fallas un ataque quedas expuesto"
		""
		"Las de &fhierro&r son las primeras que podrás fabricar"
	]
	quest.4AD5EAF05C5FD7FD.quest_subtitle: "Lentas pero devastadoras"
	quest.4AD5EAF05C5FD7FD.title: "Armas pesadas de hierro"
	quest.4AD98FAF18B74ABA.quest_desc: ["Las &bvaras de blaze&r son uno de los ingredientes de los &atomos de encantamiento&r, los libros de &bApotheosis&r"]
	quest.4AD98FAF18B74ABA.title: "Varas de blaze"
	quest.4B1E89816BFBBD57.quest_desc: ["Mete la mochila en la mesa de crafteo con tintes. Los de la izquierda dan el color principal y los de la derecha el de acento. Con agua en un caldero la limpias"]
	quest.4B1E89816BFBBD57.quest_subtitle: "A tu gusto"
	quest.4B1E89816BFBBD57.title: "Teñir mochilas"
	quest.4B38BC9746FEEB1F.quest_desc: [
		"Los &athreads&r son mejoras para la armadura mágica. Algunos aumentan el maná máximo, otros te permiten planear, drenan vida o reparan tu equipo"
		""
		"Cada ranura admite hilos de cierto nivel. Se aplican en la &bAlteration Table&r"
	]
	quest.4B38BC9746FEEB1F.quest_subtitle: "Habilidades para tu túnica"
	quest.4B38BC9746FEEB1F.title: "Hilos"
	quest.4B57662AD6D877CB.quest_desc: ["Espada, pico, hacha, pala, azada y arco. Es el primer nivel de equipo de &bJust Dire Things&r. El arco admite una poción en su ranura de bote"]
	quest.4B57662AD6D877CB.quest_subtitle: "El primer arsenal"
	quest.4B57662AD6D877CB.title: "Herramientas de ferricore"
	quest.4B835E40A555F6EC.quest_desc: ["Pon un orbe aquí, junto al altar, y cargarás tu red de &dAnima&r mucho más rápido"]
	quest.4B835E40A555F6EC.quest_subtitle: "Carga de Anima"
	quest.4BB6BDD54DAD5A5D.quest_desc: [
		"Paga &650 monedas&r y recibe &bun accesorio al azar&r de los más sencillos de &aArtifacts&r y &aRelics&r"
		""
		"Se puede comprar de nuevo &7cada 30 minutos&r"
	]
	quest.4BB6BDD54DAD5A5D.quest_subtitle: "Un accesorio al azar"
	quest.4BB6BDD54DAD5A5D.title: "Low Tier Curio"
	quest.4BE68CB33FA9BAB5.quest_desc: [
		"El &aMarket&r de &aFarming for Blockheads&r vende &bsemillas, retoños de árbol y bonemeal&r"
		""
		"Es la forma más rápida de &aempezar granjas y bosques&r sin tener que salir a buscar cada planta"
	]
	quest.4BE68CB33FA9BAB5.quest_subtitle: "Semillas y retoños"
	quest.4BE68CB33FA9BAB5.title: "Mercado"
	quest.4BF51CE66E0678BB.quest_desc: [
		"Usa un &aTier Installer&r sobre una máquina y la conviertes en una &bfábrica&r, sin desmontarla"
		""
		"La fábrica &7básica&r procesa &b3 objetos a la vez&r en lugar de uno"
	]
	quest.4BF51CE66E0678BB.quest_subtitle: "Máquinas en fábricas"
	quest.4BF51CE66E0678BB.title: "Basic Tier Installer"
	quest.4C299D312C265440.quest_desc: ["La &barmadura de diamante&r, &ase consigue mejorando la misma armadura Gilded&r con la plantilla"]
	quest.4C299D312C265440.title: "Armadura de diamante"
	quest.4C738F1C1ABCBBE1.quest_desc: [
		"La &bhellshelf&r se fabrica con materiales del Nether y sube la eterna hasta 45 y se enfoca en la quanta"
		""
		"Es el primer paso de una línea que se mejora con infusiones y la alternativa a la seashelf"
	]
	quest.4C738F1C1ABCBBE1.quest_subtitle: "Línea de hellshelf"
	quest.4C738F1C1ABCBBE1.title: "Estanterías del infierno"
	quest.4CB0926CAC2CEAA5.quest_desc: [
		"Los &aFramed Blocks&r son bloques marco que &bcopian el aspecto de otro bloque&r, solo dale clic derecho a uno con el bloque que quieras usar"
		""
		"La &6sierra&r es donde se fabrican todas las formas, así puedes tener escaleras, losas, paredes y formas raras &acon la textura que se te antoje&r"
		""
		"El &bmartillo&r le quita la textura y la &bllave&r rota las piezas"
	]
	quest.4CB0926CAC2CEAA5.quest_subtitle: "Cualquier forma, cualquier textura"
	quest.4CB0926CAC2CEAA5.title: "Bloques enmarcados"
	quest.4CB1A2766520D27B.quest_desc: ["La &earmadura de oro&r resiste más que la de hierro, &6y será la base de su versión mejorada&r"]
	quest.4CB1A2766520D27B.quest_subtitle: "La mejora que merece"
	quest.4CB1A2766520D27B.title: "Armadura de oro"
	quest.4CBACB11D6B30434.quest_desc: [
		"Las bobinas &bevitan que los imanes atraigan objetos&r dentro de su zona, la &7básica&r cubre 3 bloques y la &bavanzada&r 5, &aademás de tener filtro&r"
		""
		"&aPonlas junto a tus granjas o cofres&r para que tu imán no se lleve lo que no quieres"
	]
	quest.4CBACB11D6B30434.quest_subtitle: "Zonas sin imán"
	quest.4CBACB11D6B30434.title: "Bobinas de desmagnetización"
	quest.4D159085D7DC0CF0.quest_desc: [
		"Los &bSolar Panels&r producen &cRF&r con la luz del sol. Cualquier bloque encima les corta la luz"
		""
		""
		"{image:powah:textures/gui/book/images/solar_panel.png width:150 height:100 align:center}"
	]
	quest.4D159085D7DC0CF0.quest_subtitle: "Energía gratuita"
	quest.4D159085D7DC0CF0.title: "Paneles solares"
	quest.4D38674D7CCD6A0D.quest_desc: [
		"¿Para qué construir una mesa en cada base si puedes llevarla contigo?"
		""
		"La &bCrafting On A Stick&r abre una mesa de crafteo con solo usarla, en cualquier lugar. Ya no tendrás que volver a casa para fabricar nada"
	]
	quest.4D38674D7CCD6A0D.quest_subtitle: "Fabrica donde sea"
	quest.4D38674D7CCD6A0D.title: "Mesa de crafteo de bolsillo"
	quest.4D4037761414358C.quest_desc: ["La &bVoidshift Wand&r te teletransporta hasta donde miras, dentro de una distancia máxima"]
	quest.4D4037761414358C.quest_subtitle: "Teletransporte corto"
	quest.4D4037761414358C.title: "Varita Voidshift"
	quest.4D40A8581CCB6075.quest_desc: [
		"El &bArcane Anvil&r es el yunque de la magia. Con él &acombinas pergaminos&r del mismo hechizo para subirlo de nivel, &areparas&r objetos mágicos, &aimbuyes&r armas con hechizos y aplicas &aorbes de mejora&r"
		""
		"También permite añadir una ranura a un libro de hechizos, hasta un máximo"
	]
	quest.4D40A8581CCB6075.quest_subtitle: "Mejora y combina"
	quest.4D40A8581CCB6075.title: "Yunque arcano"
	quest.4D529229BCFE2092.quest_desc: ["El &bSimple Coal Generator&r quema cualquier combustible de horno, además de los carbones especiales del mod, y produce &cRF&r. Por defecto da 1000 RF/t con un búfer de 1M"]
	quest.4D529229BCFE2092.quest_subtitle: "Energía con combustible"
	quest.4D529229BCFE2092.title: "Generador de carbón"
	quest.4D62AB3F8F3412C4.quest_desc: [
		"Entrega &a5 &ebloques de oro&r&r de una vez y recibe &675 monedas&r en tu cartera"
		""
		"Es la versión por lote de la venta de uno en uno, para vaciar el almacén más rápido"
	]
	quest.4D62AB3F8F3412C4.quest_subtitle: "75 monedas"
	quest.4D62AB3F8F3412C4.title: "Vender oro x5"
	quest.4D9A5677DCB7C78A.quest_desc: ["Las de nivel 2 usan &cRF&r y trabajan sobre un área configurable, con filtros de permitir o denegar. Son mucho más potentes que las de nivel 1"]
	quest.4D9A5677DCB7C78A.quest_subtitle: "Con energía y área"
	quest.4D9A5677DCB7C78A.title: "Máquinas avanzadas"
	quest.4DA6C1B876CD3C11.quest_desc: [
		"Entrega un &6bloque de cobre&r y recibe &62 monedas&r en tu cartera"
		""
		"Se puede repetir todas las veces que quieras"
	]
	quest.4DA6C1B876CD3C11.quest_subtitle: "2 monedas"
	quest.4DA6C1B876CD3C11.title: "Vender cobre"
	quest.4DB8BEC220069AF6.quest_desc: [
		"El &bnecronomicon&r lo suelta el &6Rey Muerto&r. Da mucho maná y mejora el hechizo de resurrección"
		""
		"Incluye hechizos bloqueados que ya vienen en el libro, así que deja menos ranuras libres"
	]
	quest.4DB8BEC220069AF6.quest_subtitle: "El libro del Rey Muerto"
	quest.4DB8BEC220069AF6.title: "Necronomicón"
	quest.4DDC1AC0E09113C2.quest_desc: [
		"Los &dniveles de mundo&r de &bApotheosis&r controlan la dificultad y la calidad del botín. El primero es el &6Refugio&r"
		""
		"Se desbloquea al encontrar tu primer objeto con &aafijos&r y está activo desde el principio: no tienes que hacer nada especial"
		""
		"Pulsa &2CTRL+T&r para abrir la pantalla de niveles de mundo y ver el estado de cada uno"
	]
	quest.4DDC1AC0E09113C2.quest_subtitle: "Donde empieza todo"
	quest.4DDC1AC0E09113C2.title: "World Tier: Haven"
	quest.4E026BEA6C36DCE3.quest_desc: ["El diamante alcanza 108 huecos y 4 ranuras de mejora"]
	quest.4E026BEA6C36DCE3.quest_subtitle: "Gran almacén"
	quest.4E026BEA6C36DCE3.title: "Diamante"
	quest.4E225C4DF0FD23EF.quest_desc: ["Multiplican los objetos por hueco: x2, x3, x4, x8, x16 y x32 según el nivel"]
	quest.4E225C4DF0FD23EF.quest_subtitle: "Más por hueco"
	quest.4E225C4DF0FD23EF.title: "Mejoras de pila"
	quest.4E6F70543495D02A.quest_desc: [
		"Necesitas &628 runas&r más para pasar del tier 2 al &6tier 3&r, en un anillo de radio 5 un nivel más abajo"
		""
		"En las esquinas van los &bladrillos de sangre&r. Aquí se fabrica el orbe &bMagus&r, de &61.000.000 EV&r"
		""
		"{image:undercraft:textures/questpics/neo_vitae/tier_3_altar.png width:150 height:150 align:center click_action:none:}"
	]
	quest.4E6F70543495D02A.title: "Altar Tier 3"
	quest.4E911222973B34D6.quest_desc: [
		"Multiplican cuántos objetos caben en cada hueco: x1.5, x2, x4, x8 y x16 en sus niveles. Se multiplican entre sí si pones varias"
		""
		"&eAviso:&r con tantos objetos por hueco, vigila que la mochila no sea tu único respaldo"
	]
	quest.4E911222973B34D6.quest_subtitle: "Más objetos por hueco"
	quest.4E911222973B34D6.title: "Mejoras de pila"
	quest.4EB97233BB225F3B.quest_desc: [
		"La &btinta común&r es la base de todas las demás. Se prepara en el &bcaldero de alquimista&r:"
		""
		"Parte del &aagua&r, añade una &asaca de tinta luminosa&r y, para terminar, la &bmysterious scrap metal&r de &bApotheosis&r. La chatarra sale desmontando equipo común en la mesa de recuperación"
	]
	quest.4EB97233BB225F3B.quest_subtitle: "La primera de las tintas"
	quest.4EB97233BB225F3B.title: "Tinta común"
	quest.4EE12258872C5C07.title: "Cinturón"
	quest.4F585FE9DCD0334C.quest_desc: [
		"Elimina &c100 zombis&r"
		""
		"&aSe puede repetir&r: cada vez que la completes ganas &650 monedas&r más, así que es una buena forma de &afarmear dinero&r"
	]
	quest.4F585FE9DCD0334C.quest_subtitle: "50 monedas"
	quest.4F585FE9DCD0334C.title: "Cazador de zombis IV"
	quest.4F751B609F5EC2D7.quest_desc: [
		"Las &carmas pesadas&r de &bdiamante&r son &clentas y a dos manos&r, pero &adestrozan todo lo que tocan&r, incluso a varios enemigos a la vez"
		""
		"&6Se consiguen con la plantilla de mejora de diamante&r"
	]
	quest.4F751B609F5EC2D7.quest_subtitle: "Fuerza bruta"
	quest.4F751B609F5EC2D7.title: "Armas pesadas de diamante"
	quest.4F87FEB62DCD01DC.quest_desc: [
		"Los &dniveles de mundo&r de &bApotheosis&r son cinco: &6Refugio&r, &6Frontera&r, &6Ascenso&r, &6Cumbre&r y &6Pináculo&r"
		""
		"Cada uno exige cumplir ciertos requisitos (equipo de cierta rareza, jefes derrotados) y, a cambio, mejora el &abotín&r y la rareza de los objetos que encuentras, pero también hace el mundo más peligroso"
		""
		"Pulsa &2CTRL+T&r para ver tu nivel y activar los que ya hayas desbloqueado. Las runas de mejora de los &aspawners&r también van ligadas a estos niveles"
	]
	quest.4F87FEB62DCD01DC.quest_subtitle: "Cinco niveles de dificultad"
	quest.4F87FEB62DCD01DC.title: "Niveles de mundo"
	quest.4FA1ACB77EF9DD46.quest_desc: ["Cobre 45 huecos, hierro 54, oro 81, diamante 108 y netherite 120. El número de ranuras para mejoras también crece, hasta 7"]
	quest.4FA1ACB77EF9DD46.quest_subtitle: "De cuero a netherite"
	quest.4FA1ACB77EF9DD46.title: "Niveles de mochila"
	quest.4FE99EA8AEF141AD.quest_desc: [
		"El &bsteel casing&r es el bloque estructural de &bMekanism&r. Con él se fabrican la mayoría de sus máquinas"
		""
		"Se hace con acero, vidrio y un lingote de osmio. Prepara más acero del que crees: lo vas a necesitar"
	]
	quest.4FE99EA8AEF141AD.quest_subtitle: "La estructura de tus máquinas"
	quest.4FE99EA8AEF141AD.title: "Steel Casing"
	quest.4FF0DD7668C5C61B.quest_desc: [
		"El tercer jefe es &aArion&r, &2tirano de la ira esmeralda&r, y se pelea &cen varias fases&r"
		""
		"Para invocarlo necesitas el &aEmerald Totem&r, su receta pide dos ingredientes especiales, &dtinta poco común&r y &atela desgastada&r"
		""
		"La &dtinta&r se hace en el &bcaldero de Iron's Spellbooks&r, primero tinta común y después mezclada con una patata venenosa, y la &atela&r viene de &aApotheosis&r, en su segundo nivel de materiales"
		"{@pagebreak}"
		"&6Sigue las misiones vinculadas de este capítulo&r para llegar a cada ingrediente, y usa &bR&r sobre el tótem para ver su receta"
	]
	quest.4FF0DD7668C5C61B.quest_subtitle: "Tercer jefe"
	quest.4FF0DD7668C5C61B.title: "Arion, el tirano"
	quest.501E2D24B2D98C71.quest_desc: [
		"El goo de nivel 4 se fabrica con el de nivel 3, sculk, un sculk shrieker y un fragmento de eco"
		""
		"Convierte un bloque de netherite en bloque de &beclipse alloy&r en bruto, el material más raro del mod"
	]
	quest.501E2D24B2D98C71.quest_subtitle: "El goo definitivo"
	quest.501E2D24B2D98C71.title: "Shadowpulse"
	quest.50C3A8BD701B78D3.title: "Ítems varios"
	quest.50F0495BE7C281DB.quest_desc: ["Los generadores activos queman combustible: los &afurnators&r, sólido, y los &amagmators&r, fluidos calientes como la lava. A mayor nivel, queman más rápido, con la misma energía por combustible"]
	quest.50F0495BE7C281DB.quest_subtitle: "Generadores activos"
	quest.510FAE9C63FBF3D5.quest_desc: [
		"Estas piezas te dejan &bcontrolar la rotación con redstone&r"
		""
		"El &6Clutch&r corta la rotación cuando recibe señal, el &6Gearshift&r la invierte, la &6Encased Chain Drive&r la lleva hacia los lados y la &6Adjustable Chain Gearshift&r cambia la velocidad con la señal"
	]
	quest.510FAE9C63FBF3D5.quest_subtitle: "Encender, apagar, invertir"
	quest.510FAE9C63FBF3D5.title: "Control de rotación"
	quest.51487C585814470E.quest_desc: [
		"La rotación tiene dos valores, la &bvelocidad&r, medida en &bRPM&r, y la &6capacidad de estrés&r, medida en &6SU&r"
		""
		"&aCada fuente da cierta capacidad de estrés&r y cada máquina consume parte de ella, &cmientras más rápido gire una máquina, más estrés consume&r"
		""
		"&cSi la red consume más de lo que tiene, se sobrecarga y se detiene&r, revísalo siempre con las gafas del ingeniero"
	]
	quest.51487C585814470E.quest_subtitle: "RPM y SU"
	quest.51487C585814470E.title: "Mecánicas básicas"
	quest.515811AF3D0FBF68.quest_desc: [
		"El conjunto de &bArchievocador&r potencia los hechizos de &aevocación&r, la escuela de magia que más rinde con él"
		""
		"Ideal para invocar criaturas y usar trucos"
		""
		"Pulsa &2R&r sobre el objeto para ver cómo conseguirlo"
	]
	quest.515811AF3D0FBF68.quest_subtitle: "Pieza 1 de 4"
	quest.51755B945A560644.quest_desc: [
		"&aMob Grinding Utils&r trae todo para armar una &bgranja de mobs automática&r"
		""
		"La idea es simple, &ahaz que aparezcan mobs&r, &aempújalos a un punto&r con ventiladores, &amátalos&r con el Mob Masher y &arecoge&r el botín y la experiencia"
	]
	quest.51755B945A560644.quest_subtitle: "Botín sin salir de casa"
	quest.51755B945A560644.title: "Granja de mobs"
	quest.518CE67000E5CE08.quest_desc: [
		"Entrega un &bbloque de diamante&r y recibe &625 monedas&r en tu cartera"
		""
		"Se puede repetir todas las veces que quieras"
	]
	quest.518CE67000E5CE08.quest_subtitle: "25 monedas"
	quest.518CE67000E5CE08.title: "Vender diamante"
	quest.519518601730E531.quest_desc: [
		"Con los materiales que deja el &6Goblin Lord&r puedes &amejorar tu equipo de oro&r en la &bmesa de herrería&r"
		""
		"Necesitas la &6Gilded Ingot Smithing Template&r, la &6Gilded Plate&r y la pieza de oro que quieras mejorar, &ael resultado es el equipo Gilded&r, con más durabilidad y dureza"
		""
		"&cImportante:&r el set completo de armadura Gilded es uno de los requisitos para desbloquear el nivel de mundo &6Frontera&r de &aApotheosis&r"
	]
	quest.519518601730E531.quest_subtitle: "El oro sube de nivel"
	quest.519518601730E531.title: "Mejora Gilded"
	quest.519D82380FBBEF88.quest_desc: [
		"Bienvenido a &d&lUnderCraft&r"
		""
		"Un modpack &akitchen sink&r donde la tecnología, magia, exploración y combate conviven en un mismo mundo, con una progresión inspirada en los &6RPG&r"
		""
		"Aquí no avanzas por tiempo jugado, sino por &6jefes derrotados&r. Cada victoria abre nuevas recetas, equipo y rincones del mundo que antes estaban fuera de tu alcance"
	]
	quest.519D82380FBBEF88.quest_subtitle: "El viaje comienza"
	quest.51AC00CED5A3D970.quest_desc: [
		"Paga &675 monedas&r y recibe &buna de cada esencia&r de &aArs Nouveau&r"
		""
		"Se puede comprar de nuevo &7cada 30 minutos&r"
	]
	quest.51AC00CED5A3D970.quest_subtitle: "Todas las esencias"
	quest.51AC00CED5A3D970.title: "Esencias de Ars Nouveau"
	quest.51C2CF1C8C9FC3EB.quest_desc: ["Elimina &c50 esqueletos&r"]
	quest.51C2CF1C8C9FC3EB.quest_subtitle: "25 monedas"
	quest.51C2CF1C8C9FC3EB.title: "Cazador de esqueletos III"
	quest.51C7271A998F6E2F.quest_desc: [
		"&bFTB Ultimine&r te deja romper de golpe un grupo de bloques iguales y conectados: un filón entero, un árbol completo, un montón de arena"
		""
		"Mantén pulsada la tecla de Ultimine (por defecto &2`&r, está bajo el Esc y junto al 1) y rompe un bloque como siempre"
		""
		"&eAviso:&r cada bloque extra cuesta &ahambre&r y desgasta tu herramienta"
	]
	quest.51C7271A998F6E2F.quest_subtitle: "Mina a lo grande"
	quest.51EA8F0C2A87ECAA.quest_desc: [
		"El conjunto de &bCaminante de sombras&r potencia los hechizos de &aender&r, la escuela de magia que más rinde con él"
		""
		"Pulsa &2R&r sobre el objeto para ver cómo conseguirlo"
	]
	quest.51EA8F0C2A87ECAA.quest_subtitle: "Pieza 3 de 4"
	quest.51FDF9134B833BEE.quest_desc: [
		"El &6Pináculo&r es el nivel más alto. Exige liberar el End, derrotando al &6Ender Dragon&r, y conseguir un set completo de equipo &aÉpico&r"
		""
		"Aquí el botín alcanza su máximo y los enemigos son brutales"
	]
	quest.51FDF9134B833BEE.quest_subtitle: "El último nivel"
	quest.51FDF9134B833BEE.title: "World Tier: Pinnacle"
	quest.5201CEC28BB36DB6.quest_desc: [
		"El &6Deployer&r &bimita a un jugador&r, usa el objeto que tenga en la mano sobre lo que tenga en frente"
		""
		"Puede &acolocar bloques, usar herramientas y aplicar objetos sobre un depot&r, y es pieza clave del &6ensamblaje secuencial&r"
		""
		"&bCon la llave cambias entre usar y golpear&r"
	]
	quest.5201CEC28BB36DB6.quest_subtitle: "Un jugador de mentira"
	quest.5201CEC28BB36DB6.title: "Deployer"
	quest.52030D643B406019.quest_desc: [
		"El conjunto de &bCultista&r potencia los hechizos de &asangre&r, la escuela de magia que más rinde con él"
		""
		"Pulsa &2R&r sobre el objeto para ver cómo conseguirlo"
	]
	quest.52030D643B406019.quest_subtitle: "Pieza 2 de 4"
	quest.520B0E6A3773D85B.quest_desc: [
		"El conjunto de &bArchievocador&r potencia los hechizos de &aevocación&r, la escuela de magia que más rinde con él"
		""
		"Pulsa &2R&r sobre el objeto para ver cómo conseguirlo"
	]
	quest.520B0E6A3773D85B.quest_subtitle: "Pieza 3 de 4"
	quest.52423AA6A27C0BD3.quest_desc: ["La &bgem-fused slate&r es un material de &bApotheosis&r que aparece en las recetas del rework de spawners"]
	quest.52423AA6A27C0BD3.quest_subtitle: "Material de spawner"
	quest.5298616F6C53B19F.quest_desc: [
		"La gema de espíritu guarda los &cespíritus&r que recoges y atrae los que haya sueltos cerca"
		""
		"Hay cinco tiers y se mejoran en la &bHellfire Forge&r:"
		""
		"&bPetty&r: &664&r"
		"&bLesser&r: &6256&r"
		"&bCommon&r: &61.024&r"
		"&bGreater&r: &64.096&r"
		"&bGrand&r: &616.384&r"
	]
	quest.5298616F6C53B19F.quest_subtitle: "Gema 1 de 5"
	quest.52A4BE58E540E2F0.quest_desc: ["La &bperla de ender&r es el foco de la escuela de &aender&r"]
	quest.52A4BE58E540E2F0.quest_subtitle: "Foco de ender"
	quest.52A4BE58E540E2F0.title: "Perla de ender"
	quest.52BC0335A8964490.quest_desc: [
		"La &6Mega Torch&r de &aTorchmaster&r &bevita que aparezcan monstruos&r en una zona enorme a su alrededor, unos 64 bloques en cada dirección"
		""
		"&cNo afecta a spawners ni a granjas&r, así que tus granjas de mobs siguen funcionando"
		""
		"La &eFeral Flare Lantern&r se encarga de &ailuminar el área por ti&r, perfecta para cuevas y minas"
	]
	quest.52BC0335A8964490.quest_subtitle: "Luz y paz en tu base"
	quest.52BC0335A8964490.title: "Torchmaster"
	quest.52C3402551E3CD86.quest_desc: [
		"El &bAlchemist Cauldron&r es el caldero de &bIron's Spellbooks&r. Sirve para mezclar ingredientes sobre un fluido base y obtener un resultado: sobre todo &atintas&r para los pergaminos"
		""
		"Rellénalo con el fluido que pida la receta, echa los ingredientes y recoge el producto con botellas. En este pack las recetas han cambiado para encajar con la progresión, así que mira cada una"
	]
	quest.52C3402551E3CD86.quest_subtitle: "Tu laboratorio de tintas"
	quest.52C3402551E3CD86.title: "Caldero de alquimista"
	quest.52EC366DA8D01808.quest_desc: [
		"Elimina &c100 arañas&r"
		""
		"&aSe puede repetir&r: cada vez que la completes ganas &650 monedas&r más, así que es una buena forma de &afarmear dinero&r"
	]
	quest.52EC366DA8D01808.quest_subtitle: "50 monedas"
	quest.52EC366DA8D01808.title: "Cazador de arañas IV"
	quest.5337FFC1C23486F0.quest_desc: [
		"&aHostile Neural Networks&r te deja &bconseguir el botín de los mobs sin tenerlos cerca&r"
		""
		"Primero &aestudias a un mob&r peleando con él, guardando lo aprendido en un &6Data Model&r, y después una máquina &bsimula sus muertes&r y fabrica su botín con &cRF&r"
	]
	quest.5337FFC1C23486F0.quest_subtitle: "Granjas sin mobs"
	quest.5337FFC1C23486F0.title: "Hostile Neural Networks"
	quest.534FCDC64AFFDDDD.quest_desc: [
		"Los cajones de &bFunctional Storage&r guardan muchísimo de un solo objeto. El 1x1 guarda 32 pilas, el 1x2 16 por hueco y el 2x2 8 por hueco"
		""
		"Clic izquierdo saca 1 objeto, &2Shift + clic izquierdo&r saca una pila, clic derecho mete lo que llevas y doble clic derecho mete todo lo igual del inventario"
		""
		"Hay una versión &aenmarcada&r que se puede retexturizar"
	]
	quest.534FCDC64AFFDDDD.quest_subtitle: "Almacenar a lo grande"
	quest.534FCDC64AFFDDDD.title: "Cajones"
	quest.536A93A61A04D7D8.quest_desc: [
		"La armadura de &bArs Nouveau&r aumenta la regeneración de &dmaná&r. Cada nivel añade más ranuras para hilos y de mayor potencia"
		""
		"Se mejora en el Enchanting Apparatus, de un conjunto al siguiente"
	]
	quest.536A93A61A04D7D8.quest_subtitle: "Túnicas con poder"
	quest.536A93A61A04D7D8.title: "Armadura arcana"
	quest.53872D33322AAD30.quest_desc: [
		"El &aAbsorption Hopper&r &baspira objetos y experiencia&r en un área de 7x7x7 y los manda a cofres y tanques"
		""
		"El &aItem Collector&r de &aJust Dire Things&r hace lo mismo con los objetos"
	]
	quest.53872D33322AAD30.quest_subtitle: "Que no se pierda nada"
	quest.53872D33322AAD30.title: "Recoger el botín"
	quest.53917693958B8DE7.quest_desc: [
		"Todas las máquinas de &aCreate&r funcionan con &brotación&r, y la rotación hay que generarla"
		""
		"Al inicio tienes la &6manivela&r, y después &bruedas hidráulicas&r y &bmolinos de viento&r, &acada fuente da cierta velocidad y capacidad de estrés&r"
		""
		"&6Con esa rotación moverás prensas, mezcladoras, taladros, cintas&r y casi todo lo que trae el mod"
	]
	quest.53917693958B8DE7.quest_subtitle: "Todo empieza girando"
	quest.53917693958B8DE7.title: "Generar rotación"
	quest.53EC87B7E48261A8.quest_desc: [
		"La &aAtomic Alloy&r se hace infusionando &bobsidiana refinada&r en una &aReinforced Alloy&r"
		""
		"Es la aleación de más alto nivel, la piden el &6Ultimate Control Circuit&r y lo mejor de &aMekanism&r"
	]
	quest.53EC87B7E48261A8.quest_subtitle: "La aleación más fuerte"
	quest.53EC87B7E48261A8.title: "Atomic Alloy"
	quest.53F1509EC27515E6.quest_desc: [
		"El conjunto de &bSacerdote&r potencia los hechizos de &asagrada&r, la escuela de magia que más rinde con él"
		""
		"Pulsa &2R&r sobre el objeto para ver cómo conseguirlo"
	]
	quest.53F1509EC27515E6.quest_subtitle: "Pieza 3 de 4"
	quest.540DDD0D2F9D399B.quest_desc: [
		"El conjunto de &bSacerdote&r potencia los hechizos de &asagrada&r, la escuela de magia que más rinde con él"
		""
		"Pulsa &2R&r sobre el objeto para ver cómo conseguirlo"
	]
	quest.540DDD0D2F9D399B.quest_subtitle: "Pieza 4 de 4"
	quest.540F5D2ACC1B7564.quest_desc: ["El &bStorage Terminal&r muestra el contenido de toda la red en una lista con buscador y orden. Saca y mete objetos desde ahí, sin recorrer cofres"]
	quest.540F5D2ACC1B7564.quest_subtitle: "Todo en una pantalla"
	quest.540F5D2ACC1B7564.title: "Terminal de almacenamiento"
	quest.541265AD1A0F876E.quest_desc: ["El glifo de &bArs Elemental&r lanza un proyectil con trayectoria curva, ideal para alcanzar objetivos tras un obstáculo"]
	quest.541265AD1A0F876E.quest_subtitle: "Disparo en arco"
	quest.541265AD1A0F876E.title: "Arc Projectile"
	quest.54178EFB4D34CDDE.quest_desc: [
		"El &bNovice Spell Book&r se fabrica con un libro y una pala, un pico, un hacha y una espada de hierro"
		""
		"Con él en la mano, pulsa &2C&r para abrir la creación de hechizos. Un libro guarda hasta 10 hechizos"
		""
		"{image:undercraft:textures/questpics/ars/spellbook_gui.png width:200 height:150 align:center click_action:none:}"
	]
	quest.54178EFB4D34CDDE.quest_subtitle: "Tu primera herramienta mágica"
	quest.54178EFB4D34CDDE.title: "Libro de hechizos"
	quest.54BDCC5333EE38AD.quest_desc: [
		"El cuarto jefe es &6Eldorath&r, el antiguo constructor, y se invoca con la &bBuilder Stone&r"
		""
		"Su invocador necesita un &bdiamante enriquecido&r, que se hace en la &aEnrichment Chamber&r de &aMekanism&r"
		""
		"Por eso esta ruta pasa por &aMekanism&r, &bprimero osmio, después acero, las máquinas y al final el diamante enriquecido&r, &6sigue las misiones vinculadas&r"
	]
	quest.54BDCC5333EE38AD.quest_subtitle: "Cuarto jefe"
	quest.54BDCC5333EE38AD.title: "Eldorath, el constructor"
	quest.54CAF777FC6A1D71.quest_desc: ["El &bice spell book&r (libro congelado) potencia los hechizos de &ahielo&r"]
	quest.54CAF777FC6A1D71.quest_subtitle: "Magia de hielo"
	quest.54CAF777FC6A1D71.title: "Libro de hielo"
	quest.54EC3268C43FA78C.quest_desc: [
		"Los &btomos de casco, peto, grebas y botas&r son libros que solo aceptan encantamientos válidos para esa pieza de armadura"
		""
		"Útiles para guardar encantamientos concretos y aplicarlos después sin perder nada"
	]
	quest.54EC3268C43FA78C.quest_subtitle: "Para cada pieza"
	quest.54EC3268C43FA78C.title: "Tomos de armadura"
	quest.556E5C291CA2A19A.quest_desc: [
		"Entrega &a5 &7bloques de hierro&r&r de una vez y recibe &625 monedas&r en tu cartera"
		""
		"Es la versión por lote de la venta de uno en uno, para vaciar el almacén más rápido"
	]
	quest.556E5C291CA2A19A.quest_subtitle: "25 monedas"
	quest.556E5C291CA2A19A.title: "Vender hierro x5"
	quest.55FAB3991D9B2E63.quest_desc: [
		"Todo gran viaje empieza igual: con un golpe a un árbol"
		""
		"Consigue madera. Sirve cualquier tronco, sea de roble, de abedul o de un árbol de otro mod"
		""
		"Este capítulo es la &6Fase 1: El Despertar&r. Aquí aprenderás lo básico y te prepararás para tu primer gran enemigo"
	]
	quest.55FAB3991D9B2E63.quest_subtitle: "Todo empieza con un árbol"
	quest.55FAB3991D9B2E63.title: "El inicio"
	quest.56C5ADD931393657.quest_desc: [
		"Al inicio, el &aXP Tome&r y el &aTome of Peritia&r te dejan &bguardar tu experiencia en un libro&r y sacarla cuando la necesites"
		""
		"Más adelante, el &aExperience Holder&r de &aJust Dire Things&r &batrae y guarda los orbes cercanos&r, y el &aXP Drain Singularity Tank&r de &aMob Grinding Utils&r la guarda como &dexperiencia líquida&r"
	]
	quest.56C5ADD931393657.quest_subtitle: "Ni un punto perdido"
	quest.56C5ADD931393657.title: "Guardar experiencia"
	quest.56FD1631974BF1CA.quest_desc: [
		"La &dwater essence&r se prepara en la cámara de imbuición con una gema de Source y objetos como cubos de agua, bloques de nieve o algas"
		""
		"Se usa en glifos de agua y frío"
	]
	quest.56FD1631974BF1CA.quest_subtitle: "Fluidez"
	quest.56FD1631974BF1CA.title: "Esencia de agua"
	quest.57293DDB1D41A4DD.quest_desc: [
		"Con &bFunctional Armor Trims&r, los adornos de armadura (trims) dejan de ser solo estéticos: el &amaterial&r del trim da un efecto, siempre que lleves el &aset completo&r con ese mismo material"
		""
		"&6Oro:&r los piglins no te atacan. &6Hierro:&r puede anular proyectiles y los escudos no tienen enfriamiento. &6Cobre:&r atraes rayos y tu siguiente golpe hace doble daño. &6Diamante:&r la armadura se rompe y lanza una onda de choque cuando recibirías un golpe mortal. &6Netherite:&r inmunidad al retroceso"
		""
		"&6Amatista:&r ves a las entidades cercanas a través de las paredes. &6Redstone:&r los bloques que pisas emiten señal. &6Esmeralda:&r los cofres de botín dan más. &6Cuarzo:&r las pociones y la comida duran y alimentan más. &6Lapislázuli:&r ganas más experiencia. &6Resina:&r te agarras a las paredes al agacharte"
		""
		"Los trims se aplican en la mesa de herrería con una &aplantilla&r de trim, un material y la pieza de armadura. Recuerda que el efecto requiere las &acuatro piezas&r con el mismo material"
	]
	quest.57293DDB1D41A4DD.quest_subtitle: "Cada material, un poder"
	quest.57293DDB1D41A4DD.title: "Trims funcionales"
	quest.5738D14599C83B39.quest_desc: ["El nivel máximo de herramientas y armas. El arco tiene 4 ranuras de poción, y con la mejora de martillo minas un área de 7x7"]
	quest.5738D14599C83B39.quest_subtitle: "Lo máximo"
	quest.5738D14599C83B39.title: "Herramientas de eclipse"
	quest.5759915E4C25F430.quest_desc: ["Las mejoras del almacén le añaden funciones, como filtros, hornos o automatización. Cada una ocupa una ranura, así que los niveles altos te dan más margen"]
	quest.5759915E4C25F430.quest_subtitle: "Funciones extra"
	quest.5759915E4C25F430.title: "Mejoras de almacén"
	quest.57ED07D85C7A4817.quest_desc: [
		"Las runas van en anillos alrededor del altar y le dan mejoras:"
		""
		"&bVelocidad&r: &6+20%&r de velocidad de crafteo"
		"&bAceleración&r: el altar mueve fluidos y carga con más frecuencia"
		"&bCapacidad&r: &6+20%&r de EV en la cuenca"
		"&bCapacidad aumentada&r: &6+7,5%&r extra, se aplica al final"
		"&bCarga&r: guarda EV de reserva mientras el altar está libre y lo usa al craftear"
		"{@pagebreak}"
		"&bSacrificio&r: &6+10%&r de EV de los mobs que mueren cerca"
		"&bAutosacrificio&r: &6+10%&r de EV de tu propia sangre"
		"&bDesplazamiento&r: &6+20%&r de velocidad al mover fluidos"
		"&bOrbe&r: &6+2%&r de capacidad del orbe que esté en el altar"
		""
		"Cada tier pide más runas, la imagen las muestra"
		"{@pagebreak}"
		"{image:undercraft:textures/questpics/neo_vitae/runes_per_tier.png width:200 height:130 align:center click_action:none:}"
	]
	quest.57ED07D85C7A4817.quest_subtitle: "Mejoras del altar"
	quest.582299D7839B6E04.quest_desc: [
		"La &bTabula Vitae&r es la mesa donde se hacen los &breactivos&r de los sigilos y la &btiza&r para dibujar arrays"
		""
		"Con un orbe dentro gasta el EV de tu &dAnima&r. También procesa minerales para sacar el doble"
		"{@pagebreak}"
		"Es el primer paso hacia los &cespíritus&r: desde aquí sigues con las dagas"
	]
	quest.582299D7839B6E04.quest_subtitle: "Mesa de alquimia"
	quest.58339C65E8A4C8A2.quest_desc: [
		"Los &aDimensional Chests&r y &aDimensional Tanks&r se conectan por &bfrecuencias&r, todos los que tengan la misma frecuencia &bcomparten su contenido&r, sin importar la distancia o la dimensión"
		""
		"Cambia la frecuencia en la configuración del cofre o tanque y elige quién puede usarlos, &7todos&r o &bsolo tú&r"
	]
	quest.58339C65E8A4C8A2.quest_subtitle: "Almacenamiento a distancia"
	quest.58339C65E8A4C8A2.title: "Contenedores dimensionales"
	quest.5865D3F651449A20.quest_desc: [
		"Elimina &c100 creepers&r"
		""
		"&aSe puede repetir&r: cada vez que la completes ganas &650 monedas&r más, así que es una buena forma de &afarmear dinero&r"
	]
	quest.5865D3F651449A20.quest_subtitle: "50 monedas"
	quest.5865D3F651449A20.title: "Cazador de creepers IV"
	quest.5869890E4C99F6D5.quest_desc: [
		"La tabula de este tier del altar"
		""
		"Se usa para la gema de espíritu &bGreater&r y para el &bSpirit Accumulator&r, que guarda &61.000 espíritus&r de un solo aspecto"
	]
	quest.5869890E4C99F6D5.quest_subtitle: "Tabula"
	quest.58A945E978135EDA.quest_desc: [
		"&bShield Expansion&r cambia los escudos: hay varios materiales y se pueden usar con técnica"
		""
		"Si levantas el escudo justo antes de recibir un golpe, haces un &aparry&r: rechazas a los atacantes cuerpo a cuerpo y desvías los proyectiles. Un parry bien hecho evita el enfriamiento del escudo"
		""
		"También puedes embestir con él. Los escudos mejores pegan más, pero dejan menos margen para el parry. El de madera es solo el principio"
	]
	quest.58A945E978135EDA.quest_subtitle: "Bloquea, desvía, contraataca"
	quest.58A945E978135EDA.title: "Escudos con carácter"
	quest.58AA3D6517D78E6C.quest_desc: [
		"Para vencer al &9Kraken&r, primero &aderrota sus tentáculos&r"
		""
		"&cEl cuerpo a cuerpo es casi imposible&r, así que las &barmas a distancia&r son una buena opción"
		"{@pagebreak}"
		"Cuando los tentáculos caigan, &aenfréntate a él cara a cara&r"
	]
	quest.58AA3D6517D78E6C.quest_subtitle: "Primero los tentáculos"
	quest.58AA3D6517D78E6C.title: "Vencer al Kraken"
	quest.58FF1F1F3C274198.quest_desc: [
		"&bBetter Combat&r cambia el combate: cada arma tiene su propia animación, su alcance y, en algunos casos, combos de varios golpes"
		""
		"Las armas golpean lo que realmente atraviesan, las de dos manos ocupan la mano secundaria y el combate con dos armas alterna cada mano. Si mantienes pulsado el ataque, seguirás golpeando en cuanto se recargue"
		""
		"Pruébalas en un entrenamiento antes de salir a pelear: el ritmo de cada arma se nota"
	]
	quest.58FF1F1F3C274198.quest_subtitle: "Cada arma, su estilo"
	quest.590B5C7A22211D88.quest_desc: [
		"Paga &680 monedas&r y recibe &bun Data Model al azar&r de &aHostile Neural Networks&r, de los mobs más comunes"
		""
		"Se puede comprar de nuevo &7cada 6 horas&r"
	]
	quest.590B5C7A22211D88.quest_subtitle: "Un modelo al azar"
	quest.590B5C7A22211D88.title: "Data Model básico"
	quest.591EF284DA1890B5.quest_desc: [
		"El &bStorage Lectern&r es el centro de tu almacén: ve, ordena y fabrica con varios inventarios a la vez, hasta 30 bloques a la redonda"
		""
		"Enlaza los cofres con la &bDominion Wand&r (primero el inventario, luego el atril). Los inventarios con nombre aparecen como pestañas"
	]
	quest.591EF284DA1890B5.quest_subtitle: "Un almacén con magia"
	quest.591EF284DA1890B5.title: "Storage Lectern"
	quest.5924FF4A3B414984.quest_desc: [
		"El &bRitual of Containment&r captura a una criatura cercana y la guarda en una jarra de contención. Las criaturas y las jarras deben estar a menos de 3 bloques del brasero"
		""
		"Para capturar más de un mob por tableta, es necesario tener jarros con &dsource&r"
		"{@pagebreak}"
	]
	quest.5924FF4A3B414984.quest_subtitle: "Atrapa a tu ganado"
	quest.5924FF4A3B414984.title: "Ritual de contención"
	quest.5970480EF756A533.quest_desc: ["Clic izquierdo dispara un portal azul y clic derecho uno naranja. Jugadores y objetos pasan de uno a otro. Ideal para moverse por tu base"]
	quest.5970480EF756A533.quest_subtitle: "Atajos por todas partes"
	quest.5970480EF756A533.title: "Portal Gun"
	quest.597326A0270B7C71.quest_desc: [
		"Un hechizo siempre empieza con una &aforma&r, que define cómo se lanza: &aProjectile&r, &aSelf&r, &aTouch&r, &aUnderfoot&r o &aPantomime&r"
		""
		"Después van los efectos, que se resuelven en orden, y los aumentos, que modifican el glifo que tienen a la izquierda"
	]
	quest.597326A0270B7C71.quest_subtitle: "Cómo se lanza un hechizo"
	quest.597326A0270B7C71.title: "Glifos de forma"
	quest.59EF383841C2A8BB.quest_desc: ["El paxel de eclipse se fabrica a partir de las herramientas de eclipse, o mejorando el de celestigem con la plantilla"]
	quest.59EF383841C2A8BB.quest_subtitle: "La herramienta definitiva"
	quest.59EF383841C2A8BB.title: "Paxel de eclipse"
	quest.5A2EAE8CAE54EA74.quest_desc: [
		"Con el &6Coloso de Hierro&r derrotado, &aya puedes picar hierro&r"
		""
		"Busca &fmenas de hierro&r, recoge el mineral en bruto y fúndelo en un horno, &bcon los lingotes harás herramientas, armadura, máquinas&r y casi todo lo que viene en esta fase"
		""
		"&6Aprovéchalo bien&r, el hierro es el material estrella de la &6Expansión&r"
	]
	quest.5A2EAE8CAE54EA74.quest_subtitle: "Por fin, hierro"
	quest.5A2EAE8CAE54EA74.title: "El hierro"
	quest.5A7AC2CEF6E441FF.quest_desc: [
		"En la &bgem cutting table&r mejoras la &arareza&r de una gema usando &apolvo de gema&r y los materiales de rareza de &bApotheosis&r"
		""
		"A mayor rareza, más fuertes son los bonos. Merece la pena guardar gemas buenas para mejorarlas"
	]
	quest.5A7AC2CEF6E441FF.quest_subtitle: "Sube la rareza"
	quest.5A7AC2CEF6E441FF.title: "Mesa de corte de gemas"
	quest.5A946028E44A30EE.quest_desc: ["El &bItem Filter&r tiene 9 huecos, en modo permitir o denegar. El &bPolymorphic&r solo deja lo que ya hay en el inventario destino y el &bTag&r filtra por etiqueta"]
	quest.5A946028E44A30EE.quest_subtitle: "Que entre lo que quieras"
	quest.5A946028E44A30EE.title: "Filtros"
	quest.5ACD1018BA723553.quest_desc: [
		"Entrega &a5 &abloques de esmeralda&r&r de una vez y recibe &650 monedas&r en tu cartera"
		""
		"Es la versión por lote de la venta de uno en uno, para vaciar el almacén más rápido"
	]
	quest.5ACD1018BA723553.quest_subtitle: "50 monedas"
	quest.5ACD1018BA723553.title: "Vender esmeralda x5"
	quest.5ACE0E18392B3C2A.quest_desc: [
		"Las &bEnergy Cells&r guardan &cRF&r. Cuanto mayor es su nivel, mayor su capacidad. Pueden conectarse a una Ender Cell"
		""
		""
		"{image:powah:textures/gui/book/images/energy_cell.png width:150 height:100 align:center}"
	]
	quest.5ACE0E18392B3C2A.quest_subtitle: "Baterías grandes"
	quest.5ACE0E18392B3C2A.title: "Energy Cell"
	quest.5AE18D25440CC0E3.quest_desc: ["La &bFrontier spawner upgrade rune&r mejora las estadísticas máximas del spawner. Va ligada al World Tier: &6Frontier&r"]
	quest.5AE18D25440CC0E3.quest_subtitle: "Mejora de Frontera"
	quest.5AF238D15DF606FD.quest_desc: ["Elimina &c25 creepers&r"]
	quest.5AF238D15DF606FD.quest_subtitle: "15 monedas"
	quest.5AF238D15DF606FD.title: "Cazador de creepers II"
	quest.5B2D14E9A4327568.quest_desc: [
		"El &bDrygmy Charm&r invoca a los drygmies, criaturas que producen recursos a partir de las criaturas que tienen cerca"
		""
		"Los detalles y cómo montar una granja están en el capítulo de &aDrygmies&r"
	]
	quest.5B2D14E9A4327568.quest_subtitle: "Obreros del Source"
	quest.5B2D14E9A4327568.title: "Drygmy"
	quest.5BB2F0F426D1C695.quest_desc: [
		"La versión mejorada de cada runa: &aduplica su efecto&r, por ejemplo &6+40%&r de velocidad en lugar de +20%"
		""
		"Se fabrican con &bnetherite scrap&r y &bpiezas intrincadas de hellforged&r, así que tendrás que esperar a tiers más altos"
		""
		"El &bAthanor&r puede revertirlas a su versión base"
	]
	quest.5BB2F0F426D1C695.quest_subtitle: "Se hacen más adelante"
	quest.5BCEAC1878412EBE.quest_desc: ["La &baugmenting table&r permite &aaumentar&r las propiedades de un objeto con los sigilos y materiales de rareza adecuados"]
	quest.5BCEAC1878412EBE.quest_subtitle: "Mejora tu equipo"
	quest.5BCEAC1878412EBE.title: "Mesa de aumento"
	quest.5BEDC8202274CD0D.quest_desc: [
		"Con el &6Goblin Lord&r derrotado, &aya puedes picar oro&r"
		""
		"Recoge el &eoro en bruto&r y fúndelo en el horno, &bparece un metal blando&r, pero en este modpack fue reforzado para que valga la pena"
	]
	quest.5BEDC8202274CD0D.quest_subtitle: "El brillo de la victoria"
	quest.5BEDC8202274CD0D.title: "El oro"
	quest.5BF799A8D6A13F0F.quest_desc: [
		"En el servidor tienes algunos &acomandos&r para moverte más fácil"
		""
		"&e/rtp&r te lleva a un &bpunto al azar del mundo&r, ideal para buscar un lugar nuevo. Se puede usar cada &610 minutos&r"
		""
		"&e/back&r te devuelve al lugar donde &cmoriste&r o desde donde te teletransportaste"
		"{@pagebreak}"
		"&e/sethome <nombre>&r guarda tu posición como una &acasa&r, puedes tener hasta &62&r"
		""
		"&e/home <nombre>&r te lleva de vuelta a esa casa"
		"{@pagebreak}"
		"&e/tpa <jugador>&r pide permiso para &bteletransportarte hasta otro jugador&r"
		""
		"&e/tpahere <jugador>&r pide que &botro jugador venga hasta ti&r"
		""
		"El otro jugador acepta la petición con &e/tpaccept&r"
	]
	quest.5BF799A8D6A13F0F.quest_subtitle: "Muévete por el mundo"
	quest.5BF799A8D6A13F0F.title: "Comandos útiles"
	quest.5C111EDD09D8ECEA.quest_desc: [
		"El &7Andesite Casing&r se hace dando clic derecho con un &7andesite alloy&r sobre madera sin corteza, &ay es la base de las primeras máquinas&r"
		""
		"También sirve para &bcubrir ejes y engranajes&r y que tu fábrica se vea más ordenada"
	]
	quest.5C111EDD09D8ECEA.quest_subtitle: "Un toque de estilo"
	quest.5C111EDD09D8ECEA.title: "Andesite Casing"
	quest.5C3273B7B8E71008.quest_desc: [
		"Las máquinas de este modpack no se alimentan solas: usan &cRF&r (Redstone Flux), la energía del pack. Hay que &agenerarla&r, &aalmacenarla&r y &atransportarla&r hasta cada máquina"
		""
		"Encontrarás varias formas de producirla, cada una con su propio capítulo: &bPowah&r (generadores, celdas y reactores), &bMekanism Generators&r, &bJust Dire Things&r (generadores y combustibles) e &bIron Furnaces&r (hornos que generan energía)"
		""
		"Empieza por algo sencillo, como un generador, y crece con el tiempo. Cuanto más avances, más energía vas a necesitar"
	]
	quest.5C3273B7B8E71008.quest_subtitle: "Todo funciona con RF"
	quest.5C85306290F4AF12.quest_desc: [
		"El &aCrusher&r tritura lingotes y otros objetos en &bpolvo&r, y lo necesitarás para varias recetas"
		""
		"También es un paso de la &dtriplicación de minerales&r, ahí convierte los &7clumps&r en &7dirty dust&r"
	]
	quest.5C85306290F4AF12.quest_subtitle: "Todo se vuelve polvo"
	quest.5C85306290F4AF12.title: "Crusher"
	quest.5CA09BDA1B28039C.quest_desc: [
		"El conjunto de &bCaminante de sombras&r potencia los hechizos de &aender&r, la escuela de magia que más rinde con él"
		""
		"Pulsa &2R&r sobre el objeto para ver cómo conseguirlo"
	]
	quest.5CA09BDA1B28039C.quest_subtitle: "Pieza 2 de 4"
	quest.5CACF91AF0A8F7E9.quest_desc: ["El &bblaze spell book&r potencia los hechizos de &afuego&r. Lo sueltan los blazes con poca probabilidad"]
	quest.5CACF91AF0A8F7E9.quest_subtitle: "Magia de fuego"
	quest.5CACF91AF0A8F7E9.title: "Manual del blaze"
	quest.5CB3933EAE432CEB.quest_desc: ["Elimina &c25 zombis&r"]
	quest.5CB3933EAE432CEB.quest_subtitle: "15 monedas"
	quest.5CB3933EAE432CEB.title: "Cazador de zombis II"
	quest.5DF2C26E10695246.quest_desc: [
		"Así activarás los rituales, pero necesitan una cierta cantidad de &dAnima&r"
		""
		"Usa el cristal en la mano para &bvincularlo a tu Anima&r antes de activar. Se fabrica en el altar a partir de un &bcristal de lava&r"
	]
	quest.5DF2C26E10695246.quest_subtitle: "Cristal de activación"
	quest.5E135F1B58D8FCF4.quest_desc: [
		"&aCrafting On A Stick&r te deja llevar &bestaciones de trabajo en el bolsillo&r, como la mesa de crafteo, el yunque o el cortapiedras"
		""
		"Se abren directo desde la mano, &aasí te ahorras espacio en la base y viajes de vuelta a casa&r"
	]
	quest.5E135F1B58D8FCF4.quest_subtitle: "Craftea donde sea"
	quest.5E135F1B58D8FCF4.title: "Mesas portátiles"
	quest.5E3CD5C3FBDF56F4.quest_desc: [
		"El conjunto de &bPlagado&r potencia los hechizos de &anaturaleza&r, la escuela de magia que más rinde con él"
		""
		"Pulsa &2R&r sobre el objeto para ver cómo conseguirlo"
	]
	quest.5E3CD5C3FBDF56F4.quest_subtitle: "Pieza 2 de 4"
	quest.5E99387CFAF15E99.quest_desc: [
		"El &aSolar Generator&r produce &bRF gratis mientras haya sol&r, sin combustible ni mantenimiento"
		""
		"&cSolo funciona de día y con el cielo libre encima&r, de noche no genera nada y con lluvia mucho menos, así que conviene tener algo donde guardar la energía"
	]
	quest.5E99387CFAF15E99.quest_subtitle: "Energía del cielo"
	quest.5E99387CFAF15E99.title: "Solar Generator"
	quest.5EE8CF46501E9762.quest_desc: [
		"Pon una &bcubeta&r vacía en el altar cuando tenga al menos &61.000 EV&r y se llenará"
		""
		"&c1 EV&r equivale a &61 mB&r"
	]
	quest.5EE8CF46501E9762.quest_subtitle: "Sangre en cubeta"
	quest.5EFD4D12B3BCF187.quest_desc: [
		"Esto que estás leyendo es &bFTB Quests&r, tu libro de misiones y la guía del modpack"
		""
		"Ábrelo cuando quieras con &2O&r o con el libro que llevas encima"
		""
		"Cada círculo es una misión. Haz clic para ver qué pide y sigue las líneas: marcan qué debes completar antes de pasar a la siguiente"
		""
		"Casi siempre basta con &atener el objeto en el inventario&r; normalmente no se gasta. Si la misión ofrece recompensa, haz clic en ella para reclamarla"
	]
	quest.5EFD4D12B3BCF187.quest_subtitle: "Tu libro de viaje"
	quest.5EFD4D12B3BCF187.title: "¿Qué es FTB Quests?"
	quest.5F0519727483EF87.quest_desc: [
		"Coloca el &5Ender Inhibitor&r, el &aAbsorption Hopper&r y &aalmacenamiento&r para la experiencia y los ítems, y configura el hopper para que &bguarde ítems&r"
		""
		"{image:undercraft:textures/questpics/grinding_utils/mob_farm_setup_step_8.png width:200 height:175 align:center click_action:none:}"
		"{@pagebreak}"
		"Configura el &aExperience Holder&r para que esté en el &bradio correcto&r y recoja la experiencia, los números del radio son los mismos, pero &cel offset cambia según cada granja&r"
		""
		"{image:undercraft:textures/questpics/grinding_utils/mob_farm_setup_step_9.png width:180 height:120 align:center click_action:none:}"
	]
	quest.5F0519727483EF87.quest_subtitle: "Ítems y experiencia"
	quest.5F0519727483EF87.title: "Recoger y guardar"
	quest.5F2DF403B8CAC9E7.quest_desc: ["La &bbeeshelf&r, la &bmelonshelf&r y la &bstoneshelf&r son estanterías sencillas que aportan estadísticas distintas a las de libros. Son útiles si buscas ajustar tu mesa con precisión"]
	quest.5F2DF403B8CAC9E7.quest_subtitle: "Toma el control"
	quest.5F2DF403B8CAC9E7.title: "Estanterías especiales"
	quest.5F79C70A6BC6DF66.quest_desc: [
		"Entre esmeraldas y furia, Arion gobierna una tierra verde que nadie se atreve a cuestionar, &chasta ahora&r"
		""
		"Es &aArion&r, tirano de la ira esmeralda y tercer jefe de &aArmageddon&r, consigue el &aEmerald Totem&r, invócalo y prepárate, &cno es un rival de un solo golpe&r"
		"{@pagebreak}"
		"Al vencerlo recibirás un logro de &aArmageddon&r y &adesbloquearás las esmeraldas&r y su equipo"
		""
		"También se abre &aMekanism&r, &bya puedes conseguir osmio&r"
	]
	quest.5F79C70A6BC6DF66.quest_subtitle: "Tercer jefe"
	quest.5F79C70A6BC6DF66.title: "Arion, el tirano"
	quest.60003643F1FDAB9B.quest_desc: [
		"Las &bcadenas de spawner&r se obtienen &ahaciendo explotar un spawner con TNT&r. La explosión lo destruye, pero deja una o más cadenas"
		""
		"Se usan junto a otros materiales para fabricar las runas de mejora, así que vale la pena sacrificar algún spawner"
	]
	quest.60003643F1FDAB9B.quest_subtitle: "Para mover un spawner"
	quest.60003643F1FDAB9B.title: "Spawner chain"
	quest.601DE64C07C12879.quest_desc: ["El &bpyrium staff&r es el bastón de la escuela de &afuego&r"]
	quest.601DE64C07C12879.quest_subtitle: "Magia de fuego"
	quest.601DE64C07C12879.title: "Bastón de pirio"
	quest.6020373B8DD614E4.quest_desc: [
		"La configuración básica de siempre, una mesa con estanterías a su alrededor, sigue siendo el punto de partida. Pero con &bApotheosis&r es solo el principio"
		""
		"Los bloques deben estar a una distancia concreta de la mesa, con un hueco de aire entre medias. Con 15 estanterías de libros llegas al nivel 30, el máximo clásico; para ir más lejos necesitas estanterías mejores"
	]
	quest.6020373B8DD614E4.quest_subtitle: "Solo el comienzo"
	quest.6020373B8DD614E4.title: "La mesa de encantamientos"
	quest.607D0F294927DF23.quest_desc: [
		"La &dmanipulation essence&r se prepara en la cámara de imbuición con una gema de Source y objetos como botones de piedra, redstone o un reloj"
		""
		"Es la esencia de los hechizos que mueven y alteran las cosas. También entra en la tableta del ritual de contención"
	]
	quest.607D0F294927DF23.quest_subtitle: "Control"
	quest.607D0F294927DF23.title: "Esencia de manipulación"
	quest.609690EFA85A1CE6.quest_desc: ["El &baliento de dragón infundido&r (infused breath) se fabrica infundiendo aliento del dragón. Es el ingrediente para las estanterías del End"]
	quest.609690EFA85A1CE6.title: "Aliento infundido"
	quest.60A3C60050B1A774.quest_desc: ["Las &barcane sands&r son el &amaterial de rareza épica&r. Se obtienen desmontando equipo épico"]
	quest.60A3C60050B1A774.quest_subtitle: "Material de nivel 4"
	quest.60A3C60050B1A774.title: "Arenas arcanas"
	quest.60D7D6CAEE297040.quest_desc: [
		"Los &6Mechanical Crafters&r, juntos en una cuadrícula, &bautomatizan cualquier receta de crafteo&r, incluso las más grandes"
		""
		"Con la &bllave&r cambias la dirección de cada uno, &ctodos tienen que terminar llevando los objetos a un mismo crafter de salida&r"
	]
	quest.60D7D6CAEE297040.quest_subtitle: "Crafteo en cadena"
	quest.60D7D6CAEE297040.title: "Crafter mecánico"
	quest.610F05524B87F985.quest_desc: ["Los &bEnder Drawers&r con la misma frecuencia comparten su contenido. Copia una frecuencia con clic izquierdo de la herramienta de enlace y aplícala con clic derecho"]
	quest.610F05524B87F985.quest_subtitle: "Un cajón compartido"
	quest.610F05524B87F985.title: "Ender Drawer"
	quest.6119C6E2FE10C324.quest_desc: [
		"Cuando consigas el logro &6Overworld Conqueror&r de &aArmageddon&r habrás demostrado que dominas el Overworld"
		""
		"Con este logro &6se desbloquea el Nether&r, &bya puedes encender un portal y entrar a explorar&r"
		""
		"&cPero no te confíes&r, allá abajo todo es mucho más peligroso"
	]
	quest.6119C6E2FE10C324.quest_subtitle: "El Nether te espera"
	quest.6119C6E2FE10C324.title: "Conquistador del Overworld"
	quest.612FA454026B890F.quest_desc: [
		"La &bmysterious scrap metal&r es el &amaterial de rareza común&r. Se obtiene desmontando equipo común en la &bSalvaging table&r"
		""
		"También se usa para fabricar tinta común en el &bcaldero de Iron's Spellbooks&r"
	]
	quest.612FA454026B890F.quest_subtitle: "Material de nivel 1"
	quest.612FA454026B890F.title: "Chatarra misteriosa"
	quest.6151538DE57504EC.quest_desc: ["El &bgem case&r guarda gemas en un único objeto. Con él se acabó el inventario lleno de piedras"]
	quest.6151538DE57504EC.quest_subtitle: "Un sitio para tus gemas"
	quest.6151538DE57504EC.title: "Estuche de gemas"
	quest.618F2AF86CD8F6B2.quest_desc: [
		"Paga &6250 monedas&r y recibe &bun Data Model al azar&r de &aHostile Neural Networks&r, de mobs más difíciles, &cincluso jefes como el Wither o el Warden&r"
		""
		"Se puede comprar de nuevo &7cada 12 horas&r"
	]
	quest.618F2AF86CD8F6B2.quest_subtitle: "Un modelo al azar"
	quest.618F2AF86CD8F6B2.title: "Data Model avanzado"
	quest.619E592A731B89E3.quest_desc: [
		"En el orbe de energía fabricas el &aenergized steel&r (hierro y oro) y los cristales: blazing (polvo de blaze), niotic (diamante), spirited (esmeralda) y nitro (estrella del Nether)"
		""
		"Cuestan mucha &cenergía&r, sobre todo los más raros"
	]
	quest.619E592A731B89E3.quest_subtitle: "Cristales y acero"
	quest.619E592A731B89E3.title: "Materiales de Powah"
	quest.61C5C578379FF2E7.quest_desc: [
		"Muestra lo mismo que el sigilo de Divination, y además el &bprogreso del crafteo&r, el EV que gasta por tick y el que guardan en reserva las runas de Carga"
		""
		"Llevarlo también marca el alcance de los &brituales&r en el mundo"
	]
	quest.61C5C578379FF2E7.quest_subtitle: "Información extra del altar"
	quest.61D21D3365C4A05D.quest_desc: ["La &becho sculkshelf&r llega a nivel 80 y usa drops del Warden"]
	quest.61D21D3365C4A05D.title: "Sculkshelf resonante"
	quest.622D09AD01FB0458.quest_desc: [
		"Los glifos de nivel 3 son los más poderosos: teletransporte, rayos, invocación de no muertos y vexes, muros, y varios efectos de &bArs Elemental&r"
		""
		"Exigen un libro superior y mucho maná, así que prepárate bien"
	]
	quest.622D09AD01FB0458.quest_subtitle: "El techo de la magia"
	quest.622D09AD01FB0458.title: "Efectos de nivel 3"
	quest.6246F821CD5E8D9D.quest_desc: ["Úsalo sobre una fábrica &aavanzada&r para subirla a &belite&r, que procesa &b7 objetos a la vez&r"]
	quest.6246F821CD5E8D9D.quest_subtitle: "Fábrica nivel 3"
	quest.6246F821CD5E8D9D.title: "Elite Tier Installer"
	quest.62524BAD68A6FB52.quest_desc: [
		"Los filtros de &bArs Elemental&r limitan sobre qué entidades actúa tu hechizo: aéreas, acuáticas, de fuego, insectos, invocaciones o no muertos, y sus versiones inversas"
		""
		"Muy útiles para no herir a tus propias invocaciones"
	]
	quest.62524BAD68A6FB52.quest_subtitle: "Apunta mejor"
	quest.62524BAD68A6FB52.title: "Filtros"
	quest.625DEFAE14D8FB63.quest_desc: [
		"El &aConfigurator&r cambia &bqué entra y qué sale por cada lado&r de una máquina, haz clic derecho en una cara para cambiarla"
		""
		"Tiene &dvarios modos&r, para objetos, fluidos, gases y energía, además de vaciar y rotar máquinas, &6revisa la tecla de cambio de modo en Opciones > Controles&r"
	]
	quest.625DEFAE14D8FB63.quest_subtitle: "Tú decides cada lado"
	quest.625DEFAE14D8FB63.title: "Configurator"
	quest.6260B15077C14027.quest_desc: [
		"La &aPrediction Matrix&r es lo que gasta la &aSimulation Chamber&r en cada simulación"
		""
		"&6Ten siempre un buen montón&r, porque sin ellas la cámara se detiene"
	]
	quest.6260B15077C14027.quest_subtitle: "El combustible"
	quest.6260B15077C14027.title: "Prediction Matrix"
	quest.628EC141CF69BA84.quest_desc: [
		"La &btiza&r (Arcane Scribe Tool) dibuja los &barrays de alquimia&r donde se crean los sigilos"
		""
		"Un array acepta dos ofrendas: algunas combinaciones fabrican objetos y otras provocan efectos al instante"
	]
	quest.628EC141CF69BA84.quest_subtitle: "Arrays de alquimia"
	quest.62EC611FA230F605.quest_desc: [
		"Apúntalo al aire y verás cuánto &dAnima&r tienes. Apuntando al &cAra Vitae&r te muestra su &btier&r, el EV que tiene y su capacidad máxima"
		""
		"Con &bShift + clic derecho&r editas dónde sale la información en pantalla"
	]
	quest.62EC611FA230F605.quest_subtitle: "Información del altar"
	quest.62FB087D7A2AD28B.quest_desc: [
		"El &bSource Relay&r mueve Source de una jarra a otra, hasta 30 bloques. Enlázalo con la &bDominion Wand&r: primero la jarra, después el relé"
		""
		"El &bRelay Splitter&r reparte a varias jarras a la vez, con mucha más capacidad de transferencia. Una señal de redstone los desactiva"
	]
	quest.62FB087D7A2AD28B.quest_subtitle: "Source a distancia"
	quest.62FB087D7A2AD28B.title: "Relés"
	quest.6300982E3D0E32C3.quest_desc: [
		"Con los &bladrillos de sangre&r ya puedes mejorar el altar: van en las &6cuatro esquinas&r del tier 3"
		""
		"Se hacen con &bfragmentos de sangre débiles&r, que sacas refinando &btau saturado&r en el &bAthanor&r"
	]
	quest.6300982E3D0E32C3.quest_subtitle: "Materiales del tier 3"
	quest.6312C66C077AA132.quest_desc: [
		"El encantamiento de &dcapturing&r va en la espada: cuando matas un mob, tienes una probabilidad de que suelte su &ahuevo de spawn&r. Cuanto más nivel, más probabilidad"
		""
		"Con el huevo puedes cambiar el tipo de mob de un spawner"
	]
	quest.6312C66C077AA132.quest_subtitle: "Huevos de spawn por caza"
	quest.6312C66C077AA132.title: "Capturing"
	quest.63D53B8B06659EF4.quest_desc: [
		"La &bImbuement Chamber&r transforma materiales con &dSource&r. Con lapislázuli o un fragmento de amatista obtienes una &dSource Gem&r"
		""
		"Toma el Source de las jarras que tenga a menos de 2 bloques. Más adelante verás cómo llenarlas"
		"{@pagebreak}"
		"{image:undercraft:textures/questpics/ars/source_gem_example.png width:100 height:120 align:center click_action:none:}"
	]
	quest.63D53B8B06659EF4.quest_subtitle: "Dar forma a la magia"
	quest.63D53B8B06659EF4.title: "Cámara de imbuición"
	quest.63DB933AAEE8D186.quest_desc: [
		"Para recoger un spawner necesitas un objeto encantado con &dSilk Touch&r. Sin él, el spawner se rompe y se pierde"
		""
		"Ten uno a mano antes de entrar a una mazmorra"
	]
	quest.63DB933AAEE8D186.quest_subtitle: "Silk Touch es la llave"
	quest.640597C3B0499EB1.quest_desc: [
		"El &aXP Drain Singularity Tank&r guarda la experiencia como &dexperiencia líquida&r, perfecto para tus &bprimeras cubetas&r"
		""
		"Para la granja, el &aExperience Holder&r de &aJust Dire Things&r es la mejor opción, &batrae y guarda la experiencia&r de todo lo que muere cerca"
	]
	quest.640597C3B0499EB1.quest_subtitle: "Ni un punto perdido"
	quest.640597C3B0499EB1.title: "Experiencia de la granja"
	quest.6464EDF5E9D093D4.quest_desc: [
		"Las &bcabezas&r, como la de esqueleto, esqueleto wither, creeper, zombi o piglin, aportan &aQuanta&r a la mesa si las colocas a su alrededor"
		""
		"Úsalas con cuidado: más quanta significa más variación en el resultado, y no siempre a tu favor sin estabilidad"
	]
	quest.6464EDF5E9D093D4.quest_subtitle: "Quanta para tu mesa"
	quest.6464EDF5E9D093D4.title: "Cabezas y calaveras"
	quest.64A90D3813BDD72B.quest_desc: [
		"El &aModel Framework&r es un modelo en blanco, &bdale clic derecho a un mob&r y se convierte en su &6Data Model&r"
		""
		"Ponlo en el &aDeep Learner&r para empezar a entrenarlo"
	]
	quest.64A90D3813BDD72B.quest_subtitle: "La base de un modelo"
	quest.64A90D3813BDD72B.title: "Model Framework"
	quest.65040646A5CF6BBC.quest_desc: ["Estos libros potencian una &aescuela de magia&r concreta, además de dar ranuras. Algunos se fabrican y otros se consiguen derrotando a ciertos enemigos o comerciando"]
	quest.65040646A5CF6BBC.quest_subtitle: "Cada uno potencia una magia"
	quest.65040646A5CF6BBC.title: "Libros de escuela"
	quest.6508D4CFFAF62051.quest_desc: [
		"La &bsalvaging table&r sirve para &adesmontar equipo y gemas&r y recuperar los materiales con que se hicieron"
		""
		"Es la principal forma de conseguir los materiales de rareza: hierro viejo, tela, cristales y más. Pon el objeto, rómpelo y recoge el resultado"
	]
	quest.6508D4CFFAF62051.quest_subtitle: "Rompe y recupera"
	quest.6508D4CFFAF62051.title: "Mesa de recuperación"
	quest.6569D80976813D4D.quest_desc: [
		"En la &bAlteration Table&r pones hilos (&athreads&r) en tu armadura mágica. Coloca la pieza en el soporte y usa el hilo sobre la tableta"
		""
		"Un hilo solo se aplica una vez por conjunto. Para quitarlo, mano vacía sobre el soporte"
	]
	quest.6569D80976813D4D.quest_subtitle: "Personaliza tu armadura"
	quest.6569D80976813D4D.title: "Mesa de alteración"
	quest.6613DD7A238AC0B8.quest_desc: [
		"El &3Ancient Prism&r es un material soltado por el &bElder Guardian&r al morir"
		""
		"Es uno de los materiales para crear el &5ojo del abismo&r"
	]
	quest.6613DD7A238AC0B8.quest_subtitle: "Restos del guardián"
	quest.662E15BBF56FFCAA.quest_desc: [
		"Las &bvelas&r colocadas alrededor de la mesa de encantamientos aportan &aArcana&r. Más velas apiladas, más Arcana"
		""
		"Es la forma más barata de conseguir encantamientos más raros"
	]
	quest.662E15BBF56FFCAA.quest_subtitle: "Arcana para tu mesa"
	quest.662E15BBF56FFCAA.title: "Velas"
	quest.6665CA4C5022776D.quest_desc: [
		"La gema de espíritu &bCommon&r necesita esta tabula, un &bdiamante&r y un &bbloque de oro&r"
		""
		"Pasa de 256 a &61.024&r de capacidad"
	]
	quest.6665CA4C5022776D.quest_subtitle: "Gema 3 de 5"
	quest.6686A958BE585D3C.quest_desc: ["El &bdiamond spell book&r tiene más ranuras y bastante más &amaná máximo&r"]
	quest.6686A958BE585D3C.quest_subtitle: "Aún más capacidad"
	quest.6686A958BE585D3C.title: "Libro de diamante"
	quest.6690E87F7BAD6905.quest_desc: ["El &bblazegold&r sale del goo de nivel 2. Se funde en lingotes y da lugar a un equipo más resistente, que además se repara dejándolo en lava"]
	quest.6690E87F7BAD6905.quest_subtitle: "Oro del Nether"
	quest.6690E87F7BAD6905.title: "Blazegold"
	quest.66C00490C9A444B5.quest_desc: [
		"Necesita una &bTabula Spiritus&r, un &bfragmento de sangre débil&r y un &bcristal de espíritu&r"
		""
		"La capacidad sube a &64.096&r"
	]
	quest.66C00490C9A444B5.quest_subtitle: "Gema 4 de 5"
	quest.66C9446663B656AC.quest_desc: [
		"Hay muchos tipos de gemas y cada una afecta a &aatributos distintos&r: velocidad, daño, resistencia, vida, suerte y otros"
		""
		"Antes de engastar una, mira su tooltip con el objeto en la mano para saber qué te va a dar exactamente"
	]
	quest.66C9446663B656AC.quest_subtitle: "Cada una, un atributo"
	quest.66C9446663B656AC.title: "Tipos de gemas"
	quest.66E648EA7811E258.quest_desc: [
		"Las &dinfusiones&r transforman un bloque o un objeto en una versión mejor usando la mesa de encantamientos. Para hacerlo, tu mesa debe cumplir unos rangos concretos de &aEterna&r, &aQuanta&r y &aArcana&r"
		""
		"Cada infusión pide sus propios valores: pulsa &2R&r sobre el objeto para ver qué estadísticas necesita y prepara tu mesa antes de intentarlo"
		""
		"Así se fabrican las estanterías infundidas, las bibliotecas y otros materiales avanzados"
	]
	quest.66E648EA7811E258.quest_subtitle: "Mejora tus estanterías"
	quest.66E648EA7811E258.title: "Infusiones"
	quest.66EE314706555625.quest_desc: ["El &bdruidic spell book&r potencia los hechizos de &anaturaleza&r. Se fabrica a partir de un libro podrido"]
	quest.66EE314706555625.quest_subtitle: "Magia de naturaleza"
	quest.66EE314706555625.title: "Tomo druida"
	quest.66F5FF0ED4CF18C4.quest_desc: [
		"El &aUltimate Control Circuit&r junta un &aElite&r con &aAtomic Alloy&r, &bel circuito más alto de Mekanism&r"
		""
		"Con él fabricas lo mejor del mod, desde las fábricas &6ultimate&r hasta los cables más rápidos"
	]
	quest.66F5FF0ED4CF18C4.quest_subtitle: "Circuito nivel 4"
	quest.66F5FF0ED4CF18C4.title: "Ultimate Control Circuit"
	quest.673EF8907D8C42FE.quest_desc: ["La &barcane essence&r es el material mágico básico de &bIron's Spellbooks&r. Se usa para fabricar tela mágica y varios libros de hechizos"]
	quest.673EF8907D8C42FE.quest_subtitle: "El polvo de la magia"
	quest.673EF8907D8C42FE.title: "Esencia arcana"
	quest.674816DDBA4AA655.quest_desc: ["El &btrim&r es un bloque decorativo que también conduce la conexión. Útil para enmarcar tu sala de almacenes sin cables a la vista"]
	quest.674816DDBA4AA655.quest_subtitle: "Marco con función"
	quest.674816DDBA4AA655.title: "Trim"
	quest.67DF91436DDA37B1.quest_desc: ["El &bblood vial&r es el foco de la escuela de &asangre&r"]
	quest.67DF91436DDA37B1.quest_subtitle: "Foco de sangre"
	quest.67DF91436DDA37B1.title: "Vial de sangre"
	quest.68061E52CD4114CA.quest_desc: ["El &bblood staff&r es el bastón de la escuela de &asangre&r"]
	quest.68061E52CD4114CA.quest_subtitle: "Magia de sangre"
	quest.68061E52CD4114CA.title: "Bastón de sangre"
	quest.68223362A2101BD1.quest_desc: [
		"El &dTotem of Death Recall&r de &aJust Dire Things&r &bte permite volver al lugar donde moriste&r, muy útil cuando caes lejos de casa"
		""
		"&6Además es uno de los ingredientes del ojo&r que te guía a la morada del jefe, y se fabrica con &6blazegold&r"
	]
	quest.68223362A2101BD1.quest_subtitle: "Volver de la muerte"
	quest.68DDA6B1C767F190.quest_desc: [
		"La &bInscription Table&r es donde pasas los hechizos de tus pergaminos a las ranuras del &alibro de hechizos&r"
		""
		"Cuantas más ranuras tenga el libro, más hechizos podrás llevar. Elige bien: solo puedes lanzar los que tengas inscritos y equipados"
	]
	quest.68DDA6B1C767F190.quest_subtitle: "Pon tus hechizos en el libro"
	quest.68DDA6B1C767F190.title: "Mesa de inscripción"
	quest.6919564BBDEFF84E.quest_desc: ["Elimina &c25 esqueletos&r"]
	quest.6919564BBDEFF84E.quest_subtitle: "15 monedas"
	quest.6919564BBDEFF84E.title: "Cazador de esqueletos II"
	quest.6A2D4D42AC31B497.quest_desc: ["En la mesa de herrería, el equipo de blazegold, esta plantilla y celestigem dan el equipo de &bcelestigem&r"]
	quest.6A2D4D42AC31B497.quest_subtitle: "Otro nivel"
	quest.6A2D4D42AC31B497.title: "Plantilla de celestigem"
	quest.6A37AB944F2C87FF.quest_desc: [
		"El conjunto de &bPiromante&r potencia los hechizos de &afuego&r, la escuela de magia que más rinde con él"
		""
		"Pulsa &2R&r sobre el objeto para ver cómo conseguirlo"
	]
	quest.6A37AB944F2C87FF.quest_subtitle: "Pieza 2 de 4"
	quest.6A4C567E807B3EAB.quest_desc: [
		"El &bFurnator&r quema combustible sólido, como carbón o madera, y produce &cRF&r. Los de nivel alto lo consumen más rápido"
		""
		""
		"{image:powah:textures/gui/book/images/furnator.png width:150 height:100 align:center}"
	]
	quest.6A4C567E807B3EAB.quest_subtitle: "Quema lo que tengas"
	quest.6A4C567E807B3EAB.title: "Furnators"
	quest.6A4CD1AA72EE1F35.quest_desc: [
		"La rotación &bviaja por ejes y engranajes&r, y &aun engranaje grande junto a uno pequeño cambia la velocidad&r, la duplica o la reduce a la mitad"
		""
		"Las &6cintas&r conectan dos ejes a distancia y además &btransportan objetos&r, y las &6Chain Conveyors&r llevan la rotación de un lugar a otro con cadenas"
		""
		"&cCuidado con mezclar direcciones&r, si dos fuentes giran en sentidos contrarios en la misma red, se rompe"
	]
	quest.6A4CD1AA72EE1F35.quest_subtitle: "Lleva la fuerza a donde la necesitas"
	quest.6A4CD1AA72EE1F35.title: "Transportar rotación"
	quest.6B56D5F1A3D31C90.quest_desc: [
		"Para &boutput&r: mete objetos, fluidos o energía en el bloque de al lado, con un filtro por cada cara"
		""
		"Las caras vienen apagadas hasta que las actives"
	]
	quest.6B56D5F1A3D31C90.quest_subtitle: "Nodo de salida"
	quest.6B6A59A096F6A617.quest_desc: ["La &bBasic Inventory Hopper&r toma objetos de los inventarios y los lleva a la red. Combínala con un filtro para decidir qué entra"]
	quest.6B6A59A096F6A617.quest_subtitle: "Mete todo en la red"
	quest.6B6A59A096F6A617.title: "Tolva de inventario"
	quest.6BE56D0CD5451F5A.quest_desc: ["Elimina &c50 creepers&r"]
	quest.6BE56D0CD5451F5A.quest_subtitle: "25 monedas"
	quest.6BE56D0CD5451F5A.title: "Cazador de creepers III"
	quest.6BF1BA8364EB4861.quest_desc: [
		"Los &aEnergy Cubes&r &balmacenan energía&r para cuando tus generadores no den abasto, como los solares de noche"
		""
		"Hay cuatro niveles, &7Basic&r, &aAdvanced&r, &bElite&r y &6Ultimate&r, cada uno guarda bastante más que el anterior"
		""
		"Usa el &aConfigurator&r para elegir &apor qué lado entra y por cuál sale&r la energía"
	]
	quest.6BF1BA8364EB4861.quest_subtitle: "Guarda tu energía"
	quest.6BF1BA8364EB4861.title: "Energy Cubes"
	quest.6BF66A4C47B86610.quest_desc: [
		"Entrega &a5 pergaminos&r de &aIron's Spellbooks&r que no uses y recibe &buna tinta al azar&r, las de mayor rareza salen menos"
		""
		"Se puede canjear de nuevo &7cada hora&r"
	]
	quest.6BF66A4C47B86610.quest_subtitle: "Pergaminos por tinta"
	quest.6BF66A4C47B86610.title: "Tintas de Iron's Spellbooks"
	quest.6C5082F7C532986F.quest_desc: [
		"Algunos comandos para distintos teleport a través del mundo son:"
		""
		"&2/spawn&r te lleva al spawn del mundo"
		""
		"&2/rtp&r te hace teleport a algún lado del mundo"
		""
		"&2/back&r te devuelve hacia tu último teleport, útil cuando mueres"
	]
	quest.6C5082F7C532986F.quest_subtitle: "Moverse por el mundo"
	quest.6C7710E0D38A9F31.quest_desc: [
		"La &aSimulation Chamber&r usa un &6Data Model&r, una &aPrediction Matrix&r y &cRF&r para &bsimular una pelea&r contra ese mob"
		""
		"Si la simulación sale bien, fabrica una &dPrediction&r, que después se convierte en botín"
	]
	quest.6C7710E0D38A9F31.quest_subtitle: "Donde se simula la muerte"
	quest.6C7710E0D38A9F31.title: "Simulation Chamber"
	quest.6C886D98CA565E69.quest_desc: [
		"El &bRitual Brazier&r ejecuta rituales. Colócalo, usa una tableta de ritual sobre él y actívalo con la mano vacía. Toma Source de las jarras a menos de 6 bloques"
		""
		"Algunos rituales sencillos son el del &aAmanecer&r y el de la &aCaída de la Luna&r, que cambian la hora del día"
		"{@pagebreak}"
		"{image:undercraft:textures/questpics/ars/brazier.png width:50 height:150 align:center click_action:none:}"
	]
	quest.6C886D98CA565E69.quest_subtitle: "Magia a gran escala"
	quest.6C886D98CA565E69.title: "Ritual Brazier"
	quest.6CB0D4A3EAE7A334.quest_desc: ["La &bglowing hellshelf&r y la &bblazing hellshelf&r son versiones especializadas de la línea del Nether, con estadísticas adicionales"]
	quest.6CB0D4A3EAE7A334.title: "Hellshelf brillante y ardiente"
	quest.6D33CC8289D22C4C.quest_desc: [
		"La &danima essence&r llega con el addon &bSauce&r. Se prepara por imbuición, como las demás, aunque es más rara y cuesta más Source"
		""
		"Consulta su receta exacta con &2R&r sobre el objeto"
	]
	quest.6D33CC8289D22C4C.quest_subtitle: "Una esencia especial"
	quest.6D33CC8289D22C4C.title: "Esencia de ánima"
	quest.6D39537A2B737A73.quest_desc: [
		"El ritual &cWell Of Suffering&r cosecha &cEV&r del sufrimiento de las criaturas cercanas y es vital para aumentar la sangre que recolecta el altar"
		""
		"Las &bbrujas&r son el mob ideal para esto"
		"{@pagebreak}"
		"Ejemplo de montaje con el ritual sobre el altar y con brujas"
		""
		"{image:undercraft:textures/questpics/neo_vitae/well_of_suffering_setup.png width:180 height:170 align:center click_action:none:}"
	]
	quest.6D39537A2B737A73.title: "Well Of Suffering"
	quest.6D6AF5D6B1A3210A.quest_desc: ["La &bvara de blaze&r es el foco de la escuela de &afuego&r"]
	quest.6D6AF5D6B1A3210A.quest_subtitle: "Foco de fuego"
	quest.6D6AF5D6B1A3210A.title: "Vara de blaze"
	quest.6D97491D34D8D8A3.quest_desc: [
		"La &bScroll Forge&r fabrica &apergaminos&r de hechizos. Necesita tres cosas: &atinta&r (la rareza decide el nivel del hechizo), &apapel&r y un &afoco&r, un objeto propio de cada escuela de magia"
		""
		"Elige el hechizo que quieras, ponle los materiales y recibirás el pergamino"
	]
	quest.6D97491D34D8D8A3.quest_subtitle: "Crea tus propios hechizos"
	quest.6D97491D34D8D8A3.title: "Forja de pergaminos"
	quest.6DEE323E88E42B46.quest_desc: ["Igual que en las mochilas, la base de mejoras es el ingrediente común de las mejoras para almacenes"]
	quest.6DEE323E88E42B46.quest_subtitle: "Para el almacén"
	quest.6DEE323E88E42B46.title: "Base de mejoras"
	quest.6E15DC416F2ABB6E.quest_desc: [
		"Estos aumentos añaden área de efecto, aceleración, mayor duración, perforación, fortuna y más"
		""
		"Cada uno cuesta maná. Elige con cuidado para que tu hechizo no se quede sin recursos"
	]
	quest.6E15DC416F2ABB6E.quest_subtitle: "Más opciones"
	quest.6E15DC416F2ABB6E.title: "Aumentos avanzados"
	quest.6E3B4542CE03407F.quest_desc: [
		"Las &6armas medianas&r son &bmás lentas que las ligeras pero más rápidas que las pesadas&r, y se usan &ca dos manos&r"
		""
		"&aSon un buen balance entre daño y velocidad&r, sirven para casi cualquier pelea"
		""
		"Las de &fhierro&r son tu primera opción de este tipo"
	]
	quest.6E3B4542CE03407F.quest_subtitle: "El punto medio"
	quest.6E3B4542CE03407F.title: "Armas medianas de hierro"
	quest.6E471C403D0B7A2B.quest_desc: [
		"Los hechizos se crean en el libro (&2C&r) combinando glifos. Siempre empiezan con una &aforma&r, seguida de efectos y aumentos"
		""
		"Cada glifo cuesta maná, y los de nivel alto necesitan un libro de nivel superior"
		""
		"&eConsejo:&r prueba tus combinaciones en un lugar seguro antes de salir a pelear"
		"{@pagebreak}"
		"{image:undercraft:textures/questpics/ars/scribes_table_floating_items.png width:130 height:120 align:center click_action:none:}"
	]
	quest.6E471C403D0B7A2B.quest_subtitle: "Construye tu hechizo"
	quest.6E522075EC0CE17D.quest_desc: [
		"Para ver los rituales disponibles y construirlos"
		""
		"Apunta a la &bpiedra maestra&r y usa para colocar las piedras que falten. Con &bShift&r y clic cambias de ritual"
	]
	quest.6E522075EC0CE17D.quest_subtitle: "Ritual Diviner"
	quest.6E78D3B3BC1E1C60.quest_desc: ["La mejora de &arecolector&r recoge objetos del suelo. Las de &aextracción&r y &aempuje&r mueven objetos entre el cajón y los inventarios de al lado"]
	quest.6E78D3B3BC1E1C60.quest_subtitle: "Automatización"
	quest.6E78D3B3BC1E1C60.title: "Mejoras de utilidad III"
	quest.6EED4ED9C014841C.quest_desc: [
		"Un bloque de amatista pasa a ser un &dSource Gem Block&r en la cámara de imbuición, con mucho más Source"
		""
		"Es un ingrediente clave para relés y para casi toda la logística de Source que viene después"
	]
	quest.6EED4ED9C014841C.quest_subtitle: "Magia concentrada"
	quest.6EED4ED9C014841C.title: "Bloque de gemas de Source"
	quest.6F343BB72F83E665.quest_desc: ["La &bsightshelf&r aporta &apistas&r (clues): con más pistas ves más encantamientos en la vista previa antes de elegir. Hay una versión de segundo nivel que da todavía más"]
	quest.6F343BB72F83E665.quest_subtitle: "Más pistas"
	quest.6F343BB72F83E665.title: "Sightshelf"
	quest.6F51547147211084.quest_desc: [
		"El &6Precision Mechanism&r se fabrica con &bensamblaje secuencial&r, una cadena de pasos sobre una lámina de oro usando deployers y prensas"
		""
		"&cCada intento tiene probabilidad de fallar&r y darte chatarra, así que conviene automatizarlo"
		""
		"&aEs la base de las máquinas de latón más avanzadas&r"
	]
	quest.6F51547147211084.quest_subtitle: "Pieza clave"
	quest.6F51547147211084.title: "Mecanismo de precisión"
	quest.6F86DACABFFE8032.quest_desc: [
		"La &bspike trap&r sirve para &aautomatizar la recolección de sangre&r: los mobs que mueren cerca del altar le dan &cEV&r, y las runas de Sacrificio aumentan ese aporte"
		""
		"Un spawner basta para empezar, la imagen muestra un ejemplo de montaje"
		""
		"{@pagebreak}"
		"{image:undercraft:textures/questpics/neo_vitae/blood_automation_setup_2.png width:120 height:230 align:center click_action:none:}"
	]
	quest.6F86DACABFFE8032.title: "Automatizar sangre"
	quest.6F9B0C2D70D88DF3.quest_desc: [
		"Aquí puedes ver &bdónde está el botón para silenciar sonidos&r"
		""
		"{image:undercraft:textures/questpics/grinding_utils/mob_farm_setup_step_10.png width:110 height:110 align:center click_action:none:}"
		"{@pagebreak}"
		"Crea un &aanchor&r, ajusta el &bradio&r y silencia los sonidos que quieras, o bien &asilencia todos los sonidos&r dentro del radio establecido"
		""
		"{image:undercraft:textures/questpics/grinding_utils/mob_farm_setup_step_11.png width:200 height:120 align:center click_action:none:}"
	]
	quest.6F9B0C2D70D88DF3.quest_subtitle: "Que no se oiga todo el día"
	quest.6F9B0C2D70D88DF3.title: "Silenciar la granja"
	quest.6FF8487B6EDC7947.quest_desc: [
		"La &eSnad&r de &aUtilitarian&r es una arena especial: la &acaña de azúcar y los cactus crecen más rápido&r encima de ella"
		""
		"La &cRed Snad&r funciona igual, y la &5Soul Snad&r hace lo mismo con la &cverruga del Nether&r"
	]
	quest.6FF8487B6EDC7947.quest_subtitle: "Cultivos más rápidos"
	quest.700851B208307A8E.quest_desc: [
		"Los enemigos golpeados por dagas sueltan &cespíritus&r al morir"
		""
		"Se guardan en una &bgema de espíritu&r, que además recoge los que haya sueltos cerca. Con ellos alimentas la &bHellfire Forge&r"
	]
	quest.700851B208307A8E.quest_subtitle: "Spiritus"
	quest.700851B208307A8E.title: "Espíritus"
	quest.708BDC9AE757447C.quest_desc: ["Úsalo sobre una fábrica &7básica&r para subirla a &aavanzada&r, que procesa &b5 objetos a la vez&r"]
	quest.708BDC9AE757447C.quest_subtitle: "Fábrica nivel 2"
	quest.708BDC9AE757447C.title: "Advanced Tier Installer"
	quest.70AA0212CBDE01D7.quest_desc: [
		"El centro de cada ritual, solo puede haber &buna&r por ritual"
		""
		"Cuando el ritual esté formado, usa sobre ella el &bcristal de activación&r para ponerlo en marcha"
	]
	quest.70AA0212CBDE01D7.quest_subtitle: "Piedra maestra"
	quest.70E00AD2C9B9CAB6.quest_desc: [
		"Lo que necesitarás para mejorar tu altar al tier 2"
		""
		"El &bcristal manchado de sangre&r corona los cuatro pilares. Si lo pones justo debajo del altar, un comparador lee el Anima del dueño del orbe"
	]
	quest.70E00AD2C9B9CAB6.quest_subtitle: "Materiales del tier 2"
	quest.718D9EB429DEDCD3.quest_desc: [
		"La semilla de &amagebloom&r se fabrica en el Enchanting Apparatus y no cuesta Source. La flor da fibra de magebloom, y una sola flor da cuatro"
		""
		"También potencia a los sourcelinks agronómicos que tengas cerca"
	]
	quest.718D9EB429DEDCD3.quest_subtitle: "La flor de la magia"
	quest.718D9EB429DEDCD3.title: "Magebloom"
	quest.7192A8F51A5F0094.quest_desc: [
		"La &aDis-Enchanting Table&r pasa los &dencantamientos&r de un objeto a un libro, &bel objeto sigue sirviendo&r, solo que sin ellos"
		""
		"Perfecta cuando consigues buen equipo con el encantamiento equivocado, o para &asalvar un encantamiento raro&r antes de cambiar de arma, &caunque cada uso cuesta niveles de experiencia&r"
	]
	quest.7192A8F51A5F0094.quest_subtitle: "Rescata tus encantamientos"
	quest.7192A8F51A5F0094.title: "Mesa de desencantamiento"
	quest.71B72BBA26CD4282.quest_desc: [
		"El &aJetpack&r te deja &bvolar libremente&r, va en el pecho y gasta &bhidrógeno&r"
		""
		"Llénalo en un &aChemical Tank&r o en el &aElectrolytic Separator&r, y cambia su modo entre &7normal&r, &7suspendido&r y apagado con la tecla de modo de armadura"
		""
		"&cOcupa el lugar del peto&r, por eso la versión &aArmored&r también te da armadura"
	]
	quest.71B72BBA26CD4282.quest_subtitle: "A volar"
	quest.71B72BBA26CD4282.title: "Jetpack"
	quest.720C74DBF959FA2C.quest_desc: ["Estas mejoras generan recursos solos: la de &agoteo&r produce lava, la de &agua&r produce agua sin parar y la de &aobsidiana&r va generando obsidiana poco a poco"]
	quest.720C74DBF959FA2C.quest_subtitle: "Recursos infinitos"
	quest.720C74DBF959FA2C.title: "Mejoras de utilidad II"
	quest.723778268D30A7D7.quest_desc: [
		"Los &aControl Circuits&r son el cerebro de las máquinas de &aMekanism&r, y hay &bcuatro niveles&r"
		""
		"El &7Basic&r se hace con osmio y redstone en la &aMetallurgic Infuser&r, cada nivel siguiente &bse fabrica con el anterior y una aleación&r: infused, reinforced y atomic"
		""
		"Mientras más alto el circuito, &amejores las máquinas, cables y cubos de energía&r que puedes fabricar"
	]
	quest.723778268D30A7D7.quest_subtitle: "Circuito nivel 1"
	quest.723778268D30A7D7.title: "Basic Control Circuit"
	quest.728DCE0F77B1AAA1.quest_desc: ["La &bcrystal seashelf&r y la &bheart seashelf&r son versiones especializadas de la línea marina. Aportan estadísticas extra además de eterna"]
	quest.728DCE0F77B1AAA1.title: "Seashelf cristalina y de corazón"
	quest.729C765EC24BB223.quest_desc: ["El &bArmory Cabinet&r guarda armas, armaduras y herramientas, objetos que no se apilan, hasta 4096 de ellos"]
	quest.729C765EC24BB223.quest_subtitle: "Para lo que no se apila"
	quest.729C765EC24BB223.title: "Armory Cabinet"
	quest.72E18C47BF229C37.quest_desc: [
		"Con &aArion&r derrotado, &aya puedes picar esmeraldas&r"
		""
		"Con ellas puedes fabricar herramientas y armadura de &aesmeralda&r de &aPickle Tweaks&r, &bmejor que la Gilded en durabilidad y defensa&r, &caunque todavía por debajo del diamante&r"
	]
	quest.72E18C47BF229C37.quest_subtitle: "Verde como la victoria"
	quest.72E18C47BF229C37.title: "Las esmeraldas"
	quest.72E83051FA059A19.quest_desc: [
		"Con el &3Ancient Prism&r y la &5obsidiana llorona&r ya puedes fabricar el &9Abyss Eye&r"
		""
		"&aLánzalo y te guiará hasta la Ciudad Hundida&r, encuéntrala para completar esta misión"
	]
	quest.72E83051FA059A19.quest_subtitle: "Rumbo a la Ciudad Hundida"
	quest.72E83051FA059A19.title: "El ojo del abismo"
	quest.7300EE2BFED8471E.quest_desc: ["Úsalo sobre una fábrica &belite&r para subirla a &6ultimate&r, que procesa &b9 objetos a la vez&r, &ael máximo de Mekanism&r"]
	quest.7300EE2BFED8471E.quest_subtitle: "Fábrica nivel 4"
	quest.7300EE2BFED8471E.title: "Ultimate Tier Installer"
	quest.730EDDC262425B04.quest_desc: [
		"El &bThermo Generator&r se coloca sobre un bloque caliente, como la lava, y necesita un fluido refrigerante, como el agua, para producir &cRF&r"
		""
		""
		"{image:powah:textures/gui/book/images/thermo_generator.png width:150 height:100 align:center}"
	]
	quest.730EDDC262425B04.quest_subtitle: "Calor y refrigerante"
	quest.730EDDC262425B04.title: "Termogeneradores"
	quest.7335644ECBBB3CC5.quest_desc: ["Hay libros que no encajan en ninguna línea: el podrido, el netherite o el necronomicón. Cada uno tiene su propio origen y sus bonos"]
	quest.7335644ECBBB3CC5.quest_subtitle: "Libros especiales"
	quest.7335644ECBBB3CC5.title: "Otros libros"
	quest.735693B80D762F42.quest_desc: [
		"Las &aarmas ligeras&r son &brápidas y se usan con una sola mano&r, pegan menos por golpe pero atacan muchísimo más seguido"
		""
		"&aComo usan una mano, puedes llevar una en cada mano y combinarlas&r, o acompañarlas con un escudo"
		""
		"Las de &fhierro&r son las primeras que podrás fabricar, &6perfectas para empezar a probar estilos&r"
	]
	quest.735693B80D762F42.quest_subtitle: "Rápidas y a una mano"
	quest.735693B80D762F42.title: "Armas ligeras de hierro"
	quest.737109362484E526.quest_desc: ["El &bluminous crystal shard&r es el &amaterial de rareza rara&r. Se obtiene desmontando equipo de esa rareza"]
	quest.737109362484E526.quest_subtitle: "Material de nivel 3"
	quest.737109362484E526.title: "Fragmento de cristal luminoso"
	quest.73938103206E3149.quest_desc: [
		"Un &aPaxel&r junta &bpico, hacha y pala en una sola herramienta&r, así liberas espacio en tu barra"
		""
		"Hay paxeles de varios materiales, &aasí que van mejorando junto a tu equipo&r, revisa el capítulo de cada fase para ver cuál te toca"
	]
	quest.73938103206E3149.quest_subtitle: "Tres herramientas en una"
	quest.73938103206E3149.title: "Paxeles"
	quest.7407AEF93A4D5DEB.quest_desc: [
		"Mientras no tengas otra fuente de rotación, la &6Manivela&r te sirve, &bmantén clic derecho para girarla&r, y agáchate para girarla al otro lado"
		""
		"&cGenera muy poca fuerza y te da hambre&r, así que solo sirve para lo básico"
	]
	quest.7407AEF93A4D5DEB.quest_subtitle: "A girar, que es gratis"
	quest.7407AEF93A4D5DEB.title: "Fuerza manual"
	quest.741617D0E452AEF8.quest_desc: [
		"Ahora la &5obsidiana llorona&r se puede crear con &aJust Dire Things&r, &busando una receta de catalizador&r"
		""
		"Revisa con &bR&r qué catalizador necesitas y dónde se lanza, &aes el otro material del ojo del abismo&r"
	]
	quest.741617D0E452AEF8.quest_subtitle: "Obsidiana a mano"
	quest.7423BDE66ECAEDB0.quest_desc: [
		"El conjunto de &bElectromante&r potencia los hechizos de &arayo&r, la escuela de magia que más rinde con él"
		""
		"Ideal para golpear a varios enemigos a la vez"
		""
		"Pulsa &2R&r sobre el objeto para ver cómo conseguirlo"
	]
	quest.7423BDE66ECAEDB0.quest_subtitle: "Pieza 1 de 4"
	quest.742EE01D8268E884.quest_desc: [
		"Bienvenido a la &cCacería&r: aquí se gana dinero &6cazando monstruos&r"
		""
		"Cada columna es un tipo de enemigo y cada misión pide más que la anterior. Las grandes, en forma de &ehexágono&r, se pueden &arepetir&r para seguir ganando &6monedas&r"
		""
		"Empieza por lo fácil: elimina &c10 zombis&r"
	]
	quest.742EE01D8268E884.quest_subtitle: "5 monedas"
	quest.742EE01D8268E884.title: "Cazador de zombis I"
	quest.7442685352E69E23.quest_desc: ["El &bgraybeard staff&r es el bastón más sencillo de la línea"]
	quest.7442685352E69E23.quest_subtitle: "Un bastón sencillo"
	quest.7442685352E69E23.title: "Bastón del Barbagris"
	quest.749F415E8E1ADA12.quest_desc: ["Las herramientas de &bcelestigem&r guardan &cRF&r (unos 10 000 por herramienta) en lugar de durabilidad. El arco tiene 3 ranuras de poción"]
	quest.749F415E8E1ADA12.quest_subtitle: "Poder sin desgaste"
	quest.749F415E8E1ADA12.title: "Herramientas de celestigem"
	quest.75040E22B654383A.quest_desc: ["Elimina &c25 arañas&r"]
	quest.75040E22B654383A.quest_subtitle: "15 monedas"
	quest.75040E22B654383A.title: "Cazador de arañas II"
	quest.751DA29678257A49.quest_desc: [
		"&aIron Furnaces&r reemplaza el horno clásico por &bversiones mucho más rápidas&r, desde cobre hasta netherite"
		""
		"&aCada nivel funde antes que el anterior&r, y tienen su propio capítulo en &cEnergía&r, donde verás cómo mejorarlos y darles otros usos"
	]
	quest.751DA29678257A49.quest_subtitle: "Fundir más rápido"
	quest.751DA29678257A49.title: "Hornos mejorados"
	quest.75338E38823C3C6B.quest_desc: [
		"Los &asourcelinks&r generan Source y lo mandan a las jarras cercanas. Cada uno se alimenta de algo distinto:"
		""
		"&aVolcanic&r, de combustible, como carbón"
		"&aMycelial&r, de comida, como pan"
		"&aAgronomic&r, del crecimiento de cultivos y plantas"
		"&aVitalic&r, de muertes y crías de animales y mobs"
		"&aAlchemical&r, de pociones hechas"
		""
		"Para empezar, el &aVolcanic&r y el &aMycelial&r son los más cómodos"
		"{@pagebreak}"
		"{image:undercraft:textures/questpics/ars/sourcelink_setup.png width:200 height:120 align:center click_action:none:}"
	]
	quest.75338E38823C3C6B.quest_subtitle: "De dónde sale el Source"
	quest.75338E38823C3C6B.title: "Sourcelinks"
	quest.7533964DE85D0258.quest_desc: [
		"La &aChemical Upgrade&r &breduce el gas que gastan&r las máquinas que lo consumen, como la &aPurification Chamber&r con su oxígeno"
		""
		"Así el oxígeno del &aElectrolytic Separator&r te rinde mucho más"
	]
	quest.7533964DE85D0258.quest_subtitle: "Ahorra gases"
	quest.7533964DE85D0258.title: "Chemical Upgrade"
	quest.75D409301DA25F66.quest_desc: [
		"Para tener criaturas cerca de tu drygmy necesitas el &bRitual Brazier&r de &bArs Nouveau&r. Se coloca, se usa una tableta de ritual sobre él y se activa con la mano vacía"
		""
		"El brasero toma &dSource&r de las jarras que tenga a menos de 6 bloques"
	]
	quest.75D409301DA25F66.quest_subtitle: "Para capturar criaturas"
	quest.75D409301DA25F66.title: "Ritual del brasero"
	quest.7641F93D9E57EC86.quest_desc: [
		"La &dconjuration essence&r se prepara en la cámara de imbuición con una gema de Source y objetos como el cuerno wilden, fragmentos de starbuncle o un libro"
		""
		"Se usa en glifos y objetos de invocación"
	]
	quest.7641F93D9E57EC86.quest_subtitle: "Criaturas y bestias"
	quest.7641F93D9E57EC86.title: "Esencia de conjuración"
	quest.76695AC73383E84E.quest_desc: [
		"La &aReinforced Alloy&r se hace infusionando &bdiamante&r en una &aInfused Alloy&r con la &aMetallurgic Infuser&r"
		""
		"Es el segundo nivel de aleación y la piden el &6Elite Control Circuit&r y las mejoras de nivel elite"
	]
	quest.76695AC73383E84E.quest_subtitle: "La aleación de diamante"
	quest.76695AC73383E84E.title: "Reinforced Alloy"
	quest.76A160A9012C58AD.quest_desc: [
		"&bApotheosis&r rehace la mesa de encantamientos. En lugar de solo el nivel, ahora controlas varias &aestadísticas&r, que dependen de los bloques que pongas alrededor:"
		""
		"&aEterna:&r la potencia. Cada punto sube el nivel máximo en dos, así que 50 de eterna dan nivel 100. &aQuanta:&r la variación del resultado. Alta, puede darte muy buenos resultados o muy malos. &aArcana:&r hace más probables los encantamientos raros y da más encantamientos por objeto"
		""
		"&aRectificación&r y &aestabilidad cuántica&r suavizan el lado malo del quanta: evitan que el resultado caiga por debajo del nivel base. Las &apistas&r (clues) deciden cuántos encantamientos ves en la vista previa"
	]
	quest.76A160A9012C58AD.quest_subtitle: "Una mesa mucho más profunda"
	quest.76A160A9012C58AD.title: "Encantamientos"
	quest.76BF27B122D60696.quest_desc: [
		"Olvida la progresión de siempre: aquí el mundo no se abre a quien más horas juega, sino a quien más &6jefes&r derrota"
		""
		"Cada victoria desbloquea bloques, recetas, armas, armaduras y mucho más. Lo que hoy parece prohibido mañana será tuyo"
		""
		"Mira el capítulo de cada &6fase&r para saber qué jefes te esperan y qué ganarás al vencerlos"
	]
	quest.76BF27B122D60696.quest_subtitle: "El mundo ya no se abre solo"
	quest.76BF27B122D60696.title: "Progresión bloqueada"
	quest.770C024DDE466135.quest_desc: [
		"Los efectos son lo que hace tu hechizo: romper bloques, hacer daño, encender fuego, cultivar, recoger objetos..."
		""
		"Estos son los de nivel 1, los que puedes usar con el libro novato. Cada glifo cuesta maná, y los combinas a tu gusto"
	]
	quest.770C024DDE466135.quest_subtitle: "Lo básico del arsenal"
	quest.770C024DDE466135.title: "Efectos de nivel 1"
	quest.777546DC8F368C1F.title: "Futuro..."
	quest.778CF656CA4F919A.quest_desc: [
		"Los &aaumentos&r modifican el glifo que tienen a la izquierda: potencian su efecto o cambian cómo se comporta"
		""
		"Aquí encontrarás &aAmplify&r, &aRandomize&r, &aSensitive&r y el glifo de multilanzamiento de &bReliquified Ars Nouveau&r"
	]
	quest.778CF656CA4F919A.quest_subtitle: "Afina tus hechizos"
	quest.778CF656CA4F919A.title: "Aumentos básicos"
	quest.7795CC658BB04EBA.quest_desc: [
		"Paga &650 monedas&r y recibe &buna mejora avanzada al azar&r para tus mochilas de &aSophisticated Backpacks&r"
		""
		"Se puede comprar de nuevo &7cada 30 minutos&r"
	]
	quest.7795CC658BB04EBA.quest_subtitle: "Una mejora al azar"
	quest.7795CC658BB04EBA.title: "Mejoras de mochilas"
	quest.77F3538B72C86900.quest_desc: [
		"Un detalle de comodidad: el horno de cobre de &bIron Furnaces&r funde más rápido que el horno normal"
		""
		"El mod tiene versiones aún mejores. Por ahora, este te ahorrará tiempo mientras sigues avanzando"
	]
	quest.77F3538B72C86900.quest_subtitle: "Fundir con prisa"
	quest.77F3538B72C86900.title: "Horno de cobre"
	quest.782B2382C9146BD3.quest_desc: [
		"Una mejora del diviner que abre rituales nuevos y más poderosos"
		""
		"Sus herramientas cuestan &62.000 EV&r cada una en un altar de tier 3, y es necesario para el ritual &cHighway to Hell&r"
	]
	quest.782B2382C9146BD3.quest_subtitle: "Diviner Tenebrae"
	quest.7854976A66FF85E5.quest_desc: [
		"Para llegar a la &6Cumbre&r hace falta derrotar al &6Wither&r y equipar un set completo de equipo &aRaro&r"
		""
		"Es un salto fuerte de dificultad. Llega bien equipado"
	]
	quest.7854976A66FF85E5.quest_subtitle: "Un reto de verdad"
	quest.7854976A66FF85E5.title: "World Tier: Summit"
	quest.788B9B2245CCE1AE.quest_desc: [
		"Las mejoras de armadura dan velocidad, salto, natación, visión nocturna, elytra, vuelo, inmunidad a la lava y más. Se instalan en la mesa de herrería"
		""
		"Cada pieza admite solo algunas mejoras. Con &2Shift + clic derecho&r abres los ajustes, y &2V&r las activa o desactiva"
	]
	quest.788B9B2245CCE1AE.quest_subtitle: "Más que un simple traje"
	quest.788B9B2245CCE1AE.title: "Mejoras de armadura"
	quest.78C7980E0A383020.quest_desc: [
		"El conjunto de &bCriomante&r potencia los hechizos de &ahielo&r, la escuela de magia que más rinde con él"
		""
		"Pulsa &2R&r sobre el objeto para ver cómo conseguirlo"
	]
	quest.78C7980E0A383020.quest_subtitle: "Pieza 2 de 4"
	quest.79412C1FEAA9930A.quest_desc: [
		"Necesitas &616 runas&r más para pasar del tier 1 al &6tier 2&r, en un anillo de radio 3 un nivel más abajo"
		""
		"Aquí se desbloquean los &brituales&r y se levantan cuatro pilares, uno por lado, coronados con &bcristal manchado de sangre&r"
		""
		"Puedes usar el &bScriptura Vitae&r para poder previsualizar la estructura y que sea más simple armar el altar "
		"{@pagebreak}"
		"{image:undercraft:textures/questpics/neo_vitae/tier_2_altar.png width:150 height:150 align:center click_action:none:}"
	]
	quest.79412C1FEAA9930A.title: "Altar Tier 2"
	quest.7992D4122B42DBEB.quest_desc: [
		"&aSimply Swords&r agrega &bmuchísimas armas nuevas&r, como katanas, lanzas, rapieras, guadañas, hachas grandes y martillos"
		""
		"Con &aBetter Combat&r &bcada tipo de arma tiene sus propios combos de ataque&r, y algunas tienen &defectos especiales&r como &csangrado&r, &6ignorar armadura&r o &bmás velocidad de ataque&r"
		""
		"Las armas se dividen en tres tipos, &aligeras&r, &6medianas&r y &cpesadas&r, y cada material llega con su fase, &brevisa cada misión para ver cuál va con tu estilo&r"
	]
	quest.7992D4122B42DBEB.quest_subtitle: "Más que una espada"
	quest.7992D4122B42DBEB.title: "Simply Swords"
	quest.79BA1A364B7E7417.quest_desc: [
		"La &bDominion Wand&r une tus piezas mágicas: enlaza jarras con relés y marca las rutas de los &bStarbuncles&r"
		""
		"Es una herramienta pequeña, pero la usarás en casi todas las instalaciones de Source"
	]
	quest.79BA1A364B7E7417.quest_subtitle: "El cable invisible"
	quest.79BA1A364B7E7417.title: "Dominion Wand"
	quest.79D82D9C2F333EE0.quest_desc: [
		"El &dCuarzo Rosa Pulido&r se consigue puliendo &dcuarzo rosa&r con &epapel de lija&r, &bpon el cuarzo en la otra mano y mantén clic derecho con la lija&r"
		""
		"Con el cuarzo pulido y una &7lámina de hierro&r fabricas el &dElectron Tube&r, &apieza de muchas máquinas de latón&r"
		""
		"&6También se puede automatizar con un deployer&r"
	]
	quest.79D82D9C2F333EE0.quest_subtitle: "Pulir a mano"
	quest.79D82D9C2F333EE0.title: "Cuarzo pulido"
	quest.7A00C3CF2C67B9A3.quest_desc: ["El &bvillager spell book&r (Villager Bible) potencia los hechizos &asagrados&r y reduce el tiempo de lanzamiento. Se consigue comerciando con un sacerdote"]
	quest.7A00C3CF2C67B9A3.quest_subtitle: "Magia sagrada"
	quest.7A00C3CF2C67B9A3.title: "Biblia del aldeano"
	quest.7A02B1F2B06C9721.quest_desc: [
		"La &bbiblioteca de encantamientos&r guarda libros encantados como &apuntos&r y te deja sacar cada encantamiento al nivel que necesites"
		""
		"Clic izquierdo extrae un nivel y &2Shift+clic&r extrae el máximo. Para extraer un nivel alto hay que haber metido antes uno igual o mayor"
		""
		"La &bender library&r es la versión mejorada: tiene mucha más capacidad"
	]
	quest.7A02B1F2B06C9721.quest_subtitle: "Un almacén de encantamientos"
	quest.7A02B1F2B06C9721.title: "Bibliotecas"
	quest.7A247E17C533C9E0.quest_desc: ["Se obtiene mejorando la de ferricore en la mesa de herrería. Más resistente y, al dejarla caer en lava, se repara sola"]
	quest.7A247E17C533C9E0.quest_subtitle: "Fuego domado"
	quest.7A247E17C533C9E0.title: "Armadura de blazegold"
	quest.7A2CD36F70F4DC98.quest_desc: ["La &bAscent spawner upgrade rune&r sube todavía más el techo de mejora del spawner. Va ligada al nivel de mundo &6Ascenso&r"]
	quest.7A2CD36F70F4DC98.quest_subtitle: "Mejora de Ascenso"
	quest.7A8E84C6AC30801E.quest_desc: ["El &bfragmento de eco&r es el foco de la escuela &aeldritch&r, la de los hechizos más oscuros"]
	quest.7A8E84C6AC30801E.quest_subtitle: "Foco eldritch"
	quest.7A8E84C6AC30801E.title: "Fragmento de eco"
	quest.7AD128C955988F2B.quest_desc: [
		"El &6Fluid Tank&r guarda fluidos, &bpero con quemadores de blaze debajo y un motor de vapor al lado se convierte en caldera&r"
		""
		"&aMientras más grande el tanque, más motores puede alimentar&r, siempre que tenga suficiente calor y agua"
	]
	quest.7AD128C955988F2B.quest_subtitle: "La caldera"
	quest.7ADC9846344E351D.quest_desc: [
		"&aCreate&r es el mod de las &6máquinas con engranajes&r, y todo empieza con la &7Andesite Alloy&r, el material con el que harás ejes y engranajes"
		""
		"&bSu energía es la rotación&r, que se genera, se transporta y se consume, &6revisa las misiones de alrededor&r para entender cómo funciona"
	]
	quest.7ADC9846344E351D.quest_subtitle: "Engranajes y rotación"
	quest.7ADC9846344E351D.title: "La era de andesita"
	quest.7B173B2E880965CB.quest_desc: [
		"Con la &bespada sintiente&r no dependes de las dagas para conseguir espíritus"
		""
		"Mata a la criatura directamente con ella"
	]
	quest.7B173B2E880965CB.quest_subtitle: "Espíritus sin dagas"
	quest.7B2E77D4F5BA71BD.quest_desc: [
		"Las &aFree Runners&r son botas que &bevitan el daño por caída&r gastando energía, y además te dejan &bsubir bloques sin saltar&r"
		""
		"La versión &aArmored&r también te da armadura, cárgalas con &cRF&r y cambia su modo con la tecla de modo de botas"
	]
	quest.7B2E77D4F5BA71BD.quest_subtitle: "Adiós al daño por caída"
	quest.7B2E77D4F5BA71BD.title: "Free Runners"
	quest.7B345D68AD17559E.quest_desc: [
		"Antes de que existieran los reinos, alguien levantó sus cimientos, &cy ese alguien despertó&r"
		""
		"Es &6Eldorath&r, el antiguo constructor y cuarto jefe de &aArmageddon&r, consigue la &bBuilder Stone&r, invócalo y derrótalo"
		"{@pagebreak}"
		"Al vencerlo recibirás un logro de &aArmageddon&r, &aya podrás picar diamantes&r y usar tus &dherramientas encantadas&r"
		""
		"&6Pero el camino sigue&r, todavía tienes que demostrar que dominas el Overworld"
	]
	quest.7B345D68AD17559E.quest_subtitle: "Cuarto jefe"
	quest.7B345D68AD17559E.title: "Eldorath, el antiguo constructor"
	quest.7BD2EDB48EF2EE10.quest_desc: [
		"El &6Mechanical Arm&r &bmueve objetos entre inventarios, cintas y depots&r por su cuenta"
		""
		"&aAntes de colocarlo&r, dale clic con el brazo en la mano a los puntos de entrada y salida, &bazul para tomar&r y &6amarillo para dejar&r"
	]
	quest.7BD2EDB48EF2EE10.quest_subtitle: "Logística automática"
	quest.7BD2EDB48EF2EE10.title: "Brazo mecánico"
	quest.7C025F0053F1F203.quest_desc: [
		"Las mejoras del &aMob Fan&r &bamplían su área&r, &7ancho&r y &7alto&r hasta 3, y &7distancia&r hasta 10"
		""
		"Con ellas un solo ventilador cubre toda la sala de la granja"
	]
	quest.7C025F0053F1F203.quest_subtitle: "Más alcance"
	quest.7C025F0053F1F203.title: "Mejoras del ventilador"
	quest.7C084EABFAE2211C.quest_desc: [
		"El &7Andesite Funnel&r &bmete y saca objetos&r de inventarios y cintas, el &7Andesite Tunnel&r &breparte objetos&r entre cintas conectadas y el &7Chute&r &bmueve objetos en vertical&r"
		""
		"&aCon estos tres ya puedes armar tus primeras líneas de producción&r"
	]
	quest.7C084EABFAE2211C.quest_subtitle: "Embudos, túneles y conductos"
	quest.7C084EABFAE2211C.title: "Mover objetos"
	quest.7C16CEC6AFE513DA.quest_desc: ["Todo empieza con un cofre o barril de madera. Con una mejora de nivel se convierte en su versión de &bSophisticated Storage&r"]
	quest.7C16CEC6AFE513DA.quest_subtitle: "El punto de partida"
	quest.7C16CEC6AFE513DA.title: "Cofre y barril"
	quest.7C2D268709583624.quest_desc: ["La &bSummit spawner upgrade rune&r amplía otra vez el límite de mejoras. Va ligada al nivel de mundo &6Cumbre&r"]
	quest.7C2D268709583624.quest_subtitle: "Mejora de Cumbre"
	quest.7C79A5942F1374B2.quest_desc: [
		"El &aDeep Learner&r guarda hasta &b4 Data Models&r, llévalo en el inventario o en su ranura de accesorio"
		""
		"Mientras lo tengas encima, &acada mob que mates sube de nivel su modelo&r"
	]
	quest.7C79A5942F1374B2.quest_subtitle: "Donde aprendes"
	quest.7C79A5942F1374B2.title: "Deep Learner"
	quest.7CC7679F6A38599A.quest_desc: [
		"Algo de hierro vigila este mundo, y no cederá el paso a quien no demuestre su valía"
		""
		"Es el &6Iron Colossus&r, primer jefe de &bArmageddon&r y la prueba final de este capítulo"
		""
		"Consigue el &bIron Remote&r y derrótalo. Ve con tu equipo de cobre completo y comida de sobra"
		"{@pagebreak}"
		"Al vencerlo recibirás un logro de &bArmageddon&r y el mundo dará su primer gran paso: ya podrás &apicar hierro&r y fabricar su equipo"
		""
		"Es solo el primero de una larga lista de jefes. El siguiente te espera en &6La Expansión&r"
	]
	quest.7CC7679F6A38599A.quest_subtitle: "Primer jefe"
	quest.7CC7679F6A38599A.title: "El Coloso de Hierro"
	quest.7CCC46B8A196648C.quest_desc: ["La &binfused hellshelf&r es la versión infundida: sube el techo de eterna para llegar a nivel 60"]
	quest.7CCC46B8A196648C.title: "Hellshelf infundida"
	quest.7CCD5D6BA7F65180.quest_desc: [
		"El &bEnchanting Apparatus&r fabrica objetos mágicos. Rodéalo de &aArcane Pedestals&r (a menos de 3 bloques) con un objeto en cada uno, pon el objeto central sobre él y úsalo"
		""
		"Gasta &dSource&r de las jarras cercanas"
		""
		"&bConsejo&r: el &cMarket&r te puede ayudar a conseguir los saplings para la tableta que necesitas"
		""
		"&eEn este pack:&r aquí se fabrica el &dMending&r, ya que los aldeanos no lo venden"
		"{@pagebreak}"
		"{image:undercraft:textures/questpics/ars/apparatus_setup.png width:200 height:150 align:center click_action:none:}"
	]
	quest.7CCD5D6BA7F65180.quest_subtitle: "El altar de las creaciones"
	quest.7CCD5D6BA7F65180.title: "Enchanting Apparatus"
	quest.7CE07A508C5B8F49.quest_desc: ["Se obtienen con un catalizador polimórfico en agua. Después se refinan junto al goo para producir el combustible líquido con más energía por mb"]
	quest.7CE07A508C5B8F49.quest_subtitle: "Combustible de alta gama"
	quest.7CE07A508C5B8F49.title: "Fluidos refinados"
	quest.7CF3119749CB681E.quest_desc: [
		"La &aMechanical Pipe&r mueve &bagua, lava y cualquier fluido&r entre tanques y máquinas"
		""
		"&cSi no saca fluido de un tanque&r cambia el modo de esa conexión con el &aConfigurator&r, y &amejórala&r para mover más cubetas por segundo"
	]
	quest.7CF3119749CB681E.quest_subtitle: "Tuberías de fluidos"
	quest.7CF3119749CB681E.title: "Mechanical Pipe"
	quest.7D24B53FB5221245.quest_desc: ["La &bPinnacle spawner upgrade rune&r da el límite máximo de mejoras del spawner. Va ligada al nivel de mundo &6Pináculo&r"]
	quest.7D24B53FB5221245.quest_subtitle: "Mejora de Pináculo"
	quest.7D7933C2B7A2F5BD.quest_desc: [
		"Aquí llegarán ofertas de &amateriales de Mekanism&r"
		""
		"&7Todavía no está disponible&r"
	]
	quest.7D7933C2B7A2F5BD.quest_subtitle: "Próximamente"
	quest.7D7933C2B7A2F5BD.title: "Materiales: Mekanism"
	quest.7D8B44817DE37C5F.quest_desc: [
		"Las &dgemas&r de &bApotheosis&r se colocan en objetos con &aranuras&r (sockets) y les dan atributos extra, como más daño, más defensa o mejores herramientas"
		""
		"Cada gema tiene su tipo y su &arareza&r, y da distintos bonos según el objeto donde la pongas: un arma no recibe lo mismo que una armadura"
		""
		"Las encontrarás en el botín y explorando. Con la mesa de corte de gemas las mejoras"
	]
	quest.7D8B44817DE37C5F.quest_subtitle: "Poder en cada engaste"
	quest.7D8B44817DE37C5F.title: "Gemas"
	quest.7DAE36DC1C7092DC.quest_desc: [
		"Los &bArtifacts&r son objetos especiales que se llevan como accesorios (curios) y dan habilidades únicas: saltar más alto, caminar sobre el agua, resistir el fuego..."
		""
		"En este pack el mod &bReliquified Artifacts&r los une con &bRelics&r, así que ya no funcionan como en el mod original: ahora siguen el sistema de &dniveles&r de Relics. Un artefacto se &amejora con el uso&r y gana habilidades más potentes"
		""
		"Los encontrarás sobre todo explorando: cofres, estructuras y jefes. Pasa el cursor sobre uno y pulsa &2Shift&r para ver su tooltip con habilidades y nivel"
		""
		"&eConsejo:&r algunos objetos cambiaron por completo respecto al mod original, así que no des por hecho lo que ya conoces"
	]
	quest.7DAE36DC1C7092DC.quest_subtitle: "Equipo mágico con niveles"
	quest.7DAE36DC1C7092DC.title: "Artifacts y Relics"
	quest.7DC89009E7A14A81.quest_desc: [
		"La &bLinking Tool&r enlaza cajones a un controlador, uno por uno o por zonas. La &bConfiguration Tool&r cambia ajustes, como bloquear el objeto de un cajón para que siga asignado aunque quede vacío"
		""
		"Cambia de modo con &2Shift + clic derecho&r en el aire"
	]
	quest.7DC89009E7A14A81.quest_subtitle: "Configurar y enlazar"
	quest.7DC89009E7A14A81.title: "Herramientas"
	quest.7DC8AD7F43B73486.quest_desc: [
		"Todo lo que necesite una &cseñal de redstone&r debe tener el &aRedstone Link&r o una palanca, puedes cambiar los &aRedstone Links&r para que reciban señal, se debe ver la antena, como se ve en la imagen"
		""
		"{image:undercraft:textures/questpics/grinding_utils/mob_farm_setup_step_6.png width:120 height:120 align:center click_action:none:}"
		"{@pagebreak}"
		"Esta es la vista aérea de la granja, con &binterruptores&r para &aactivar o desactivar la granja con luz&r, y también para &aencender o apagar&r los ventiladores y el Mob Masher"
		""
		"{image:undercraft:textures/questpics/grinding_utils/mob_farm_setup_step_7.png width:175 height:200 align:center}"
	]
	quest.7DC8AD7F43B73486.quest_subtitle: "Todo con su Redstone Link"
	quest.7DC8AD7F43B73486.title: "Señales de redstone"
	quest.7DE7B1A3C8F15891.quest_desc: ["Con la &bEclipsegate Wand&r haces clic derecho sobre un bloque y los que lo rodean desaparecen un momento, para que puedas atravesar. Luego vuelven"]
	quest.7DE7B1A3C8F15891.quest_subtitle: "Un paso a través de la pared"
	quest.7DE7B1A3C8F15891.title: "Varita Eclipsegate"
	quest.7E0E418E9FB8DB82.quest_desc: ["La &bdivine pearl&r es el foco de la escuela &asagrada&r"]
	quest.7E0E418E9FB8DB82.quest_subtitle: "Foco sagrado"
	quest.7E0E418E9FB8DB82.title: "Perla divina"
	quest.7E25EA83584FE0FD.quest_desc: [
		"El &aPrimogel&r transforma los bloques que toca, &bpon lana verde pegada al goo activo&r y con el tiempo se convertirá en un &abloque de slime&r"
		""
		"&cRecuerda que el goo puede desactivarse&r después de cada transformación, así que vuelve a alimentarlo"
	]
	quest.7E25EA83584FE0FD.quest_subtitle: "Gracias al goo"
	quest.7E25EA83584FE0FD.title: "Slime fácil"
	quest.7E2BACA3DAE94989.quest_desc: [
		"Paga &6300 monedas&r y recibe una &bestrella del Nether&r sin tener que enfrentarte al &cWither&r"
		""
		"Se puede comprar de nuevo &7cada hora&r"
	]
	quest.7E2BACA3DAE94989.quest_subtitle: "Sin pelear"
	quest.7E2BACA3DAE94989.title: "Estrella del Wither"
	quest.7E2F156D19D762FB.quest_desc: [
		"La &aPurification Chamber&r usa &boxígeno&r para convertir un mineral en &btres clumps&r"
		""
		"El camino completo es: &7Purification Chamber&r, &7Crusher&r, &7Enrichment Chamber&r y por último el horno, así &acada mineral te da tres lingotes&r"
		""
		"&6Alimenta el oxígeno desde el Electrolytic Separator&r con un tubo de gases"
	]
	quest.7E2F156D19D762FB.quest_subtitle: "Triplica tus minerales"
	quest.7E2F156D19D762FB.title: "Purification Chamber"
	quest.7E6670587C1A9090.quest_desc: [
		"Con el oro mejorado llega el &eescudo de oro&r de &aShield Expansion&r, &ala mejora directa del escudo de hierro&r"
		""
		"&bAguanta más golpes&r que el de hierro, ideal para los jefes que vienen, revisa su receta con &bR&r"
	]
	quest.7E6670587C1A9090.quest_subtitle: "El escudo sube de nivel"
	quest.7E9801F183DF9B6C.quest_desc: [
		"Las &aarmas ligeras&r siguen siendo &brápidas y de una mano&r, ahora con &bdiamante&r"
		""
		"&aMucho más daño y durabilidad que las anteriores&r, y como siempre puedes llevar una en cada mano"
		""
		"&6Se consiguen con la plantilla de mejora de diamante&r, igual que el resto del equipo"
	]
	quest.7E9801F183DF9B6C.quest_subtitle: "Filo de diamante"
	quest.7E9801F183DF9B6C.title: "Armas ligeras de diamante"
	quest.7E9FA2D45F5332C5.quest_desc: [
		"Necesita una &bTabula Animata&r, un &bdiamante&r y un &bbloque de oro&r"
		""
		"La capacidad sube a &61.024&r"
	]
	quest.7E9FA2D45F5332C5.quest_subtitle: "Gema 3 de 5"
	quest.7ED32EADB50EA4BB.quest_desc: ["El &bartificer cane&r es un bastón de apoyo. Pulsa &2R&r sobre él para ver su receta y su hechizo"]
	quest.7ED32EADB50EA4BB.quest_subtitle: "Cuando se agota el maná"
	quest.7ED32EADB50EA4BB.title: "Bastón del artífice"
	quest.7EE0B9517A06FF41.quest_desc: [
		"Las mejoras le dan al &aMob Masher&r el efecto de un &dencantamiento&r: &7Sharpness&r, &7Looting&r, &7Fire Aspect&r, &7Smite&r y &7Bane of Arthropods&r"
		""
		"La de &6Beheading&r hace que &blos mobs suelten su cabeza&r"
	]
	quest.7EE0B9517A06FF41.quest_subtitle: "Encantamientos para la sierra"
	quest.7EE0B9517A06FF41.title: "Mejoras del Mob Masher"
	quest.7EE0BB1A531E3AA4.quest_desc: [
		"La &6Mechanical Press&r &baplasta lo que tenga debajo&r, sobre un &bdepot&r o una cinta, así un lingote de hierro se vuelve una &7lámina de hierro&r"
		"{@pagebreak}"
		"{image:undercraft:textures/questpics/fase_1/mechanical_press.png width:60 height:120 align:center click_action:none:}"
	]
	quest.7EE0BB1A531E3AA4.quest_subtitle: "Aplasta con ritmo"
	quest.7EE0BB1A531E3AA4.title: "Prensa mecánica"
	quest.7F327A43D165AC36.quest_desc: [
		"El &bPocket Generator&r, de &bJust Dire Things&r, quema combustible y carga con &cRF&r los objetos que lleves encima, sin colocar nada"
		""
		"Acepta carbón, y cuanto mejor es el combustible, más energía rinde. Es la forma más cómoda de cargar el equipo que funciona con &cRF&r"
	]
